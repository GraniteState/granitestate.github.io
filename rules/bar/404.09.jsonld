  "broader": "https://granitestate.github.io/rules/bar/404",
  "definition": "Violation Points for a Shop and/or Licensee",
  "effectiveDate": "2018-09-13",
  "historyNote": "#6577, eff 9-13-97 (formerly Bar 504.02); ss by #7323, eff 7-26-00; ss by #9221, INTERIM, eff 7-30-08; ss by #9345, eff 12-10-08; ss by #10808, eff 4-2-15; ss by #11055, eff 3-18-16; ss by #12619, eff 9-13-18",
