  "prefLabel": "Par 303.04 Granting of Medical Parole",
  "priorExpiration": "2016-09-06",
  "recordType": "rule-section",
  "ruleText": "Par 303.04 Granting of Medical Parole. Medical parole shall be granted if a majority of the hearing panel determines that the inmate will not be a danger to the public, and that there is a reasonable probability that the inmate will not violate the law while on medical parole and will conduct himself or herself as a good citizen.\n\nSource. #9255, eff 9-6-08, EXPIRED: 9-6-16\n\nNew. #12158, eff 4-7-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/par100-500.html"
}
