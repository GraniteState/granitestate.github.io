  "definition": "Record of Appeal Hearing",
  "effectiveDate": "2012-10-03",
  "historyNote": "#5590, eff 2-25-93; ss by #6258, eff 5-30-96; ss by #8058, eff 5-30-04; ss by #10198-A, eff 10-3-12",
  "inScheme": "https://granitestate.github.io/rules/scheme",
