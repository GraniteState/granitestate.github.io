  "definition": "Site Management Area Plan",
  "effectiveDate": "2024-08-22",
  "historyNote": "#5702, eff 9-17-93; ss by #6316, eff 8-13-96; ss by #8131, eff 8-13-04; ss by #10333, eff 5-10-13; ss by #14064, eff 8-22-24",
