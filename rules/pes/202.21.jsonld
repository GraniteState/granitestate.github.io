  "definition": "Continuance",
  "effectiveDate": "2012-10-03",
  "historyNote": "#6258, eff 5-30-96; ss by #8058, eff 5-30-04; ss by #10198-A, eff 10-3-12",
  "inScheme": "https://granitestate.github.io/rules/scheme",
