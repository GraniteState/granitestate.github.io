  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/pes100.html",
  "prefLabel": "Pes 101.22 Pesticide dealer",
  "recordType": "rule-section",
  "ruleText": "Pes 101.22 \"Pesticide dealer\" means any person representing himself or a single firm, corporation, dealership or other entity, who is engaged in the business of distributing, selling, offering for sale or holding for sale, in New Hampshire, any pesticide which has been designated by the New Hampshire pesticide control board to be \"prohibited-limited use\" or \"restricted.\"\n\nSource. #4812, eff 5-3-90; ss and moved by #6239, eff 5-2-96 (from Pes 101.19)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/pes100.html"
