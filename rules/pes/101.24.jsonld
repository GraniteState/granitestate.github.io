  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/pes100.html",
  "prefLabel": "Pes 101.24 Products/completed operations coverage",
  "recordType": "rule-section",
  "ruleText": "Pes 101.24 \"Products/completed operations coverage\" means that the insurance coverage required under Pes 301.03 includes liability coverage for injury and damage:\n\n(a) Arising out of the use of products by the insured, and\n\n(b) Arising out of operations but when the bodily injury or property damage occurs after such operations have been completed or abandoned and occurs away from premises owned by or rented to the named insured.\n\nSource. #4309, eff 9-1-87; ss by #4867, eff 7-19-90; ss and moved by #6239, eff 5-2-96 (from Pes 101.21)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/pes100.html"
}
