  "historyNote": "#8896, eff 6-7-07; ss by #10902, eff 7-29-15; ss by #14478, eff 3-13-26, EXPIRES: 3-13-36 (formerly Occ 405.02)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
