  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/dec100-200.html",
  "prefLabel": "Dec 102.13 Petition",
  "priorExpiration": "2001-03-17",
  "recordType": "rule-section",
  "ruleText": "Dec 102.13 \"Petition\" means any written request filed with the committee for the purpose of seeking the approval, determination, consent, certification or authorization of the committee in connection with any matter or adjudicative proceeding and non-adjudicative processes pending before the committee.\n\nSource. #4235, eff 2-20-87, EXPIRED: 2-20-93\n\nNew. #5700, INTERIM, eff 9-17-93, EXPIRED: 1-15-94\n\nNew. #5824, eff 8-30-94, EXPIRED: 8-30-00\n\nNew. #7366, INTERIM, eff 9-18-00, EXPIRED: 3-17-01\n\nNew. #9143, eff 4-25-08",
