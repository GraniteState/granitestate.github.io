  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w500.html",
  "prefLabel": "He-W 537.05 Covered Services",
  "recordType": "rule-section",
  "ruleText": "He-W 537.05 Covered Services.\n\n(a) Covered services for FQHCs and independent RHCs shall include the following outpatient services:\n\n(1) The services of a physician, when the physician has an agreement to be paid by the clinic for such services;\n\n(2) The services of a nurse practitioner, or physician assistant, provided within the scope of his/her training or certification;\n\n(3) The services and supplies that are furnished as incidental to the professional services of a physician, nurse practitioner, or physician assistant;\n\n(4) Laboratory services essential to the immediate diagnosis and treatment of the patient; and\n\n(5) Other ambulatory services provided within the scope of the FQHC or RHC practice.\n\n(b) Covered services for hospital-based RHCs shall include the following outpatient services:\n\n(1) The services of a physician, when the physician has an agreement to be paid by the clinic for such services;\n\n(2) The services of a nurse practitioner, or physician assistant, provided within the scope of his/her training or certification; and\n\n(3) The services and supplies that are furnished as incidental to the professional services of a physician, nurse practitioner, or physician assistant.\n\nSource. (See Revision Note at chapter heading He-W 500); ss by #4884, eff 8-1-90, EXPIRED: 8-1-96\n\nNew. #6725, eff 4-1-98, EXPIRED: 4-1-06",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w500.html"
}
