  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w500.html",
  "prefLabel": "He-W 538.05 Non-Covered Services",
  "priorExpiration": "2018-06-25",
  "recordType": "rule-section",
  "ruleText": "He-W 538.05 Non-Covered Services. Non-covered services shall be those services which a NHCM is not legally recognized to perform, pursuant to RSA 326-D:1, V, including:\n\n(a) Operative obstetrics;\n\n(b) Cesarean sections;\n\n(c) General and conductive anesthesia;\n\n(d) Contraction stress tests;\n\n(e) Treatment to enhance fertility or procreation;\n\n(f) Any artificial, forcible, or mechanical means to assist the delivery; and\n\n(g) Induced abortions.\n\nSource. #7657, eff 3-5-02, EXPIRED: 3-5-10\n\nNew. #9737, eff 6-25-10, EXPIRED: 6-25-18\n\nNew. #12783, eff 5-21-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w500.html"
}
