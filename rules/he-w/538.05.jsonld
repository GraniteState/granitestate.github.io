  "definition": "Non-Covered Services",
  "effectiveDate": "2019-05-21",
  "historyNote": "#7657, eff 3-5-02, EXPIRED: 3-5-10 New. #9737, eff 6-25-10, EXPIRED: 6-25-18 New. #12783, eff 5-21-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
