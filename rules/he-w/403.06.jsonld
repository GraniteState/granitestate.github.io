  "definition": "Recovery of Payments Resulting from an Adjusted Federal Tax Return",
  "effectiveDate": "2025-06-24",
  "expirationDate": "2035-06-24",
  "historyNote": "#8685, eff 7-21-06; renumbered by #9206 (formerly He-W 403.07); ss by #10467, eff 11-26-13; ss by #10760, eff 1-19-15; ss by #14275, eff 6-24-25, EXPIRES: 6-24-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
