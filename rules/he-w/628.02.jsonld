  "broader": "https://granitestate.github.io/rules/he-w/628",
  "definition": "Deprivation Due to Incapacity",
  "effectiveDate": "2019-01-26",
  "historyNote": "(See Revision Note #1 at Chapter Heading He-W 600) #5171, eff 6-26-91; EXPIRED 6-26-97 New. #7084, eff 8-26-99; ss by #8970, eff 8-25-07; ss by #10318, eff 4-25-13; ss by #12718, eff 1-26-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
