  "effectiveDate": "2024-01-06",
  "historyNote": "#9726-A, eff 7-1-10, EXPIRED: 7-1-18 New. (See Revision Note at part heading for He-W 544) #13847, eff 1-6-24 (formerly He-W 544.15)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
