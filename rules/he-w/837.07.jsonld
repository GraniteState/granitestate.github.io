  "definition": "Beneficiaries with Disabilities: Reasonable Modification",
  "effectiveDate": "2019-06-05",
  "historyNote": "#12733, INTERIM, eff 2-23-19, EXPIRES: 8-22-19; ss by #12796, eff 6-5-19 (formerly He-W 837.08)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "He-W 837.07",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w800.html",
  "prefLabel": "He-W 837.07 Beneficiaries with Disabilities: Reasonable Modification",
  "priorExpiration": "2019-08-22",
  "recordType": "rule-section",
  "ruleText": "He-W 837.07 Beneficiaries with Disabilities: Reasonable Modification.\n\n(a) A beneficiary with a disability shall be entitled to reasonable modifications related to meeting the community engagement requirement.\n\n(b) Reasonable modifications shall include:\n\n(1) Modification in the number of community engagement hours required where the beneficiary is unable to participate in the required number of hours; or\n\n(2) Assistance with understanding granite advantage to include, but not be limited to, departmental notices, eligibility requirements, exemption requirements, how to apply for an exemption, program benefits, how to establish eligibility, and how to meet and report community engagement activities to maintain eligibility.\n\nSource. #12733, INTERIM, eff 2-23-19, EXPIRES: 8-22-19; ss by #12796, eff 6-5-19 (formerly He-W 837.08)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w800.html"
