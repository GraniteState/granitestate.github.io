  "broader": "https://granitestate.github.io/rules/he-w/572",
  "definition": "Payment for Services",
  "effectiveDate": "2024-06-25",
  "historyNote": "#10294, eff 12-1-13 (from He-W 572.09); ss by #13840, INTERIM, eff 12-29-23; ss by #14007, eff 6-25-24",
