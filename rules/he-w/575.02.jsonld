  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w500.html",
  "prefLabel": "He-W 575.02 Recipient Eligibility",
  "recordType": "rule-section",
  "ruleText": "He-W 575.02 Recipient Eligibility. A recipient shall be eligible to receive AAC aids as prescribed by a physician when:\n\n(a) The recipient has a significant, expressive communication or language comprehension impairment such as apraxia of speech, dysarthria, and cognitive communication disabilities, and the impairment or disability either temporarily or permanently causes communication limitations that preclude or interfere with the recipient's meaningful participation in current and projected daily activities; and\n\n(b) The prescribed AAC aid is coverable in accordance with this rule.\n\nSource. #10636, eff 7-12-14",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w500.html"
}
