  "historyNote": "#7470, eff 4-1-01; amd by #7918, eff 8-1-03; ss by #9433, eff 4-1-09; ss by #9775, eff 9-1-10; ss by #12676, eff 11-20-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
