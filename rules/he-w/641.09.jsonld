  "definition": "Breast and Cervical Cancer Program",
  "effectiveDate": "2009-09-01",
  "historyNote": "#7459, EMERGENCY, eff 3-13-01 EXPIRED: 9-9-01; ss by #7546, eff 9-1-01; ss by #9532, eff 9-1-09",
  "inScheme": "https://granitestate.github.io/rules/scheme",
