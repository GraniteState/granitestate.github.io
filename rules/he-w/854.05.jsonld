  "definition": "Educational Income",
  "effectiveDate": "2023-08-08",
  "historyNote": "#13715, eff 8-8-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "He-W 854.05",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w800.html",
  "prefLabel": "He-W 854.05 Educational Income",
  "recordType": "rule-section",
  "ruleText": "He-W 854.05 Educational Income.\n\n(a) Income from scholarships and grants that are not otherwise excluded by federal law or regulation shall be:\n\n(1) Counted only to the extent that the income exceeds actual verified educational expenses during the period it is intended to cover; and\n\n(2) Divided by the number of months it is intended to cover to calculate a monthly amount.\n\n(b) Income from student loans, regardless of the source or the purpose to which it is used, shall not be counted when determining eligibility.\n\nSource. #13715, eff 8-8-23",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/he-w800.html"
}
