  "definition": "Permit Termination",
  "effectiveDate": "2024-11-23",
  "expirationDate": "2034-11-23",
  "historyNote": "#14124, eff 11-23-24, EXPIRES: 11-23-34 (see Revision Note #2 at chapter heading for Env-Sw 300)",
