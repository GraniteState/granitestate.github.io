  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-sw2100.html",
  "prefLabel": "Env-Sw 2102.16 Major project",
  "recordType": "rule-section",
  "ruleText": "Env-Sw 2102.16 “Major project” means any activity at an asbestos disposal site that involves the excavation, removal, exposure, or other disturbance of more than 160 square feet, which is approximately 15 square meters, or 35 cubic feet, which is approximately one cubic meter, of asbestos or any material mixed with or containing asbestos, where the total disturbance involved in a project is measured cumulatively.\n\nSource. #12605, eff 9-1-18 (formerly Env-Sw 2102.08)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-sw2100.html"
}
