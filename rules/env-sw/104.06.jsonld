  "definition": "Permittee",
  "effectiveDate": "2024-10-23",
  "historyNote": "(See Revision Note #1 at chapter heading for Env-Sw 100) #8460-B, eff 10-28-05; ss by #14103, effective 10-23-24 (see Revision Note #2 at chapter heading for Env-Sw 100)",
