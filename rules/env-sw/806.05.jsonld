  "broader": "https://granitestate.github.io/rules/env-sw/806",
  "definition": "Leachate Management Requirements",
  "effectiveDate": "2024-12-21",
  "historyNote": "#5172, eff 7-1-91; ss by #6535, INTERIM, eff 7-1-97, EXPIRES: 10-29-97; ss by #6619-B, eff 10-29-97; (See Revision Note at chapter heading for Env-Sw 800); ss by #8459, eff 10-28-05 (formerly Env-Wm 2506.05); amd by #9695, eff 4-22-10; ss by #10597, eff 7-1-14; ss by #14156, eff 12-21-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
