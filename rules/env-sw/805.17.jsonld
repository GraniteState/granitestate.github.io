  "definition": "Vertical Expansion of Landfills",
  "effectiveDate": "2024-12-21",
  "historyNote": "#10597, eff 7-1-14; ss by #14156, eff 12-21-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
