  "broader": "https://granitestate.github.io/rules/env-sw/607",
  "definition": "Small Food Waste Composting Facilities",
  "effectiveDate": "2022-04-01",
  "historyNote": "#5172, eff 7-1-91; amd by #5295, eff 12-24-91; ss by #6535, INTERIM, eff 7-1-97, EXPIRES: 10-29-97; ss by #6619-B, eff 10-29-97; (See Revision Note at chapter heading for Env-Sw 600); ss by #8459, eff 10-28-05 (formerly Env-Wm 2307.02); ss by #10596, eff 7-1-14; ss by #13358, eff 4-1-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
