  "prefLabel": "Liq 901.01 Purpose",
  "priorExpiration": "2004-11-28",
  "recordType": "rule-section",
  "ruleText": "Liq 901.01 Purpose. The purpose of this chapter is to set forth the processes by which the commission may authorize licensees to make purchases from the commission on credit, including the terms and conditions that apply to such purchases, and to establish discounts for liquor and wine purchases made by on and off-premises licensees.\n\nSource. #4720, eff 1-1-90; ss by #5043, eff 1-11-91; ss by #6391, eff 11-28-96, EXPIRED: 11-28-04\n\nNew. #13225, eff 6-30-21",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/liq100-1100.html"
}
