  "definition": "Duties of Insurers with Respect to Direct Response Solicitations",
  "effectiveDate": "2017-10-21",
  "historyNote": "#7537, eff 8-1-01; ss by #9571, eff 10-21-09; ss by #12375, eff 10-21-17",
