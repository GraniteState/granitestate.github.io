  "broader": "https://granitestate.github.io/rules/ins/4103",
  "definition": "Underwriting and Issue Requirements",
  "effectiveDate": "2019-06-10",
  "historyNote": "#9690, eff 4-9-10; ss by #9938, eff 6-10-11; ss by #10212, eff 11-1-12; ss by #12799, eff 6-10-19",
