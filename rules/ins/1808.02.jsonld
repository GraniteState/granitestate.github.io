  "definition": "Resident Contract Standards",
  "effectiveDate": "2026-06-27",
  "expirationDate": "2036-06-27",
  "historyNote": "#7014, eff 7-1-99; EXPIRED: 7-1-07 New. #8991, eff 10-1-07; ss by #10944, eff 10-8-15; ss by #14640, eff 6-27-26, EXPIRES: 6-27-36",
