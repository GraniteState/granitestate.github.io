  "definition": "Standards for Waiting Times for Appointments and Access to After-Hours Care",
  "effectiveDate": "2018-08-01",
  "historyNote": "#9722, eff 8-1-10 (from Ins 2701.07); ss by #12565, eff 8-1-18 (formerly Ins 2701.07)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
