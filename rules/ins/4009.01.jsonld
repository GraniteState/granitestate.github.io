  "broader": "https://granitestate.github.io/rules/ins/4009",
  "definition": "Member Eligibility Data Tables",
  "effectiveDate": "2026-04-22",
  "expirationDate": "2036-04-22",
  "historyNote": "#10877, eff 7-10-15; ss by #13136, eff 11-24-20; ss by #14560, eff 4-22-26, EXPIRES: 4-22-36 (formerly Ins 4010.01)",
