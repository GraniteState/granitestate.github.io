  "broader": "https://granitestate.github.io/rules/ins/3601",
  "definition": "Appealing an Insurer’s Determination That the Benefit Trigger Is Not Met",
  "effectiveDate": "2022-06-22",
  "historyNote": "#8036, eff 5-1-04; ss by #10154, eff 6-25-12 (from Ins 3601.27); ss by #13400, eff 6-22-22",
