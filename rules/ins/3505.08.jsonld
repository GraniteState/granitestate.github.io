  "broader": "https://granitestate.github.io/rules/ins/3505",
  "definition": "Exemption from Unitary Reserves for Certain Juvenile Policies",
  "effectiveDate": "2017-07-25",
  "historyNote": "#7419, eff 7-1-01; ss by #9516, eff 7-25-09; ss by #12219, eff 7-25-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
