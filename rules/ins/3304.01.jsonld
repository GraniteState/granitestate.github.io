  "definition": "Ratemaking Use",
  "effectiveDate": "2018-08-03",
  "historyNote": "#7658, eff 9-1-02; ss by #8052, eff 7-1-04; ss by #9634, eff 7-1-10; ss by #12599, eff 8-3-18",
