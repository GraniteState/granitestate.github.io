  "broader": "https://granitestate.github.io/rules/ins/8001",
  "definition": "Minimum Standards for Benefits for All Policies and Certificates",
  "effectiveDate": "2022-11-30",
  "historyNote": "#13499, eff 11-30-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
