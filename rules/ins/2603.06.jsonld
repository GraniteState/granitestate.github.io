  "broader": "https://granitestate.github.io/rules/ins/2603",
  "definition": "Advertisements of Benefits, Losses Covered or Premiums Payable",
  "effectiveDate": "2016-12-05",
  "historyNote": "#9398, eff 3-1-09; ss by #11173, eff 12-5-16",
