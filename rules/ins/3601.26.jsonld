  "definition": "Right to Reduce Coverage and Lower Premiums",
  "effectiveDate": "2022-06-22",
  "historyNote": "#8036, eff 5-1-04; ss by #10154, eff 6-25-12; ss by #13400, eff 6-22-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
