  "definition": "Computation of Cash Values for Variable Annuities",
  "effectiveDate": "2017-03-18",
  "historyNote": "#8726, eff 9-18-06, EXPIRED: 9-18-14 New. #12126, eff 3-18-17 (from Ins 401.10)",
