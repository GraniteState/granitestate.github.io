  "definition": "Exceptions",
  "effectiveDate": "2018-08-01",
  "historyNote": "#7701, eff 8-1-02; ss by #9399, eff 3-1-09 ss by #9722, eff 8-1-10 (from Ins 2701.06); ss by #12565, eff 8-1-18",
