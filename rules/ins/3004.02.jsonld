  "definition": "Exceptions to Notice and Opt Out Requirements for Disclosure of Nonpublic Personal Financial Information for Processing and Servicing Transactions",
  "effectiveDate": "2019-05-06",
  "historyNote": "#7500, eff 7-1-01, EXPIRED: 701-09 New. #9922, eff 5-6-11; ss by #12749, eff 5-6-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
