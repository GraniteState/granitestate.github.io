  "definition": "Required Disclosure Provisions",
  "effectiveDate": "2022-11-30",
  "historyNote": "#13499, eff 11-30-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Ins 8001.07",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins8000.html",
  "prefLabel": "Ins 8001.07 Required Disclosure Provisions",
  "recordType": "rule-section",
  "ruleText": "Ins 8001.07 Required Disclosure Provisions. The following disclosures shall be conspicuously placed on the front page of the policy and certificate:\n\n(a) A statement of whether the policy is conditionally renewable, guaranteed renewable, or non-cancellable;\n\n(b) For policies or certificates that do not provide medical leave benefits, a statement in bold indicating the limitation;\n\n(c) A statement as to any benefit limits or reductions due to attainment of certain ages; and\n\n(d) “An employer’s granting of leave under the Family and Medical Leave Act or other types of allowable leave does not guarantee benefits under this [policy/certificate]. Granting of benefits for qualifying leave under this [policy/certificate] does not guarantee any right to continued employment or job protection.”\n\nSource. #13499, eff 11-30-22",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins8000.html"
}
