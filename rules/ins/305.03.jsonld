  "definition": "Exemptions",
  "effectiveDate": "2024-02-16",
  "historyNote": "#9374, eff 1-30-09; ss by #10654, eff 1-1-15; ss by #13873, eff 2-16-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
