  "broader": "https://granitestate.github.io/rules/ins/3003",
  "definition": "Limits on Sharing Account Number Information for Marketing Purposes",
  "effectiveDate": "2019-05-06",
  "historyNote": "#7500, eff 7-1-01, EXPIRED: 7-1-09 New. #9922, eff 5-6-11; ss by #12749, eff 5-6-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
