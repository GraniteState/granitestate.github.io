  "broader": "https://granitestate.github.io/rules/ins/1905",
  "definition": "Loss Ratio Standards and Refund or Credit of Premium",
  "effectiveDate": "2017-10-13",
  "historyNote": "#5390, eff 7-1-92; ss by #5656, eff 7-1-93; ss by #7017, INTERIM, eff 7-1-99, EXPIRED: 10-29-99 New. #7174, eff 12-22-99; ss by #8051, eff 3-1-04; ss by #8363, eff 9-8-05; ss by #9559, eff 10-13-09 (from Ins 1905.13); amd by #10559, eff 4-1-14; ss by #12370, eff 10-13-17 (from Ins 1905.15)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
