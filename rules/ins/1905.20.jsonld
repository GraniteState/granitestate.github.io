  "broader": "https://granitestate.github.io/rules/ins/1905",
  "definition": "Requirements for Application Forms and Replacement Coverage",
  "effectiveDate": "2017-10-13",
  "historyNote": "#5390, eff 7-1-92; ss by #5656, eff 7-1-93; ss by #7017, INTERIM, eff 7-1-99, EXPIRED: 10-29-99 New. #7174, eff 12-22-99; ss by #8051, eff 3-1-04; ss by #8363, eff 9-8-05; ss by #9559, eff 10-13-09 (from Ins 1905.17); ss by #12370, eff 10-13-17 (from Ins 1905.19)",
