  "definition": "Disparaging Comparisons and Statements",
  "effectiveDate": "2016-12-05",
  "historyNote": "#9333, eff 12-5-08; ss by #11173, eff 12-5-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
