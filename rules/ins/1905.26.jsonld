  "broader": "https://granitestate.github.io/rules/ins/1905",
  "definition": "Prohibition Against Use of Genetic Information and Requests for Genetic Testing",
  "effectiveDate": "2017-10-13",
  "historyNote": "#9559, eff 10-13-09 ss by #12370, eff 10-13-17 (from Ins 1905.25)",
