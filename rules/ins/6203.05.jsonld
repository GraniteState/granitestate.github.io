  "broader": "https://granitestate.github.io/rules/ins/6203",
  "definition": "Required Disclosure Provisions",
  "effectiveDate": "2020-11-24",
  "historyNote": "(See Revision Note #3 at chapter heading for Ins 6200) #12855, eff 8-26-19; ss by #13137, eff 11-24-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Ins 6203.05",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins6200.html",
  "prefLabel": "Ins 6203.05 Required Disclosure Provisions",
  "recordType": "rule-section",
  "ruleText": "Ins 6203.05 Required Disclosure Provisions.\n\n(a) All accident-only policies and certificates shall contain a prominent statement on the cover page of the policy or certificate, in either contrasting color or in boldface type at least equal to the size of type used for headings or captions of sections in the policy or certificate, as follows:\n\n“Notice to Buyer: This is an accident-only [policy] [certificate] and it does not pay benefits for loss from sickness. Review your [policy] [certificate] carefully”.\n\n(b) Accident-only policies and certificates that provide coverage for hospital or medical care shall contain the following statement on the cover page, in addition to the Notice to Buyer in (a) above:\n\n“This [policy] [certificate] provides limited benefits. Benefits provided are not intended to cover all medical expenses”.\n\nSource. (See Revision Note #3 at chapter heading for Ins 6200) #12855, eff 8-26-19; ss by #13137, eff 11-24-20",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins6200.html"
