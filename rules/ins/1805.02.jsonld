  "definition": "Days-Cash-On-Hand Calculation",
  "effectiveDate": "2026-06-27",
  "expirationDate": "2036-06-27",
  "historyNote": "#10944, eff 10-8-15; ss by #14640, eff 6-27-26, EXPIRES: 6-27-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
