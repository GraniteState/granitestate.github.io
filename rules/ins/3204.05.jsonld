  "definition": "Discrimination Against Nonaffiliated Companies or Agents Prohibited",
  "effectiveDate": "1999-07-24",
  "historyNote": "#7064, eff 7-24-99",
  "inScheme": "https://granitestate.github.io/rules/scheme",
