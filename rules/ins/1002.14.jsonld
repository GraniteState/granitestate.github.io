  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins1000.html",
  "prefLabel": "Ins 1002.14 Estimates",
  "priorExpiration": "2015-07-01",
  "recordType": "rule-section",
  "ruleText": "Ins 1002.14 Estimates. The insured or claimant shall only be responsible for the cost of one damage estimate for motor vehicle property damage liability and collision and comprehensive claims. The insurer shall be responsible for any charge incurred by the insured or claimant for any subsequent damage estimates required by the insurer.\n\nSource. #8900, eff 7-1-07, EXPIRED: 7-1-15\n\nNew. #10962, eff 10-26-15",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins1000.html"
