  "definition": "Insurers Use of Unlicensed Adjusters Prohibited",
  "effectiveDate": "2015-10-26",
  "historyNote": "#8900, eff 7-1-07, EXPIRED: 7-1-15 New. #10962, eff 10-26-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
