  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins1000.html",
  "prefLabel": "Ins 1002.10 Insurers Use of Unlicensed Adjusters Prohibited",
  "priorExpiration": "2015-07-01",
  "recordType": "rule-section",
  "ruleText": "Ins 1002.10 Insurers Use of Unlicensed Adjusters Prohibited. No insurer shall employ or otherwise utilize the services of an adjuster unless that adjuster has complied with all the appropriate licensing provisions of RSA 402-B or has been granted a temporary license pursuant to RSA 402-B:11, however, any claim adjusted to the satisfaction of an insurer and the insured or claimant by an unlicensed adjuster shall bind the insurer.\n\nSource. #8900, eff 7-1-07, EXPIRED: 7-1-15\n\nNew. #10962, eff 10-26-15",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ins1000.html"
}
