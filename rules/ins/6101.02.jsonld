  "broader": "https://granitestate.github.io/rules/ins/6101",
  "definition": "Effective Date of Discontinuance for Nonpayment of Premium",
  "effectiveDate": "2018-01-31",
  "historyNote": "(See Revision Note #1 at chapter heading for Ins 6100) #12471, eff 1-31-18",
