  "definition": "Determining Amount of Motor Vehicle Total Loss Claims",
  "effectiveDate": "2021-04-26",
  "historyNote": "#8900, eff 7-1-07, EXPIRED: 7-1-15 New. #10962, eff 10-26-15; ss by #13173, eff 4-26-21",
