  "broader": "https://granitestate.github.io/rules/ins/3601",
  "definition": "Required Disclosure of Rating Practices to Consumers",
  "effectiveDate": "2022-06-22",
  "historyNote": "#8036, eff 5-1-04; ss by #10154, eff 6-25-12; amd by #10782, eff 2-13-152; ss by #13400, eff 6-22-22",
