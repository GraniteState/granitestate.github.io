  "broader": "https://granitestate.github.io/rules/ins/3204",
  "definition": "Separation from Deposit and Loan Activities",
  "effectiveDate": "1999-07-24",
  "historyNote": "#7064, eff 7-24-99",
  "inScheme": "https://granitestate.github.io/rules/scheme",
