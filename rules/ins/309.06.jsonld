  "definition": "Standards for Basic Illustrations",
  "effectiveDate": "2017-03-09",
  "historyNote": "#7195, eff 4-1-00, EXPIRED: 4-1-08 New. #9401, eff 3-9-09; ss by #12097, eff 3-9-17",
