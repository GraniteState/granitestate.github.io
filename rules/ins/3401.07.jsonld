  "definition": "Marketing Health Benefit Plans",
  "effectiveDate": "2009-10-19",
  "historyNote": "#7434, INTERIM, eff 2-1-01, EXPIRED: 7-31-01 New. #7583, eff 11-1-01; ss by #9564, eff 10-19-09",
  "inScheme": "https://granitestate.github.io/rules/scheme",
