  "definition": "Certification by Actuary: Polices Issued or Renewed Between January 1, 2017 and January 1, 2021",
  "effectiveDate": "2020-08-28",
  "historyNote": "#9244, eff 9-2-08; ss by #11149, eff 9-2-16; ss by #13095, eff 8-28-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
