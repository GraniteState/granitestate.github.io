  "definition": "Reinsurance Contract",
  "effectiveDate": "2021-11-24",
  "historyNote": "#10449, eff 11-1-13 (from Ins 601.12); ss by #13296, eff 11-24-21 (formerly Ins 601.12)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
