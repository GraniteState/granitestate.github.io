  "broader": "https://granitestate.github.io/rules/ins/4101",
  "definition": "Rate Filing Submission Requirements",
  "effectiveDate": "2019-06-10",
  "historyNote": "#9938, eff 6-10-11 (from Ins 4101.05); ss by #10212, eff 11-1-12; ss by #12799, eff 6-10-19",
