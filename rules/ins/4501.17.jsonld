  "broader": "https://granitestate.github.io/rules/ins/4501",
  "definition": "Exemptions and Effective Dates",
  "effectiveDate": "2016-12-31",
  "historyNote": "#9246, eff 1-1-09; ss by #11171, eff 12-31-16 (from Ins 4501.16)",
