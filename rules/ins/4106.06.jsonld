  "broader": "https://granitestate.github.io/rules/ins/4106",
  "definition": "Loss Ratio Standards for Rate Revisions",
  "effectiveDate": "2019-06-10",
  "historyNote": "#9690, eff 4-9-10; ss by #9938, eff 6-10-11; ss by #12799, eff 6-10-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
