  "definition": "Form 532a, Application to Exceed 50 Percent Basal Area",
  "effectiveDate": "2025-12-06",
  "expirationDate": "2035-12-06",
  "historyNote": "#14243, INTERIM, eff 4-23-25; ss by #14452 (formerly Ncr 5302.03), eff 12-6-25, EXPIRES 12-6-35",
