  "definition": "Camping Permit Suspension",
  "effectiveDate": "2025-06-25",
  "expirationDate": "2035-06-25",
  "historyNote": "#14055 EMERGENCY, EXPIRED: 2-15-25 New. #14291, eff 6-25-25, EXPIRES: 6-25-35",
