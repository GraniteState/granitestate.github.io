  "definition": "Special Use Permit Required",
  "effectiveDate": "2025-06-25",
  "expirationDate": "2035-06-25",
  "historyNote": "#14056 EMERGENCY, EXPIRED: 2-15-25 New. #14292, eff 6-25-25, EXPIRES: 6-25-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
