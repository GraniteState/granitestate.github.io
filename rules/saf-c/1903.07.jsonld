  "historyNote": "#8339, eff 4-26-05 (from Saf-C 1904.04); ss by #10190, eff 9-27-12, EXPIRED: 9-27-22 New. #13614, eff 4-25-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
