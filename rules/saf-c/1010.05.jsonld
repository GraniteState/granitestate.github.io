  "definition": "Inactive Status for Purpose of Driver Training",
  "effectiveDate": "2023-08-05",
  "historyNote": "#10176, eff 8-23-12; ss by #13685, eff 8-5-23 (see Revision Note at chapter heading for Saf-C 1000)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
