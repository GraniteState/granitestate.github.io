  "broader": "https://granitestate.github.io/rules/saf-c/6003",
  "definition": "State Fire Marshal",
  "effectiveDate": "2020-08-25",
  "historyNote": "(See Revision Note #1 and Revision Note #2 at chapter heading for Saf-C 6000) #13094, eff 8-25-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
