  "prefLabel": "Saf-C 5203.01 Liability for Costs",
  "priorExpiration": "2009-06-23",
  "recordType": "rule-section",
  "ruleText": "Saf-C 5203.01 Liability for Costs. Any responsible party shall be liable for the payment of all reasonable and necessary costs for emergency response, incident assessment, control, containment, and abatement of the immediate hazard as a direct result of a hazardous material or hazardous waste incident, or both.\n\nSource. #7511, eff 6-23-01, EXPIRED: 6-23-09\n\nNew. #12614-A, eff 8-23-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c5200.html"
}
