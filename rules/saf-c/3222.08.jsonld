  "definition": "Economic Hardship Time Extension Waiver",
  "effectiveDate": "2019-11-27",
  "historyNote": "#9184, eff 6-20-08; ss by #11016, eff 1-6-16; ss by #12932, eff 11-27-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
