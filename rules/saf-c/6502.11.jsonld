  "definition": "Tampering",
  "effectiveDate": "2022-09-20",
  "historyNote": "(See Revision Note at chapter heading for Saf-C 6500) #13448, eff 9-20-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Saf-C 6502.11",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c6500.html",
  "prefLabel": "Saf-C 6502.11 Tampering",
  "recordType": "rule-section",
  "ruleText": "Saf-C 6502.11 “Tampering” means an unlawful act or attempt to disable or circumvent the legal operation of the device, to include providing samples other than the natural breath of the user, starting the motor vehicle via unconventional means without first taking and passing a breath test, or physically circumventing the device to disable or otherwise disconnect the device from its power source, or the manipulation of the camera, to include limiting the ability of the camera to take a photo of the operator of the vehicle.\n\nSource. (See Revision Note at chapter heading for Saf-C 6500) #13448, eff 9-20-22",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c6500.html"
}
