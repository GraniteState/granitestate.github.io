  "notation": "Saf-C 5804.01",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c5800.html",
  "prefLabel": "Saf-C 5804.01 Initial Pullover",
  "recordType": "rule-section",
  "ruleText": "Saf-C 5804.01 Initial Pullover.\n\n(a) Subject vehicles shall be selected for pullover as part of normal operations.\n\n(b) Vehicles shall be observed for smoke.\n\n(c) Vehicles emitting visible black smoke will be designated for the full SAE J1667 test procedure.\n\n(d) Vehicles emitting no obvious black smoke upon pullover will be permitted to attempt to Quick Screen, as described in Saf-C 5804.02\n\nSource. #6887, EXEMPT, eff 1-1-99",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c5800.html"
}
