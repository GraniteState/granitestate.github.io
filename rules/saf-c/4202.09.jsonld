  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c4200.html",
  "prefLabel": "Saf-C 4202.09 Gallon",
  "priorExpiration": "2019-11-16",
  "recordType": "rule-section",
  "ruleText": "Saf-C 4202.09 “Gallon” means a liquid measure that is not corrected for temperature and that contains 231 cubic inches or the equivalent of 4 ¼ pounds of propane or 100 cubic feet of natural gas. The term includes “gross gallons”.\n\nSource. #10025, eff 11-16-11, EXPIRED: 11-16-19 (from Saf-C 4202.05)\n\nNew. #13019, eff 4-7-20",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c4200.html"
