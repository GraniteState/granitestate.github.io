  "broader": "https://granitestate.github.io/rules/saf-c/1011",
  "definition": "Probationary Driver License",
  "effectiveDate": "2023-08-05",
  "historyNote": "#8109, eff 6-24-04; ss by #10176, eff 8-23-12 (from Saf-C 1010.13); ); ss by #13685, eff 8-5-23 (formerly Saf-C 1011.12) (see Revision Note at chapter heading for Saf-C 1000)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
