  "notation": "Saf-C 401.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c400.html",
  "prefLabel": "Saf-C 401.02 Commercial vessel",
  "priorExpiration": "2000-07-01",
  "recordType": "rule-section",
  "ruleText": "Saf-C 401.02 “Commercial vessel” means every description of watercraft, not a private vessel or a rental vessel, used in conjunction with any form of enterprise where money or other compensation is received, whether actual or implied, for employment of the vessel, or any description of watercraft utilized by an employee of any enterprise in the performance of the employee’s duties.\n\nSource. #3010, eff 5-2-85; ss by #4562, eff 1-3-89; ss by #5862, eff 7-1-94, EXPIRED: 7-1-00\n\nNew. #7798, eff 12-3-02; ss by #8172, eff 9-21-04; ss by #10293, eff 3-20-13",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c400.html"
