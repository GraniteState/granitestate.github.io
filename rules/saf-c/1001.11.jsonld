  "definition": "License",
  "effectiveDate": "2023-08-05",
  "historyNote": "#13685, eff 8-5-23 (see Revision Note at chapter heading for Saf-C 1000)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Saf-C 1001.11",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c1000.html",
  "prefLabel": "Saf-C 1001.11 License",
  "recordType": "rule-section",
  "ruleText": "Saf-C 1001.11 “License” means “license” as defined in RSA 259:48, namely, “any driver's license or any other license or permit to drive a vehicle issued under the laws of this state or a reciprocating state including:\n\nI. Any temporary or learner's permit;\n\nII. The privilege of an unlicensed person to learn to drive a motor vehicle as provided in RSA 263:25;\n\nIII. The right of a nonresident to drive a vehicle in this state while holding a valid driver's license or permit issued by another state, territory or country whose drivers' licenses are recognized by this state; and\n\nIV. Any other privilege which any person, either resident or nonresident, may have to drive a vehicle in this state.”\n\nSource. #13685, eff 8-5-23 (see Revision Note at chapter heading for Saf-C 1000)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c1000.html"
}
