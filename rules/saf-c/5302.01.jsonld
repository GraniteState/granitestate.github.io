  "definition": "Instructor Qualifications",
  "effectiveDate": "2025-01-17",
  "historyNote": "#6144, eff 12-21-95, EXPIRED: 12-21-03 New. #8403, eff 8-2-05; ss by #10589, eff 5-14-14); ss by #14174, eff 1-17-25",
  "inScheme": "https://granitestate.github.io/rules/scheme",
