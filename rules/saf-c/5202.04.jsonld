  "broader": "https://granitestate.github.io/rules/saf-c/5202",
  "definition": "Costs",
  "effectiveDate": "2018-08-23",
  "historyNote": "#12614-A, eff 8-23-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Saf-C 5202.04",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c5200.html",
  "prefLabel": "Saf-C 5202.04 Costs",
  "recordType": "rule-section",
  "ruleText": "Saf-C 5202.04 “Costs” means all reasonable and necessary expenses that are incurred as a direct result of the hazardous materials or hazardous waste incident, or both, including but not limited to the following expenses:\n\n(a) Emergency response personnel, incident assessment, control, containment, and abatement of a hazardous materials or hazard waste incident, or both, to include costs associated with transportation and temporary storage of hazardous materials or waste if such transportation and temporary storage is necessary to control and contain the hazardous materials or hazardous waste incident, or both;\n\n(b) Equipment, including rental equipment, that is necessary for emergency response, incident assessment, control, containment, and abatement of the immediate hazard;\n\n(c) Expendable materials and supplies consumed and expended as a result of the hazardous materials or hazardous waste incident, or both, or which is used for the protection of those persons engaged in the prevention of fires or removal of hazardous materials or waste;\n\n(d) Repairing or replacing equipment, at current retail value, if said equipment was damaged or destroyed as a result of the hazardous material or hazardous waste incident, or both;\n\n(e) Decontamination of equipment that is contaminated during the hazardous materials and/or hazardous waste incident; and\n\n(f) Laboratory costs for purposes of analyzing samples taken during the incident.\n\nSource. #12614-A, eff 8-23-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c5200.html"
}
