  "broader": "https://granitestate.github.io/rules/saf-c/1905",
  "definition": "New Vehicles Purchased from a New Hampshire Licensed Dealer",
  "effectiveDate": "2023-04-25",
  "historyNote": "#4823, eff 6-1-90; ss by #4981, eff 11-16-90; ss by #6293, eff 7-23-96; ss by #8123, INTERIM, eff 7-17-04, EXPIRED: 1-13-05 New. #8339, eff 4-26-05 (from Saf-C 1906.01); ss by #10190, eff 9-27-12, EXPIRED: 9-27-22 New. #13614, eff 4-25-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
