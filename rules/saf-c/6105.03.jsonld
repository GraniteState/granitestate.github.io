  "definition": "Replacement Certificates",
  "effectiveDate": "2018-01-25",
  "historyNote": "#7650, eff 2-20-02; amd by #7975, eff 10-20-03; ss by #9472, eff 5-18-09; ss by #12467, eff 1-25-18",
