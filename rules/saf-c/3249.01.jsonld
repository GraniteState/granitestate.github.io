  "definition": "Mobile Service Garage Requirements",
  "effectiveDate": "2024-04-05",
  "historyNote": "#13727, INTERIM, eff 8-19-23, EXPIRES: 2-15-24; ss by #13920, eff 4-5-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
