  "definition": "Department Authorization to Record, Store or Retain Personal Information in Electronic Form or Format for Employment Eligibility Verification",
  "effectiveDate": "2003-01-01",
  "historyNote": "#7813, EXEMPT, eff 1-1-03",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Saf-C 5606.07",
