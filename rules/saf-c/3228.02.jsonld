  "definition": "Tools Required",
  "effectiveDate": "2016-07-02",
  "historyNote": "#11016, eff 1-6-16; ss by #11018, EMERGENCY RULE, eff 1-7-16, EXPIRES: 7-5-16; ss by #11135, eff 7-2-16",
