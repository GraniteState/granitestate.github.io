  "definition": "Minimum Qualifications for Selection as a Telecommunicator",
  "effectiveDate": "2016-06-29",
  "historyNote": "#9091, eff 2-21-08 (See Revision Note at Chapter Heading for Saf-C 7000); ss by #11128, eff 6-29-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
