  "expirationDate": "2034-10-18",
  "historyNote": "#12608, eff 8-22-18; renumbered by #13442 (formerly Saf-C 1808.04); ss by #14100, eff 10-18-24, EXPIRES: 10-18-34",
  "inScheme": "https://granitestate.github.io/rules/scheme",
