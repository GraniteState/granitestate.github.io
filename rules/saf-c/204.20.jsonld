  "broader": "https://granitestate.github.io/rules/saf-c/204",
  "definition": "Alcohol Program Completion Hearings",
  "effectiveDate": "2013-08-15",
  "historyNote": "#7349, eff 8-22-00; ss by #8230-B, eff 12-17-04; ss by #10395-B, eff 8-15-13",
