  "definition": "Operator Responsibilities",
  "effectiveDate": "2022-08-03",
  "historyNote": "(See Revision Note at Chapter Heading for Saf-C 6900) #10067, eff 12-29-11, EXPIRED: 12-29-21 New. #13426, eff 8-3-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
