  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c3900.html",
  "prefLabel": "Saf-C 3902.05 Off-site emergency responder",
  "recordType": "rule-section",
  "ruleText": "Saf-C 3902.05 “Off-site emergency responder” means a person engaged in the emergency response to releases of, or substantial threats of releases of, hazardous substances where the releases of, or substantial threats of release, occurs at a site other than:\n\n(1) Where the person is normally based for the purpose of response; or\n\n(2) A site owned and operated by the person.\n\nSource. #10014, eff 10-25-11; ss by #12966, eff 12-31-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c3900.html"
}
