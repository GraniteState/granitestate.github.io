  "definition": "Leasing Equipment",
  "effectiveDate": "2017-08-02",
  "historyNote": "#5853, eff 6-23-94; ss by #7239, eff 6-23-00, EXPIRED: 6-23-08 New. #9378, eff 1-30-09; ss by #12357, eff 8-2-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
