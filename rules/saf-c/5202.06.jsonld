  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c5200.html",
  "prefLabel": "Saf-C 5202.06 Expendable material",
  "recordType": "rule-section",
  "ruleText": "Saf-C 5202.06 “Expendable material” means materials designed for and consumed during a hazardous material incident response including but not limited to absorbent materials, firefighting foams, neutralization agents, over-pack drums or containers, recovery drums, single use acid suits, acid gloves, goggles, and protective clothing or reusable types of the preceding that are destroyed or damaged during a hazardous material or waste response.\n\nSource. #12614-A, eff 8-23-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c5200.html"
}
