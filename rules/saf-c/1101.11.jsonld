  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c1100.html",
  "prefLabel": "Saf-C 1101.11 Licensing inspector",
  "priorExpiration": "2022-05-23",
  "recordType": "rule-section",
  "ruleText": "Saf-C 1101.11 “Licensing inspector” means a person engaged in the inspection of persons employed to do work involving mechanical codes, licenses, or certifications in the fields of electrical, gas, oil, or plumbing for the purpose of determining whether the work performed is safe and in compliance with applicable codes, as well as to ensure that all proper licenses have been obtained.\n\nSource. #10137, eff 5-23-12, EXPIRED: 5-23-22\n\nNew. #13418, eff 7-25-22",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c1100.html"
}
