  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c4500.html",
  "prefLabel": "Saf-C 4501.05 Compensation",
  "priorExpiration": "2008-06-23",
  "recordType": "rule-section",
  "ruleText": "Saf-C 4501.05 \"Compensation\" means a return in money, property, or anything of value for services rendered in transporting persons or property by motor vehicle over public highways, whether paid, received, or realized directly or indirectly, and specifically includes any profit for money, goods, or things realized on the transportation of passengers.\n\nSource. #5853, eff 6-23-94; ss by #7239, eff 6-23-00, EXPIRED: 6-23-08\n\nNew. #9378, eff 1-30-09; ss by #12357, eff 8-2-17",
