  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c4200.html",
  "prefLabel": "Saf-C 4202.07 Electronic signature",
  "priorExpiration": "2019-11-16",
  "recordType": "rule-section",
  "ruleText": "Saf-C 4202.07 “Electronic signature” means “electronic signature” as defined in RSA 294-E:2, VIII namely, “an electronic sound, symbol, or process attached to or logically associated with a record and executed or adopted by a person with the intent to sign the record”.\n\nSource. #9375, eff 1-30-09; ss by #10025, eff 11-16-11, EXPIRED: 11-16-19\n\nNew. #13019, eff 4-7-20",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c4200.html"
