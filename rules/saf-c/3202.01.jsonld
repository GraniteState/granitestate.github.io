  "notation": "Saf-C 3202.01",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c3200.html",
  "prefLabel": "Saf-C 3202.01 Business location",
  "recordType": "rule-section",
  "ruleText": "Saf-C 3202.01 “Business location” means a permanent, enclosed commercial building located within this state, easily accessible and open to the public as indicated in the approved application, and at which the business of an inspection station can be lawfully carried on in accordance with the terms of all applicable building codes, zoning, and other land use regulatory ordinances. Each business location shall clearly and conspicuously display the business name in letters no less than 10” in height unless prohibited by local zoning.\n\nSource. #11016, eff 1-6-16",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-c3200.html"
}
