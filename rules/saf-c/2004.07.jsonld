  "broader": "https://granitestate.github.io/rules/saf-c/2004",
  "definition": "Use of Auto Wholesale Dealer Plates",
  "effectiveDate": "2016-01-29",
  "historyNote": "#11028, eff 1-29-16 (from Saf-C 2004.06)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
