  "broader": "https://granitestate.github.io/rules/rev/706",
  "definition": "Permission to File Returns Based on a Non-Calendar Month",
  "effectiveDate": "2024-10-29",
  "expirationDate": "2034-10-29",
  "historyNote": "#10714, eff 11-7-14; ss by #14105, eff 10-29-24, EXPIRES: 10-29-34 (formerly Rev 706.06)",
