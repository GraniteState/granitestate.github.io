  "broader": "https://granitestate.github.io/rules/rev/3203",
  "definition": "Approval or Denial of Education Tax Credit Application",
  "effectiveDate": "2022-10-13",
  "historyNote": "#10236, eff 11-28-12; amd by #12881, eff 9-27-19; ss by #13462, eff 10-13-22 (see Revision Note at chapter heading for Rev 3200)",
