  "definition": "Restaurant and Store Sales",
  "effectiveDate": "2024-10-29",
  "expirationDate": "2034-10-29",
  "historyNote": "#13077, eff 7-25-20; ss by #14105, eff 10-29-24, EXPIRES: 10-29-34 (formerly Rev 702.012)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
