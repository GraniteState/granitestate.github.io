  "broader": "https://granitestate.github.io/rules/rev/304",
  "definition": "Factor Relief",
  "effectiveDate": "2025-04-03",
  "expirationDate": "2035-04-03",
  "historyNote": "#13040, eff 4-22-20; ss by #14231, eff 4-3-25 (formerly Rev 304.12), EXPIRES 4-3-35",
