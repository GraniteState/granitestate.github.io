  "historyNote": "#10714, eff 11-7-14; ss by #13077, eff 7-25-20; ss by #14105, eff 10-29-24, EXPIRES: 10-29-34 (formerly Rev 705.12)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
