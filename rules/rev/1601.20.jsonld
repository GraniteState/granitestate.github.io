  "broader": "https://granitestate.github.io/rules/rev/1601",
  "definition": "Retailers",
  "effectiveDate": "2023-02-07",
  "historyNote": "#10213, eff 10-24-12 (from Rev 1601.17); ss by #13002 (formerly Rev 1601.19); ss by #13553, eff 2-7-23 (see Revision Note at chapter heading for Rev 1600)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
