  "broader": "https://granitestate.github.io/rules/rev/702",
  "definition": "Charges by a Catering Business",
  "effectiveDate": "2024-10-29",
  "expirationDate": "2034-10-29",
  "historyNote": "#3181, eff 1-22-86; ss by #4061, eff 5-29-86; ss by #5399, eff 5-21-92; ss by #6750, eff 5-19-98; ss by #8653, eff 6-8-06; ss by #10714, eff 11-7-14 (from Rev 702.04); ss by #14105, eff 10-29-24, EXPIRES: 10-29-34 (formerly Rev 702.06)",
