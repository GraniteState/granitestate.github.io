  "definition": "Owner",
  "effectiveDate": "2024-07-16",
  "historyNote": "#10664, eff 9-4-14; ss by #14026, eff 7-16-24 (formerly Rev 3401.11)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Rev 3401.10",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev3400.html",
  "prefLabel": "Rev 3401.10 Owner",
  "recordType": "rule-section",
  "ruleText": "Rev 3401.10 “Owner” means “owner” as defined in RSA 79:1, II. namely:\n\n“(1) For purposes of joint tenants or joint tenants with rights of survivorship, every owner that holds title to the subject property.\n\n(2) For purposes of tenants-in-common, any one or more of the tenants-in-common that hold title to the subject property. For purposes of RSA 79:10, I(a), any one or more of tenants-in-common may sign an intent to cut. Provided, however, that non-signing tenants-in-common shall have been notified by certified mail by the applicant of the intent to cut at least 30 days prior to cutting and that a bond or surety is filed to secure payment of the yield tax if any tenant-in-common does not sign or give a power of attorney to sign a notice of intent to cut.\n\n(3) A previous owner who retains timber rights to land and who registers his or her claim with the registry of deeds.\n\n(4) Any person who has purchased stumpage and cutting rights on public lands.”.\n\nSource. #10664, eff 9-4-14; ss by #14026, eff 7-16-24 (formerly Rev 3401.11)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev3400.html"
}
