  "definition": "Determination of KWH Consumed",
  "effectiveDate": "2017-03-22",
  "historyNote": "#7479, eff 4-24-01; ss by #9443, eff 4-1-09; ss by #12138, eff 3-22-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
