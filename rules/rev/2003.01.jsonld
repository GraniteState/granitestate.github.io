  "broader": "https://granitestate.github.io/rules/rev/2003",
  "definition": "Classification of Funds",
  "effectiveDate": "2024-09-10",
  "historyNote": "#5454, eff 8-28-92; ss by #6809, eff 7-21-98; ss by #10675, eff 9-24-14 (from Rev 2004.10); ss by #14072, eff 9-10-24",
