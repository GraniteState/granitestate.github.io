  "definition": "Non-Taxable Auxiliary Charges",
  "effectiveDate": "2024-10-29",
  "expirationDate": "2034-10-29",
  "historyNote": "#6690, eff 2-21-98; ss by #6750, eff 5-19-98; ss by #8653, eff 6-8-06; ss by #10714, eff 11-7-14; ss by #14105, eff 10-29-24, EXPIRES: 10-29-34",
