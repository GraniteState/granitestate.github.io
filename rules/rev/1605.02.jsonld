  "definition": "Sourcing VoIP Services",
  "effectiveDate": "2023-02-07",
  "historyNote": "#13002, eff 3-17-20; ss by #13553, eff 2-7-23 (see Revision Note at chapter heading for Rev 1600)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
