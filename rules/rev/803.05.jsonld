  "definition": "Carried Interests",
  "effectiveDate": "2024-09-10",
  "historyNote": "#10665, eff 9-9-14; ss by #10882, eff 7-11-15; ss by 14071, eff 9-10-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
