  "definition": "Free Tobacco Products",
  "effectiveDate": "2023-12-01",
  "historyNote": "#13049, eff 6-4-20 (see Revision Note #1 at chapter heading for Rev 1000); ss by #13817, eff 12-1-23 (see Revision Note #2 at chapter heading for Rev 1000)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
