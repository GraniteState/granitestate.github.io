  "broader": "https://granitestate.github.io/rules/rev/601",
  "definition": "Revaluation",
  "effectiveDate": "2024-03-28",
  "historyNote": "(See Revision Note #1 at chapter heading for Rev 600) #10581, eff 5-1-14; ss by #13916, eff 3-28-24 (formerly Rev 601.40) (see Revision Note #2 at chapter heading for Rev 600)",
