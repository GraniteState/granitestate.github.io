  "definition": "Goodwill",
  "effectiveDate": "2024-09-10",
  "historyNote": "#5300, eff 12-26-91; ss and moved by #6691, eff 2-21-98 (from Rev 801.03), EXPIRED: 2-21-06 New. #8579, eff 3-8-06; ss by #10665, eff 9-9-14; ss by #14071, eff 9-10-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Rev 801.05",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev800.html",
  "prefLabel": "Rev 801.05 Goodwill",
  "priorExpiration": "2006-02-21",
  "recordType": "rule-section",
  "ruleText": "Rev 801.05 “Goodwill” means the amount, net of any amortization, recorded on the books of the real estate holding company that represents:\n\n(a) The excess of cost over fair value of the company's net assets acquired; or\n\n(b) The value ascribed to the excess earning power of the company, determined according to generally accepted accounting principles.\n\nSource. #5300, eff 12-26-91; ss and moved by #6691, eff 2-21-98 (from Rev 801.03), EXPIRED: 2-21-06\n\nNew. #8579, eff 3-8-06; ss by #10665, eff 9-9-14; ss by #14071, eff 9-10-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev800.html"
