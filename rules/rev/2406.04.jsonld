  "definition": "Economic Revitalization Zone Tax Credits",
  "effectiveDate": "2026-05-02",
  "expirationDate": "2036-05-02",
  "historyNote": "#9065, eff 1-10-08; ss by #11032, eff 1-29-16; ss by #14573, eff 5-2-26, EXPIRES: 5-2-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
