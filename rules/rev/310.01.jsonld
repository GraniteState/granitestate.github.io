  "definition": "Substantial Understatement of Tax",
  "effectiveDate": "2025-04-03",
  "expirationDate": "2035-04-03",
  "historyNote": "#5355, eff 3-16-92, EXPIRED: 3-16-98 New. #6853, eff 9-23-98; ss by #8709, eff 8-25-06; ss by #10758, eff 1-16-15; ss by #14231, eff 4-3-25, EXPIRES 4-3-35",
