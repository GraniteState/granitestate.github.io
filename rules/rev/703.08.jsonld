  "definition": "Purchased Coupons and Gift Certificates for Rooms",
  "effectiveDate": "2024-10-29",
  "expirationDate": "2034-10-29",
  "historyNote": "#6750, eff 5-19-98; ss by #8653, eff 6-8-06; ss by #10714, eff 11-7-14; ss by #14105, eff 10-29-24, EXPIRES: 10-29-34",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Rev 703.08",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev700.html",
  "prefLabel": "Rev 703.08 Purchased Coupons and Gift Certificates for Rooms",
  "recordType": "rule-section",
  "ruleText": "Rev 703.08 Purchased Coupons and Gift Certificates for Rooms.\n\n(a) Coupons, gift certificates, or other documents purchased for the purpose of future redemption for value, products, or services shall not be taxable when purchased.\n\n(b) When purchased coupons or gift certificates are redeemed:\n\n(1) The portion of the charge attributable to taxable rooms shall be taxable to the customer; and\n\n(2) The tax shall be applied on a basis equivalent to sales made with traditional payment methods without regard to the original purchase price of the coupon or gift certificate.\n\n(c) If the taxable room has no stated value, the coupon, gift certificate, or other document shall be taxed at the time of purchase for the actual amount paid for the coupon, gift certificate, or other document.\n\nSource. #6750, eff 5-19-98; ss by #8653, eff 6-8-06; ss by #10714, eff 11-7-14; ss by #14105, eff 10-29-24, EXPIRES: 10-29-34",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev700.html"
}
