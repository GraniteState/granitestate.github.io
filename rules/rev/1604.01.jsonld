  "definition": "Sourcing Gross Charges for Mobile Telecommunications",
  "effectiveDate": "2023-02-07",
  "historyNote": "#8178, eff 9-24-04; ss by #10213, eff 10-24-12; ss by #13553, eff 2-7-23 (see Revision Note at chapter heading for Rev 1600)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
