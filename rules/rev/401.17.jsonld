  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev400.html",
  "prefLabel": "Rev 401.17 Owner",
  "recordType": "rule-section",
  "ruleText": "Rev 401.17 “Owner” means a person who owns residential real estate or other property and:\n\n(a) Includes a person who has:\n\n(1) Placed property in a grantor/revocable trust;\n\n(2) Equitable title in property;\n\n(3) A life estate in property; and\n\n(b) Does not include a person who has placed property in an irrevocable trust or any other legal entity distinct from the person.\n\nSource. #12027, eff 10-28-16; renumbered by #12925 (formerly Rev 401.16)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/rev400.html"
}
