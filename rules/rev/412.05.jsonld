  "definition": "Exemption for Improvements to Assist Deaf or Severely Hearing Impaired Persons",
  "effectiveDate": "2024-04-27",
  "historyNote": "#12027, eff 10-28-16; renumbered by #12925 (formerly Rev 411.05); ss by #13943-B, eff 4-27-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
