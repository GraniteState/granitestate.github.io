  "broader": "https://granitestate.github.io/rules/rev/706",
  "definition": "Extension of Time for Filing Returns",
  "effectiveDate": "2024-10-29",
  "expirationDate": "2034-10-29",
  "historyNote": "#10714, eff 11-7-14 (from Rev 704.06); ss by #14105, eff 10-29-24, EXPIRES: 10-29-34 (formerly Rev 706.07)",
