  "definition": "Documents Involving the United States Government",
  "effectiveDate": "2017-03-22",
  "historyNote": "#9437, eff 3-24-09; ss by #12137, eff 3-22-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
