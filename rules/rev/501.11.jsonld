  "definition": "Owner",
  "effectiveDate": "2019-07-25",
  "historyNote": "#7860, eff 3-31-03 (formerly Rev 501.09) EXPIRED: 3-31-11 New. #9926, eff 5-18-11; ss by #12834, eff 7-25-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
