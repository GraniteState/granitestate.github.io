  "definition": "Standard or Optional Service-Connected Total and Permanent Disability Tax Credits",
  "effectiveDate": "2016-10-28",
  "historyNote": "(See Revision Note at chapter heading for Rev 400) #9309, eff 10-30-08 (from Rev 404.02); ss by #12027, eff 10-28-16; renumbered by #12925 (formerly Rev 405.02)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
