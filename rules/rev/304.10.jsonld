  "broader": "https://granitestate.github.io/rules/rev/304",
  "definition": "Adjustments Required to Apportionment Factors for Television and Radio Broadcasting Industries",
  "effectiveDate": "2025-04-03",
  "expirationDate": "2035-04-03",
  "historyNote": "#6129, eff 11-23-98; ss by #6853, eff 9-23-98; ss by #8709, eff 8-25-06; ss by #10758, eff 1-16-15; amd by #12906, eff 10-23-19; ss by #13177, eff 3-6-21; ss by #14231, eff 4-3-25 (formerly Rev 304.09), EXPIRES 4-3-35",
