  "effectiveDate": "2019-10-24",
  "historyNote": "(See Revision Note at chapter heading for Jus 1400) #9783-A, eff 9-11-10, EXPIRED: 9-11-18 New. #12657, INTERIM, eff 11-1-18, EXPIRED: 4-30-19 New. #12910, eff 10-24-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Jus 1403.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus1400.html",
  "prefLabel": "Jus 1403.02 Recording of Floor Plans",
  "priorExpiration": "2019-04-30",
  "recordType": "rule-section",
  "ruleText": "Jus 1403.02 Recording of Floor Plans. No floor plans of any structure which, when constructed, shall contain or constitute all or a part of any unit or units, and which is located or to be located on any portion of the submitted land other than within the boundaries of any convertible lands, shall be recorded until such time as all units, or those portions of units that are contained within or constitute structures, depicted on such plans have been certified as substantially completed pursuant to RSA 356-B:20, I, II.\n\nSource. (See Revision Note at chapter heading for Jus 1400) #9783-A, eff 9-11-10, EXPIRED: 9-11-18\n\nNew. #12657, INTERIM, eff 11-1-18, EXPIRED: 4-30-19\n\nNew. #12910, eff 10-24-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus1400.html"
