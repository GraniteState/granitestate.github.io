  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus600.html",
  "prefLabel": "Jus 602.22 New Evidence",
  "priorExpiration": "2017-09-25",
  "recordType": "rule-section",
  "ruleText": "Jus 602.22 “New Evidence” means information or documents not available to or which could not reasonably have been discovered by a claimant at the time the claimant’s claim was considered by the commission. The term does not include information or documents that were available, could have been discovered, or restatements of information or arguments already submitted to the commission.\n\nSource. #9553, eff 9-25-09, EXPIRED: 9-25-17\n\nNew. #12938, eff 12-9-19 (formerly Jus 602.19)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus600.html"
