  "prefLabel": "Jus 410.02 Notice",
  "recordType": "rule-section",
  "ruleText": "Jus 410.02 Notice. Any charitable trust that agrees to permit a charitable sales promotion to be conducted by a commercial co-venturer on its behalf shall file with the charitable trusts unit Form NHCT-22 “Notice of Charitable Sales Promotion,” effective September 2022, available online at www.doj.nh.gov/charitable-trusts/forms.htm prior to the date on which the charitable sales promotion commences.\n\nSource. #13455, eff 10-7-22; ss by #14162, eff 12-27-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus400.html"
}
