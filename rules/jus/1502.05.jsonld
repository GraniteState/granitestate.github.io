  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus1500.html",
  "prefLabel": "Jus 1502.05 County attorney",
  "recordType": "rule-section",
  "ruleText": "Jus 1502.05 \"County attorney\" means the person holding the office of county attorney in each of the ten counties of the state, as established by RSA 7:33, and having been duly elected by the inhabitants of the county or appointed by the superior court or members of the county convention, in accordance with RSA 7:33 or RSA 661:9 (Supp).\n\nSource. #8082, eff 5-8-04",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus1500.html"
}
