  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus400.html",
  "prefLabel": "Jus 401.05 Charitable purpose",
  "recordType": "rule-section",
  "ruleText": "Jus 401.05 “Charitable purpose” means an intention or mission that is benevolent, philanthropic, patriotic, educational, humane, recreational, scientific, public health, environmental conservation, civic, or otherwise beneficial to the public interest. The term includes any purposes that could qualify for a determination of tax exempt status pursuant to 26 U.S.C. § 501(c)(3) of the Internal Revenue Code.\n\nSource. #13455, eff 10-7-22; ss by #14162, eff 12-27-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus400.html"
