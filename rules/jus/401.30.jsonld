  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus400.html",
  "prefLabel": "Jus 401.30 Reasonable minimum contacts",
  "recordType": "rule-section",
  "ruleText": "Jus 401.30 “Reasonable minimum contacts” means that a charitable trust:\n\n(a) Conducts more than de minimis operations in New Hampshire;\n\n(b) Specifically targets, through internet or non-internet means, New Hampshire residents to make donations; or\n\n(c) Receives donations from New Hampshire residents on a repeated and ongoing or a substantial basis.\n\nSource. #13455, eff 10-7-22; ss by #14162, eff 12-27-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus400.html"
}
