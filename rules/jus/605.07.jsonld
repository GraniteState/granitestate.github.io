  "definition": "Relocation Expenses Awards",
  "effectiveDate": "2019-12-09",
  "historyNote": "#9553, eff 9-25-09, EXPIRED: 9-25-17 New. #12938, eff 12-9-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
