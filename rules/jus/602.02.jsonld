  "definition": "Advocate",
  "effectiveDate": "2019-12-09",
  "historyNote": "#4864, eff 7-13-90, EXPIRED: 7-13-96 New. #7117, eff 10-8-99, EXPIRED: 10-8-07 New. #9553, eff 9-25-09, EXPIRED: 9-25-17 New. #12938, eff 12-9-19",
