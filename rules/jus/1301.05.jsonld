  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus1300.html",
  "prefLabel": "Jus 1301.05 Interest",
  "priorExpiration": "2019-04-30",
  "recordType": "rule-section",
  "ruleText": "Jus 1301.05 “Interest” means “interest” as defined in RSA 356-A:1, XV, namely “without limitation, any fee simple interest, leasehold interest for a term of more than 5 years, life estate and time sharing interest.”\n\nSource. (See Revision Note at chapter heading for Jus 1300) #9782-A, eff 9-11-10, EXPIRED: 9-11-18\n\nNew. #12656, INTERIM, eff 11-1-18, EXPIRED: 4-30-19\n\nNew. #12909, eff 10-24-19",
