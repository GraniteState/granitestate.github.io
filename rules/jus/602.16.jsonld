  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus600.html",
  "prefLabel": "Jus 602.16 Eligible Crime",
  "priorExpiration": "2017-09-25",
  "recordType": "rule-section",
  "ruleText": "Jus 602.16 “Eligible Crime” means any misdemeanor or felony that results in personal injury to or the death of the victim, or driving under the influence of alcohol or a controlled substance and that results in personal injury to or the death of the victim. For the purposes of these rules, the term includes any such act if it forms or could form the basis of a juvenile delinquency petition pursuant to RSA 169-D.\n\nSource. #9553, eff 9-25-09, EXPIRED: 9-25-17\n\nNew. #12938, eff 12-9-19 (formerly Jus 602.14)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/jus600.html"
