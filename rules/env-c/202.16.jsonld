  "notation": "Env-C 202.16",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-c200.html",
  "prefLabel": "Env-C 202.16 Respondent",
  "recordType": "rule-section",
  "ruleText": "Env-C 202.16 “Respondent” means:\n\n(a) For purposes of a license action, the person who holds a license or has applied for renewal of a license;\n\n(b) For purposes of an administrative fine proceeding, the person against whom the department proposes to impose an administrative fine; or\n\n(c) For any action initiated under Env-C 204.01(b), the person against whom the department proposes to take the action.\n\nSource. #8851-A, eff 3-25-07",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-c200.html"
