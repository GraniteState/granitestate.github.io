  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-mec400.html",
  "prefLabel": "Saf-Mec 401.04 Seminar provider",
  "recordType": "rule-section",
  "ruleText": "Saf-Mec 401.04 “Seminar provider” means an individual who holds a current and valid NH master plumber’s license and/or a NH fuel gas fitter’s license with a service technician’s endorsement, who has been trained and approved by the mechanical licensing board for the purposes of providing continuing educational classes on the laws, rules, codes and standards of this subdivision for licensure renewal.\n\nSource. #10848, eff 7-1-15",
