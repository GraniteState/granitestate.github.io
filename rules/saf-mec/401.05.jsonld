  "definition": "Identification Picture",
  "effectiveDate": "2015-07-01",
  "historyNote": "#10848, eff 7-1-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Saf-Mec 401.05",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-mec400.html",
  "prefLabel": "Saf-Mec 401.05 Identification Picture",
  "recordType": "rule-section",
  "ruleText": "Saf-Mec 401.05 “Identification Picture” means a color photograph of the applicant’s face not less than 2” wide by 2” high, which demonstrates an accurate depiction of the applicant at the time of licensure renewal, and that said picture may be used again but for no more than 4 renewal periods or 10 calendar years whichever comes first.\n\nSource. #10848, eff 7-1-15",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/saf-mec400.html"
}
