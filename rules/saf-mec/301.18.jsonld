  "definition": "Equivalent hours of service in an approved educational setting",
  "effectiveDate": "2015-07-01",
  "historyNote": "#10847, eff 7-1-15 (from Saf-Mec 303.18)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
