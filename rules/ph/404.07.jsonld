  "effectiveDate": "2015-04-18",
  "historyNote": "#6181-B, eff 2-5-96, EXPIRED: 2-5-04 New. #8316, eff 3-26-05, EXPIRED: 3-26-13 New. #10812, eff 4-18-15 New. #10812, eff 4-18-15",
