  "broader": "https://granitestate.github.io/rules/ph/2006",
  "definition": "Handling Recalls",
  "effectiveDate": "2017-07-22",
  "historyNote": "#12336, eff 7-22-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Ph 2006.04",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html",
  "prefLabel": "Ph 2006.04 Handling Recalls",
  "recordType": "rule-section",
  "ruleText": "Ph 2006.04 Handling Recalls.\n\n(a) An outsourcing facility shall maintain a written policy for handling recalls and withdrawals for products.\n\n(b) Policies required by (a) above shall cover all recalls and withdrawals of compounded sterile products due to:\n\n(1) A voluntary action on the part of the compounder;\n\n(2) The direction of the Food and Drug Administration, or any other federal, state or local governmental agency; and\n\n(3) Replacement of existing merchandise with an improved product or new design.\n\nSource. #12336, eff 7-22-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html"
}
