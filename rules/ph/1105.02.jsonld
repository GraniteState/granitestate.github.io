  "definition": "Practice Under a Collaborative Practice Agreement",
  "effectiveDate": "2023-08-20",
  "historyNote": "#12464, eff 1-23-18 (from Ph 1104.03); ss by #13670, eff 8-20-23 (formerly Ph 1105.03)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
