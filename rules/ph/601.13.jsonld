  "definition": "Access to Drug Supply",
  "effectiveDate": "2017-07-22",
  "historyNote": "#8572, eff 2-23-06; ss by #9139-B, eff 4-25-08 EXPIRED: 4-25-16 New. #12335, eff 7-22-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
