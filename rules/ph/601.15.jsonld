  "definition": "Prescription Labels",
  "effectiveDate": "2017-07-22",
  "historyNote": "#8572, eff 2-23-06, EXPIRED: 2-23-14 New. #12335, eff 7-22-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
