  "definition": "Intake pharmacy",
  "effectiveDate": "2018-02-24",
  "historyNote": "#9469, eff 5-16-09, EXPIRED: 5-16-17 New. #12485, eff 2-24-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Ph 1202.06",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html",
  "prefLabel": "Ph 1202.06 Intake pharmacy",
  "priorExpiration": "2017-05-16",
  "recordType": "rule-section",
  "ruleText": "Ph 1202.06 “Intake pharmacy” means a licensed pharmacy, in this or any other state, district or commonwealth of the United States, that receives the patient’s or prescribing practitioner’s request to fill or refill a prescription, including a central processing pharmacy or a central fill pharmacy, as defined below, if the prescription was transmitted by the prescribing practitioner directly to such pharmacy or if the patient requested the refill from that pharmacy.\n\nSource. #9469, eff 5-16-09, EXPIRED: 5-16-17\n\nNew. #12485, eff 2-24-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html"
