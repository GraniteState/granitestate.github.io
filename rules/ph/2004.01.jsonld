  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html",
  "prefLabel": "Ph 2004.01 Reporting Changes",
  "recordType": "rule-section",
  "ruleText": "Ph 2004.01 Reporting Changes. The person to whom a license to operate a 503B outsourcing facility has been issued in New Hampshire shall, within 30 days of that person's discovery of a change in any of the data contained in the application for an original or renewal permit, report that change to the board in writing. An original new permit application, “Application for Permit – Bulk Sterile & Non-Sterile Compounders (Including FDA Registered 503B Outsourcing Facilities)”, form Ph OF-1, revised June 2017, shall be completed and filed in addition to the written notice when the name, location, ownership, or licensed area are changed.\n\nSource. #12336, eff 7-22-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html"
}
