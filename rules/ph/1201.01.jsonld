  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html",
  "prefLabel": "Ph 1201.01 Purpose",
  "priorExpiration": "2017-05-16",
  "recordType": "rule-section",
  "ruleText": "Ph 1201.01 Purpose. The purpose of this chapter is to set forth the requirements, limitations, and prohibitions for pharmacies that engage in central prescription processing so as to ensure that, for the protection of the public, all central prescription processing activities regulated by the board are performed in compliance with applicable state law and rules by those who are licensed by the board.\n\nSource. #9469, eff 5-16-09, EXPIRED: 5-16-17\n\nNew. #12485, eff 2-24-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ph100-2600.html"
