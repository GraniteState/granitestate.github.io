  "definition": "Continuing Education Requirements for Licensed Advanced Pharmacy Technician",
  "effectiveDate": "2022-10-18",
  "historyNote": "#13463, eff 10-18-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
