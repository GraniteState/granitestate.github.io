  "broader": "https://granitestate.github.io/rules/ph/904",
  "definition": "Reporting Changes",
  "effectiveDate": "2021-07-30",
  "historyNote": "#7474, eff 4-5-01; ss by #9341, eff 12-4-08; ss by #10663, eff 9-3-14; ss by #13244, eff 7-30-21",
