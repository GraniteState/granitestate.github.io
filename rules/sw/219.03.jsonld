  "definition": "Notice",
  "effectiveDate": "2017-01-27",
  "historyNote": "(See Revision Note at chapter heading for Sw 200) #12093, eff 1-27-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Sw 219.03",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sw200.html",
  "prefLabel": "Sw 219.03 Notice",
  "recordType": "rule-section",
  "ruleText": "Sw 219.03 Notice. In accordance with RSA 541-A:6, the commission shall give at least 20 days prior notice in the N. H. Rulemaking Register of its intent to hold a public hearing and the cut-off date for the submission of written testimony pursuant to RSA 541-A:11, I, on any proposed adoption, amendment, readoption, readoption with amendment, or repeal of a rule. Pursuant to RSA 541-A:6, I, the notice period shall begin on the day after the date of publication of the notice in the Rulemaking Register.\n\nSource. (See Revision Note at chapter heading for Sw 200) #12093, eff 1-27-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sw200.html"
