  "definition": "Renewal Subscriptions",
  "effectiveDate": "2009-07-25",
  "expirationDate": "2017-07-25",
  "historyNote": "#8543, eff 1-21-06; ss by #9519, eff 7-25-09, EXPIRED: 7-25-17",
