  "definition": "Validation Requirements",
  "effectiveDate": "2008-05-31",
  "historyNote": "#6606, eff 10-22-97, rpld by #7403, eff 11-15-00 New. #7728, eff 7-23-02; ss by #9165, eff 5-31-08",
  "inScheme": "https://granitestate.github.io/rules/scheme",
