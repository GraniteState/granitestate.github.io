  "definition": "Continuing Education Requirements",
  "effectiveDate": "2016-11-10",
  "historyNote": "#8840, eff 3-13-07, EXPIRED: 3-13-15 New. #11095, INTERIM, eff 5-12-16, EXPIRED: 11-8-16 New. #12040, eff 11-10-16",
