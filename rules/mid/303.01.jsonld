  "broader": "https://granitestate.github.io/rules/mid/303",
  "definition": "Eligibility for Initial Certification",
  "effectiveDate": "2019-12-10",
  "historyNote": "#7421, eff 1-3-01, EXPIRED: 1-3-09 New. #9691, eff 4-8-10; ss by #12660, eff 11-5-18; ss by #12939-B, eff 12-10-19",
