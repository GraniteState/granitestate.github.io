  "effectiveDate": "2016-11-10",
  "historyNote": "#9089, eff 2-20-08, EXPIRED: 2-20-16 New. #11095, INTERIM, eff 5-12-16, EXPIRED: 11-8-16 New. #12040, eff 11-10-16",
