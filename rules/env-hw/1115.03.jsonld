  "definition": "Requirements for Management of Universal Waste Aerosol Cans",
  "effectiveDate": "2025-08-01",
  "historyNote": "#13406, eff 7-23-22; ss by #14281, eff 8-1-25, EXIRES: 8-1-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
