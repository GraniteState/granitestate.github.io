  "definition": "Materials Containing or Otherwise Contaminated with Used Oil",
  "effectiveDate": "2025-08-01",
  "expirationDate": "2035-08-01",
  "historyNote": "#14282, eff 8-1-25, EXPIRES: 8-1-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
