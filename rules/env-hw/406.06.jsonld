  "definition": "Conditional Delisting",
  "effectiveDate": "2026-02-28",
  "expirationDate": "2036-02-28",
  "historyNote": "#12346, eff 8-14-17 (formerly Env-Hw 406.03); ss by #14524, eff 2-28-26, EXPIRES: 2-28-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
