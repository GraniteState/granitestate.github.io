  "broader": "https://granitestate.github.io/rules/env-dw/902",
  "definition": "Protection of the Purity of the Water of Lake Massabesic and Its Tributaries",
  "effectiveDate": "2021-10-26",
  "historyNote": "(See Revision Note at part heading for Env-Dw 902) #10602, eff 5-20-14; ss by #13286, eff 10-26-21",
