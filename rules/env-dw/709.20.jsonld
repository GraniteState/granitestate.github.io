  "definition": "Relief from Boil Order Requirements",
  "effectiveDate": "2025-08-22",
  "expirationDate": "2035-08-22",
  "historyNote": "#10771, eff 2-1-15 (from Env-Dw 709.15); ss by 14343, eff 8-22-25, EXPIRES: 8-22-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
