  "prefLabel": "Env-Dw 1402.25 Grant agreement",
  "priorExpiration": "2022-04-28",
  "recordType": "rule-section",
  "ruleText": "Env-Dw 1402.25 “Grant agreement” means the financial assistance agreement between the state and a\n\nrecipient through which the state agrees to provide grant funds approved by the department from the PFAS RLF to the recipient and the recipient agrees to use the grant funds as specified in its application as approved by the department.\n\nSource. # #13289, INTERIM, eff 10-30-21, EXPIRES: 4-28-22; ss by #13372, eff 4-21-22",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-dw1400.html"
}
