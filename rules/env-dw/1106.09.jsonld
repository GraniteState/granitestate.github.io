  "broader": "https://granitestate.github.io/rules/env-dw/1106",
  "definition": "Establishment and Verification of Revenue Program",
  "effectiveDate": "2021-01-20",
  "historyNote": "(See Revision Note #1 and Revision Note #2 at chapter heading for Env-Dw 1100) #13160, eff 1-20-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
