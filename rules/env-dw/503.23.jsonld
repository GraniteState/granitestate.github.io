  "broader": "https://granitestate.github.io/rules/env-dw/503",
  "definition": "Termination of Service",
  "effectiveDate": "2024-06-25",
  "historyNote": "#14006, eff 6-25-24 (formerly Env-Dw 503.09)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
