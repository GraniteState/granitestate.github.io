  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-dw700.html",
  "prefLabel": "Env-Dw 714.10 Monitoring Requirements for Lead and Copper in Source Water",
  "recordType": "rule-section",
  "ruleText": "Env-Dw 714.10 Monitoring Requirements for Lead and Copper in Source Water. The O/O of a water system that is subject to this part shall:\n\n(a) Comply with the monitoring requirements for lead and copper in source water at every entry point to the distribution system as specified in 40 CFR §141.88, 7-1-16 edition; and\n\n(b) Collect and submit to the department a confirmation sample for any sampling location for which the monitoring result shows either lead at or above 0.015 mg/L or copper at or above 1.3 mg/L, or both.\n\nSource. #9859, eff 2-8-11; ss by #12181, eff 5-23-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-dw700.html"
}
