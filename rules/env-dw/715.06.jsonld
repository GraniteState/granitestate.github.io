  "definition": "Monitoring Requirements",
  "effectiveDate": "2018-06-01",
  "historyNote": "#9619, eff 1-1-10; ss by #12532, eff 6-1-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
