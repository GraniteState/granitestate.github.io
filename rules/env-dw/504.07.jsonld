  "definition": "Service Line and Water Meter Installation and Maintenance Policy",
  "effectiveDate": "2024-06-25",
  "historyNote": "(See Revision Note at part heading for Env-Dw 504) #10465, eff 12-2-13; ss by #14006, eff 6-25-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
