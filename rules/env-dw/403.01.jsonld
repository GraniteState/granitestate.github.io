  "effectiveDate": "2024-12-25",
  "historyNote": "(See Revision Note at part heading for Env-Dw 403) #10610, eff 6-1-14; ss by #14158, eff 12-25-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
