  "broader": "https://granitestate.github.io/rules/env-dw/503",
  "definition": "Long-Term Water Supply Inadequacies",
  "effectiveDate": "2024-06-25",
  "historyNote": "(See Revision Note at part heading for Env-Dw 503) #10465, eff 12-2-13; ss by #14006, eff 6-25-24 (formerly Env-Dw 503.20)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
