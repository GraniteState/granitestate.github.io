  "definition": "Removing a Source; Reducing Monitoring Responsibility",
  "effectiveDate": "2019-01-01",
  "historyNote": "#9700, eff 5-1-10; ss by #12667, eff 1-1-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
