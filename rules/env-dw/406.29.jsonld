  "broader": "https://granitestate.github.io/rules/env-dw/406",
  "definition": "Modifications and Expansions",
  "effectiveDate": "2024-12-25",
  "historyNote": "(See Revision Note at part heading for Env-Dw 405) #10612, eff 6-1-14 New. #14158, eff 12-25-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
