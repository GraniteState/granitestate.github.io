  "definition": "Compliance Monitoring for Systems with Chemical Disinfection Serving More than 3,300 People",
  "effectiveDate": "2018-06-01",
  "historyNote": "#9600, eff 11-21-09; ss by #12525, eff 6-1-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
