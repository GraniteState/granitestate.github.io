  "definition": "Limitations on Construction Project Modifications; Requests for Approval",
  "effectiveDate": "2022-04-21",
  "historyNote": "#13164, eff 1-26-21; ss by #13372, eff 4-21-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
