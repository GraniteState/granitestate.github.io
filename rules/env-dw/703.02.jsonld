  "definition": "Radon Testing for New Water Supply Sources",
  "effectiveDate": "2019-06-28",
  "historyNote": "#9699, eff 5-1-10; ss by #12665, eff 1-1-19; ss by #12819, eff 6-28-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
