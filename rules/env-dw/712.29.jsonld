  "definition": "Compliance Determination for PFAS Contaminants; Limiting Public Notice",
  "effectiveDate": "2019-09-30",
  "historyNote": "#12838, eff 9-30-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
