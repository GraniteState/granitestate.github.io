  "broader": "https://granitestate.github.io/rules/env-dw/405",
  "definition": "Verification of Quality of Distribution Pipe Installation",
  "effectiveDate": "2024-12-25",
  "historyNote": "(See Revision Note at part heading for Env-Dw 405) #10612, eff 6-1-14; ss by #14158, eff 12-25-24 (formerly Env-Dw 405.31)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
