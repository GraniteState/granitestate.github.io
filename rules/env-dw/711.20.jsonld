  "broader": "https://granitestate.github.io/rules/env-dw/711",
  "definition": "Revised Monitoring for Nitrate",
  "effectiveDate": "2019-01-01",
  "historyNote": "#9700, eff 5-1-10; amd by #10771, eff 2-1-15; ss by #12668, eff 1-1-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
