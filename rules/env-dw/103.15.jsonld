  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-dw100.html",
  "prefLabel": "Env-Dw 103.15 Cross-connection control program",
  "recordType": "rule-section",
  "ruleText": "Env-Dw 103.15 “Cross-connection control program” means a set of rules adopted by a water system which requires at least the installation of backflow prevention devices, periodic testing and inspection of these devices, and annual inspection reports of these devices to eliminate existing cross-connections and to prevent the possible occurrence of backflow or back-siphonage from contaminating the drinking water system.\n\nSource. (See Revision Note at chapter heading for Env-Dw 100) #10606, eff 6-1-14",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-dw100.html"
}
