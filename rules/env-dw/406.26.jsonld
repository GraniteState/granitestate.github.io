  "broader": "https://granitestate.github.io/rules/env-dw/406",
  "definition": "Distribution System",
  "effectiveDate": "2024-12-25",
  "historyNote": "(See Revision Note at part heading for Env-Dw 406) #10613, eff 6-1-14; ss by #14158, eff 12-25-24 (formerly Env-Dw 406.25)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
