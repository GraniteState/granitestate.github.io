  "broader": "https://granitestate.github.io/rules/env-dw/709",
  "definition": "Invalidation of Total Coliform Samples",
  "effectiveDate": "2025-08-22",
  "expirationDate": "2035-08-22",
  "historyNote": "#9700, eff 5-1-10; ss by #10771, eff 2-1-15 (from Env-Dw 709.12); ss by 14343, eff 8-22-25, EXPIRES: 8-22-35",
