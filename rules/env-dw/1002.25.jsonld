  "definition": "Snowmobile Trail Plan Approval",
  "effectiveDate": "2018-01-01",
  "historyNote": "#12441, eff 1-1-18 (formerly Env-Dw 1002.20)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
