  "definition": "Investigative Monitoring to Prove Source is Not Contaminated",
  "effectiveDate": "2018-06-01",
  "historyNote": "#9600, eff 11-21-09; ss by #12525, eff 6-1-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
