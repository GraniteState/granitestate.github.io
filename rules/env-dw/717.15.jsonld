  "definition": "Compliance Monitoring for Systems with Chemical Disinfection Serving 3,300 People or Fewer",
  "effectiveDate": "2018-06-01",
  "historyNote": "#9600, eff 11-21-09; ss by #12525, eff 6-1-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-Dw 717.15",
