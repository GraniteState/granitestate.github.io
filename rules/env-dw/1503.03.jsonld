  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-dw1500.html",
  "prefLabel": "Env-Dw 1503.03 Income Qualified Eligibility",
  "recordType": "rule-section",
  "ruleText": "Env-Dw 1503.03 Income Qualified Eligibility. An applicant that is income qualified as set forth in this section may request a rebate under Env-Dw 1505 be distributed directly to a treatment installer or contractor. An applicant shall be determined to be income qualified if:\n\n(a) The applicant’s total family annual income does not exceed 24 CFR, Title 24, U.S. Department of Housing and Urban Development, low-income criteria that apply to the county or metropolitan statistical area where the property is located; and\n\n(b) The applicant has requested, and department has granted, pre-approval to the applicant pursuant to Env-Dw 1504.\n\nSource. #14201, eff 2-26-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-dw1500.html"
}
