  "historyNote": "#13164, eff 1-26-21; ss by #13289, INTERIM, eff 10-30-21, EXPIRES: 4-28-22; ss by #13372, eff 4-21-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
