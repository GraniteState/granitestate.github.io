  "definition": "Requirements for Corrosion Control and Source Water Treatment and Monitoring",
  "effectiveDate": "2017-05-23",
  "historyNote": "#9859, eff 2-8-11; ss by #12181, eff 5-23-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
