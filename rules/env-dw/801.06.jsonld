  "definition": "Consultation for Acute Public Notice Violations or Situations",
  "effectiveDate": "2019-01-01",
  "historyNote": "(See Revision Note at chapter heading for Env-Dw 800) #9730, eff 6-30-10; ss by #12675, eff 1-1-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
