  "definition": "VOC and SOC Contaminants Monitoring Waivers: Duration, Conditions, Renewal, Revocation",
  "effectiveDate": "2019-01-01",
  "historyNote": "#9700, eff 5-1-10; amd by #10771, eff 2-1-15; ss by #12668, eff 1-1-19 (formerly Env-Dw 712.19)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
