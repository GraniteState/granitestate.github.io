  "broader": "https://granitestate.github.io/rules/env-dw/303",
  "definition": "Contamination Control Program",
  "effectiveDate": "2016-04-01",
  "historyNote": "(See Revision Notes #1 and #2 at part heading for Env-Dw 303) #11059, eff 4-1-16",
