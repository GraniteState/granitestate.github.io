  "definition": "Redevelopment",
  "effectiveDate": "2026-08-06",
  "expirationDate": "2036-08-06",
  "historyNote": "#13758, eff 9-28-23; ss by #14472, eff 1-19-26, EXPIRES: 1-19-36; renumbered by #14656, eff 8-6-26, EXPIRES: 8-6-36 (formerly Env-Wq 1502.53)",
