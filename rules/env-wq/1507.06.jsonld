  "definition": "Peak Runoff Control Requirements",
  "effectiveDate": "2026-01-19",
  "expirationDate": "2036-01-19",
  "historyNote": "#9343, eff 1-1-09; amd by #9817-A, eff 12-1-10; ss by #12342, eff 8-15-17; ss by #14472, eff 1-19-26, EXPIRES: 1-19-36",
