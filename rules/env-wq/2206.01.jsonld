  "definition": "Application for Training Program Approval",
  "effectiveDate": "2024-05-24",
  "historyNote": "#10447, INTERIM, eff 11-1-13, EXPIRED: 4-30-14 New. #10697, eff 10-18-14; ss by #13982, eff 5-24-24",
