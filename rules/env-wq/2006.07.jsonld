  "broader": "https://granitestate.github.io/rules/env-wq/2006",
  "definition": "Scoring Based on Increase in Understanding",
  "effectiveDate": "2009-10-17",
  "historyNote": "#9570, eff 10-17-09",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-Wq 2006.07",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wq2000.html",
  "prefLabel": "Env-Wq 2006.07 Scoring Based on Increase in Understanding",
  "recordType": "rule-section",
  "ruleText": "Env-Wq 2006.07 Scoring Based on Increase in Understanding. Each application shall be scored on how the project will increase the understanding of coastal issues and lead to behavior change that will positively impact the coast as follows:\n\n(a) A project in which the primary purpose is outreach and education, with clearly defined target audiences and strategies to reach those audiences, and that incorporates direct hands-on outreach and education, such as trainings, field events, and workshops, shall receive 3 points;\n\n(b) A project with clearly defined target audiences and strategies to reach those audiences, that incorporates indirect outreach and education, such as brochures, Internet materials and web sites, mass media campaigns, and interpretive kiosks and/or signage, shall receive 2 points;\n\n(c) A project that does not define target audiences and outreach strategies, but incorporates an indirect education and outreach component shall receive one point; and\n\n(d) A project that does not incorporate an outreach and education component shall receive no points.\n\nSource. #9570, eff 10-17-09",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wq2000.html"
}
