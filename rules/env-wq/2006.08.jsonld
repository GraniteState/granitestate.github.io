  "definition": "Scoring Based on Opportunities for Cooperation",
  "effectiveDate": "2009-10-17",
  "historyNote": "#9570, eff 10-17-09",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-Wq 2006.08",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wq2000.html",
  "prefLabel": "Env-Wq 2006.08 Scoring Based on Opportunities for Cooperation",
  "recordType": "rule-section",
  "ruleText": "Env-Wq 2006.08 Scoring Based on Opportunities for Cooperation. Each application shall be scored on whether the project will improve opportunities for multi-entity cooperation on coastal resource planning and management efforts as follows:\n\n(a) A project that involves cooperation between 4 or more coastal stakeholders, where stakeholders are identified as any entity that is eligible to receive grant funding pursuant to Env-Wq 2003.04, shall receive 3 points;\n\n(b) A project that involves cooperation between 2 or 3 coastal stakeholders shall receive 2 points; and\n\n(c) A project that does not involve multi-entity cooperation shall receive no points.\n\nSource. #9570, eff 10-17-09",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wq2000.html"
}
