  "broader": "https://granitestate.github.io/rules/env-wq/903",
  "definition": "Application Information",
  "effectiveDate": "2017-09-01",
  "historyNote": "(See Revision Note #1 and Revision Note #2 at chapter heading for Env-Wq 900) #12364, eff 9-1-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
