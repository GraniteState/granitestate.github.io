  "definition": "Slope Protection from Channelized Flow",
  "effectiveDate": "2026-01-19",
  "expirationDate": "2036-01-19",
  "historyNote": "#13758, eff 9-28-23; ss by #14472, eff 1-19-26, EXPIRES: 1-19-36 (formerly Env-Wq 1511.07)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
