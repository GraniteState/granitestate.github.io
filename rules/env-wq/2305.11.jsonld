  "definition": "Supplemental Loan Agreement for Loans to Governmental Recipients",
  "effectiveDate": "2024-09-24",
  "historyNote": "#13858, INTERIM, eff 1-27-24, EXPIRED: 7-25-24 New. #14078, eff 9-24-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
