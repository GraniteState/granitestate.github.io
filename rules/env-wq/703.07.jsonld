  "definition": "Sewer Connection Permit",
  "effectiveDate": "2026-07-01",
  "expirationDate": "2036-07-01",
  "historyNote": "#8590, eff 3-25-06; ss by #10693, eff 10-15-14; ss by #14258, eff 7-1-25; ss by #14609, eff 7-1-26, EXPIRES: 7-1-36",
