  "definition": "Lawn Irrigation by ICI Water Users",
  "effectiveDate": "2024-06-22",
  "historyNote": "#10480-A, eff 12-3-13; ss by #14004, eff 6-22-24 (formerly Env-Wq 2101.22)",
