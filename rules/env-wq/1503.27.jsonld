  "definition": "Permit Amendment to Extend the Permit Duration",
  "effectiveDate": "2026-08-06",
  "expirationDate": "2036-08-06",
  "historyNote": "#14472, eff 1-19-26, EXPIRES: 1-19-36; ss by #14656, eff 8-6-26, EXPIRES: 8-6-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
