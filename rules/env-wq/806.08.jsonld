  "definition": "Land Application Standards",
  "effectiveDate": "2026-05-15",
  "expirationDate": "2036-05-15",
  "historyNote": "#10998, eff 1-1-16; ss by #14571, eff 5-15-26, EXPIRES: 5-15-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
