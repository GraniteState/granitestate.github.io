  "definition": "Erosion Control Methods: Vegetation",
  "effectiveDate": "2026-01-19",
  "expirationDate": "2036-01-19",
  "historyNote": "#9343, eff 1-1-09; ss by #12342, eff 8-15-17; ss by #14472, eff 1-19-26, EXPIRES: 1-19-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
