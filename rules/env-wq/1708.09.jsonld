  "broader": "https://granitestate.github.io/rules/env-wq/1708",
  "definition": "Significant or Insignificant Determination",
  "effectiveDate": "2025-02-26",
  "historyNote": "(See Revision Notes #1, #2, and #3 at chapter heading for Env-Wq 1700) #12042, eff 12-1-16; ss by #14203, eff 2-26-25",
