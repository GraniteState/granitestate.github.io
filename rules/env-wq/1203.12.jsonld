  "broader": "https://granitestate.github.io/rules/env-wq/1203",
  "definition": "Prohibited Discharges",
  "effectiveDate": "2019-03-19",
  "historyNote": "#9798-A, eff 10-9-10 (from Env-Wq 1203.09); ss by #12739, eff 3-19-19; ss by #12739, eff 3-19-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
