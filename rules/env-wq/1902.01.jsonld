  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wq1900.html",
  "prefLabel": "Env-Wq 1902.01 7Q10",
  "recordType": "rule-section",
  "ruleText": "Env-Wq 1902.01 “7Q10” means the lowest average flow rate for a period of 7 consecutive days on an annual basis with an expected recurrence interval of once in every 10 years, determined at a fixed location on a river or stream, and expressed in terms of volume per unit of time.\n\nSource. #7901, eff 5-29-03 (See Revision Note at chapter heading for Env-Wq 1900) (formerly Env-Ws 1902.01); ss by #9936, eff 5-28-11; ss by #12695, eff 12-22-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wq1900.html"
}
