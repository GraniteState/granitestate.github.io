  "definition": "Extension of the Period of Validity of a Provisional License",
  "effectiveDate": "2025-10-07",
  "expirationDate": "2035-10-07",
  "historyNote": "#10686, eff 10-7-14; ss by #14337, eff 10-7-25, EXPIRES: 10-7-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
