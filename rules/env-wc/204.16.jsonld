  "broader": "https://granitestate.github.io/rules/env-wc/204",
  "definition": "Motion for Rehearing",
  "effectiveDate": "2007-09-14",
  "historyNote": "#8977-A, eff 9-14-07 (from Env-WC 203.29)",
