  "definition": "Absence Without Authorized Leave",
  "effectiveDate": "2025-12-01",
  "expirationDate": "2035-12-01",
  "historyNote": "#8738, eff 10-18-06; ss by #10817, eff 5-17-15; ss by #14436, eff 12-1-25, EXPIRES: 12-1-35 (formerly 1201.05)",
