  "definition": "Temporary Assignment",
  "effectiveDate": "2025-12-01",
  "expirationDate": "2035-12-01",
  "historyNote": "#8738, eff 10-18-06; ss by #10817, eff 5-17-15; ss by #14433 (formerly Per 601.01), eff 12-1-25, EXPIRES 12-1-35",
