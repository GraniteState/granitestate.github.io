  "definition": "Disqualification of Applicants or Candidates",
  "effectiveDate": "2025-12-01",
  "expirationDate": "2035-12-01",
  "historyNote": "#8738, eff 10-18-06; ss by #10817, eff 5-17-15; ss by #14132-B, eff 11-27-24; ss by #14443 (formerly Per 405.02), eff 12-1-25, EXPIRES 12-1-35",
