  "definition": "Public Accounting Firm (PA Firm)",
  "effectiveDate": "2012-01-01",
  "historyNote": "#1005, eff 1-1-12 (from Ac 101.16); renumbered by #13995 (formerly Ac 102.16)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
