  "broader": "https://granitestate.github.io/rules/auc/502",
  "definition": "Conduct of Auction; Records",
  "effectiveDate": "2018-01-10",
  "historyNote": "#12201-B, eff 6-7-17; amd by #12451, eff 1-10-18",
