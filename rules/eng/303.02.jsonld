  "broader": "https://granitestate.github.io/rules/eng/303",
  "definition": "Experience Requirements",
  "effectiveDate": "2024-06-25",
  "historyNote": "#2364-a, eff 5-17-83; ss by #3031, eff 5-28-85, EXPIRED 5-28-91 New. #5397, eff 5-20-92; EXPIRED 5-20-98 New. #6911, eff 12-15-98; ss by #8190, eff 10-19-04; ss by #10045, eff 1-1-12, EXPIRED: 1-1-20 New. #13942, eff 6-25-24",
