  "broader": "https://granitestate.github.io/rules/eng/403",
  "definition": "Professional Development Hour Credits",
  "effectiveDate": "2024-03-26",
  "historyNote": "#6911, eff 12-15-98; ss by #10-19-04; ss by #10045, eff 1-1-12, EXPIRED: 1-1-22 New. #13859, eff 3-26-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
