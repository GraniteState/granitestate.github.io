  "definition": "Licensed Engineer Seal or Stamp",
  "effectiveDate": "2024-06-25",
  "historyNote": "#6911, eff 12-15-98; ss by #8190, eff 10-19-04; ss by #10045, eff 1-1-12, EXPIRED: 1-1-20 New. #13942, eff 6-25-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
