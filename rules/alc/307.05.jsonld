  "broader": "https://granitestate.github.io/rules/alc/307",
  "definition": "Supervised Work Experience Requirement",
  "effectiveDate": "2023-03-13",
  "historyNote": "#12001, eff 10-13-16; ss by #13518, eff 3-13-23 (formerly Alc 306.05)",
