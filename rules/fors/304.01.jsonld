  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fors100-500.html",
  "prefLabel": "Fors 304.01 Reciprocity",
  "priorExpiration": "1998-02-05",
  "recordType": "rule-section",
  "ruleText": "Fors 304.01 Reciprocity. Reciprocity, as required by Plc 313.26, shall be granted to licensed, certified, and registered foresters from states whose requirements, for licensure, certification, and registration are comparable to the requirements of RSA 310-A as it relates to forestry and the practice of forestry.\n\nSource. #5222, eff 9-11-91; EXPIRED 9-11-97\n\nNew. #6597, INTERIM, eff 10-8-97, EXPIRED: 2-5-98\n\nNew. #6876, eff 10-28-98; ss by #8710, eff 8-25-06; ss by #10544, eff 3-13-14; ss by #14085, eff 11-24-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fors100-500.html"
