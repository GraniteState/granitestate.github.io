  "effectiveDate": "2019-08-20",
  "historyNote": "#9857-A, eff 2-1-11, EXPIRED: 2-1-19 New. #12729, INTERIM, eff 2-21-19, EXPIRES: 8-20-19; ss by #12852, eff 8-20-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
