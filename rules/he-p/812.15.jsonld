  "broader": "https://granitestate.github.io/rules/he-p/812",
  "definition": "Duties and Responsibilities of All Licensees",
  "effectiveDate": "2024-08-06",
  "historyNote": "#9727-A, eff 6-18-10, EXPIRED: 6-18-18 New. #12557, INTERIM, eff 6-26-18, EXPIRED: 12-24-18 New. #12926, eff 11-26-19; ss by #14042, eff 8-6-24 24 (formerly He-P 812.14)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
