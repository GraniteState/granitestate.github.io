  "definition": "Surgical Services",
  "effectiveDate": "2024-09-25",
  "expirationDate": "2034-09-25",
  "historyNote": "#9580, eff 10-24-09; ss by #12407, INTERIM, eff 10-24-17, EXPIRED: 4-22-18 New. #13166, eff 1-28-21 (formerly He-P 802.30); ss by #14081, eff 9-25-24, EXPIRES: 9-25-34 (formerly He-P 802.33)",
