  "broader": "https://granitestate.github.io/rules/he-p/1612",
  "definition": "Initial License or Certificate Application Requirements",
  "effectiveDate": "2026-08-26",
  "expirationDate": "2036-08-26",
  "historyNote": "#8932, eff 7-6-07; ss by #9986, eff 9-1-11, EXPIRED: 9-1-19 New. #13052, eff 6-11-20; ss by #14230, eff 4-2-25; ss by #14680, eff 8-26-26, EXPIRES: 8-26-36",
