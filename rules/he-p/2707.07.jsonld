  "definition": "Evaluation and Inspection of Bulk Milk Haulers",
  "effectiveDate": "2021-03-02",
  "historyNote": "#12631, INTERIM, eff 9-28-18, EXPIRES: 3-27-19; ss by #12743, eff 3-20-19; ss by #13175, eff 3-2-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
