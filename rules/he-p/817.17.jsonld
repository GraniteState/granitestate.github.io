  "broader": "https://granitestate.github.io/rules/he-p/817",
  "definition": "Personnel",
  "effectiveDate": "2015-11-20",
  "historyNote": "#5775, eff 1-24-94, EXPIRED: 1-24-00 New. #8410 eff 8-19-05; ss by #8853, eff 3-24-07, EXPIRED: 3-24-15 New. #10830, INTERIM, eff 5-25-15, EXPIRES: 11-21-15; ss by #10979, eff 11-20-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
