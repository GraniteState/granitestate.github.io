  "definition": "General License for Certain Items and Self-luminous Products Containing Radium-226",
  "effectiveDate": "2016-10-12",
  "historyNote": "#11198, eff 10-12-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
