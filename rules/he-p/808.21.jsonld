  "broader": "https://granitestate.github.io/rules/he-p/808",
  "definition": "Mobile Laboratory Vans",
  "effectiveDate": "2023-08-02",
  "historyNote": "#8852, eff 3-24-07; ss by #10267, eff 2-2-13; ss by #13710, eff 8-2-23",
