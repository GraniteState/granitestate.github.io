  "definition": "Infection Control",
  "effectiveDate": "2021-04-24",
  "historyNote": "#10059, eff 12-23-11; ss by #12952, INTERIM, eff 12-21-19, EXPIRED: 6-18-20 New. #13195, eff 4-24-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
