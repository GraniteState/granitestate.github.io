  "broader": "https://granitestate.github.io/rules/he-p/812",
  "definition": "Notice to Critical Access Hospitals",
  "effectiveDate": "2024-08-06",
  "historyNote": "#5514, eff 11-25-92; amd by #6530, eff 6-27-97; amd by #6895, INTERIM, eff 11-26-98, EXPIRED: 3-26-99; paragraph (e) EXPIRED: 6-27-05 New. #9727-B, eff 6-18-10; ss by #12557, INTERIM, ,eff 6-26-18, EXPIRES: 12-24-18 New. #12926, eff 11-26-19; ss by #14042, eff 8-6-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
