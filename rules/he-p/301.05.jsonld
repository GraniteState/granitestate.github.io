  "broader": "https://granitestate.github.io/rules/he-p/301",
  "definition": "Restriction and Control Measures for Isolation and Quarantine for Specific Diseases",
  "effectiveDate": "2016-11-03",
  "historyNote": "#2017, eff 5-10-82; ss by #3172, eff 1-2-86; ss by #4230, eff 2-23-87; ss by #4946, eff 10-2-90; EXPIRED: 10-2-96 New. #6634, eff 11-25-97; ss by #8242, eff 12-30-04; ss by #9172, eff 6-6-08; ss by #12033, eff 11-3-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
