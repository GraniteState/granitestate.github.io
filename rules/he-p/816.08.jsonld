  "definition": "EHC Requirements for Organizational Changes",
  "effectiveDate": "2017-06-02",
  "historyNote": "#5516, eff 11-25-92; ss by #5984, eff 2-4-95; ss by #6895, INTERIM, eff 11-26-98, EXPIRED: 3-26-99 New. #9193, eff 6-26-08, EXPIRED: 6-26-16 New. #11199, INTERIM, eff 10-14-16, EXPIRED: 4-12-17 New. #12197, eff 6-2-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
