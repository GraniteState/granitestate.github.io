  "definition": "Duties and Responsibilities of All Licensees",
  "effectiveDate": "2019-01-03",
  "historyNote": "#9522, eff 7-25-09, EXPIRED: 7-25-17 New. #12504, INTERIM, eff 3-24-18, EXPIRED: 9-20-18 New. #12702, eff 1-3-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
