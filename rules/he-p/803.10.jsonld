  "definition": "Waivers",
  "effectiveDate": "2019-08-28",
  "historyNote": "#9856-A, eff 1-26-11, EXPIRED: 1-26-19 New. #12721, INTERIM, eff 1-29-19, EXPIRED: 7-29-19 New. #12860, eff 8-28-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
