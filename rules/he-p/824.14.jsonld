  "definition": "Duties and Responsibilities of All Licensees",
  "effectiveDate": "2023-03-01",
  "historyNote": "#9317, eff 11-8-08, EXPIRED: 11-8-16 New. #12169, INTERIM, eff 4-29-17, EXPIRED: 10-26-17 New. #13572, eff 3-1-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
