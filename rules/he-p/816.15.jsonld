  "broader": "https://granitestate.github.io/rules/he-p/816",
  "definition": "Required Health Care Services",
  "effectiveDate": "2017-06-02",
  "historyNote": "#9193, eff 6-26-08; ss by #9565, eff 10-16-09; ss by #12197, eff 6-2-17",
