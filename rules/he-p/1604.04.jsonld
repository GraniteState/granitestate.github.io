  "broader": "https://granitestate.github.io/rules/he-p/1604",
  "definition": "Lead Investigation Records",
  "effectiveDate": "2025-04-02",
  "historyNote": "#9986, eff 9-1-11 (from He-P 1612.03), EXPIRED: 9-1-19 New. #13052, eff 6-11-20; ss by #14230, eff 4-2-25",
