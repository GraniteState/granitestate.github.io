  "broader": "https://granitestate.github.io/rules/he-p/4047",
  "definition": "General Administrative Requirements for Facilities Using Therapeutic Radiation Machines",
  "effectiveDate": "2026-05-22",
  "expirationDate": "2026-11-18",
  "historyNote": "#6827, eff 8-6-98; ss by #8692, INTERIM, eff 7-27-06, EXPIRES: 2-2-07; ss by #8808, eff 1-24-07; ss by #10764, INTERIM, eff 1-23-15, EXPIRES: 7-22-15; ss by #10894, eff 7-21-15 New. #14598, INTERIM, eff 5-22-26, EXPIRES: 11-18-26",
