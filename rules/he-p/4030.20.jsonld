  "broader": "https://granitestate.github.io/rules/he-p/4030",
  "definition": "Conditions of Licenses to Initially Transfer Source Material for Use Under the ‘Small Quantities of Source Material’ General License: Quality Control, Labeling,",
  "effectiveDate": "2020-06-02",
  "historyNote": "#13047, eff 6-2-20",
