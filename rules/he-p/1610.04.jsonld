  "definition": "Chewable Surfaces",
  "effectiveDate": "2025-04-02",
  "historyNote": "#5920, eff 1-1-95; ss by #7181, eff 12-24-99; ss by #7495, eff 5-23-01; ss by #8039, eff 2-13-04; ss by #8932, eff 7-6-07; ss by #9986, eff 9-1-11, EXPIRED: 9-1-11 (from He-P 1606.05) New. #13052, eff 6-11-20; ss by #14230, eff 4-2-25",
  "inScheme": "https://granitestate.github.io/rules/scheme",
