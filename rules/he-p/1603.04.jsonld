  "broader": "https://granitestate.github.io/rules/he-p/1603",
  "definition": "Election Not to Participate in Blood Lead Level Testing",
  "effectiveDate": "2026-08-26",
  "expirationDate": "2036-08-26",
  "historyNote": "#13052, eff 6-11-20; ss by #14230, eff 4-2-25; ss by #14680, eff 8-26-26, EXPIRES: 8-26-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
