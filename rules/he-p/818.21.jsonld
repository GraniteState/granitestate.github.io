  "definition": "Infection Control",
  "effectiveDate": "2017-06-02",
  "historyNote": "#9106, eff 3-18-08, EXPIRED: 3-18-16 New. #12006, INTERIM, eff 10-15-16, EXPIRED: 4-13-17 New. #12198, eff 6-2-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
