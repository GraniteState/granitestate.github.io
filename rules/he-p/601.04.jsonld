  "definition": "Personal Care Services",
  "effectiveDate": "2020-10-01",
  "historyNote": "(See Revision Notes # 1 and #2 at chapter heading for He-P 600) #9898-A, eff 3-29-11, EXPIRED: 3-29-19 New. #13115, eff 10-1-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
