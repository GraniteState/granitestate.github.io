  "broader": "https://granitestate.github.io/rules/he-p/1606",
  "definition": "Administrative Fines",
  "effectiveDate": "2026-08-26",
  "expirationDate": "2036-08-26",
  "historyNote": "#5920, eff 1-1-95; amd by #6096, eff 9-22-95; ss by #7181, eff 12-24-99; ss by #7495, eff 5-23-01; ss by #8039, eff 2-13-04; ss by #8932, eff 7-6-07; ss by #9986, eff 9-1-11; ss by #11007, eff 12-23-15; ss by #13052 (formerly He-P 1606.01); ss by #14230, eff 4-2-25; ss by #14680, eff 8-26-26, EXPIRES: 8-26-36",
