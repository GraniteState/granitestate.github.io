  "definition": "Payment Rates and Levels for Recipients with Other Catastrophic Illnesses",
  "effectiveDate": "2007-04-13",
  "historyNote": "#4167, eff 11-6-86; ss by #4638, eff 6-26-89, EXPIRED: 6-26-95 New. #8864, eff 4-13-07",
  "inScheme": "https://granitestate.github.io/rules/scheme",
