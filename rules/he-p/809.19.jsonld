  "effectiveDate": "2018-10-03",
  "historyNote": "#9466, eff 5-2-09; ss by #12167, INTERIM, eff 4-29-17, EXPIRED: 10-26-17 New. #12640, eff 10-3-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
