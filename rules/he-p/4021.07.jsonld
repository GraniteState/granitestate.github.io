  "broader": "https://granitestate.github.io/rules/he-p/4021",
  "definition": "Records of Individual Monitoring Results",
  "effectiveDate": "2024-10-01",
  "historyNote": "#5903, eff 2-1-95; ss by #6827, eff 8-6-98; ss by #8481, eff 11-5-05; ss by #10604, eff 5-23-14; ss by #14091, eff 10-1-24",
