  "broader": "https://granitestate.github.io/rules/he-p/1610",
  "definition": "Contaminated Bare Soil",
  "effectiveDate": "2025-04-02",
  "historyNote": "#9986, eff 9-1-11, EXPIRED: 9-1-19 (from He-P 1606.06) New. #13052, eff 6-11-20; ss by #14230, eff 4-2-25",
  "inScheme": "https://granitestate.github.io/rules/scheme",
