  "definition": "Rehabilitation Hospital",
  "effectiveDate": "2024-09-25",
  "expirationDate": "2034-09-25",
  "historyNote": "#13166, eff 1-28-21 (formerly He-P 802.34); ss by #14081, eff 9-25-24, EXPIRES: 9-25-34 (formerly He-P 802.37)",
