  "definition": "License and Certificate Expirations and Procedures for Renewals",
  "effectiveDate": "2026-08-26",
  "expirationDate": "2036-08-26",
  "historyNote": "#9986, eff 9-1-11, EXPIRED: 9-1-19 New. #13052, eff 6-11-20; ss by #14230, eff 4-2-25; ss by #14680, eff 8-26-26, EXPIRES: 8-26-36",
