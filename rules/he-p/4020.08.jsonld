  "broader": "https://granitestate.github.io/rules/he-p/4020",
  "definition": "Determination of Internal Exposure",
  "effectiveDate": "2024-07-23",
  "historyNote": "#5903, eff 2-1-95; ss by #6827, eff 8-6-98; ss by #8481, eff 11-5-05; ss by #10604, eff 5-23-14; ss by #13371, eff 4-20-22; ss by #14028, eff 7-23-24",
