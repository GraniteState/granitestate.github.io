  "broader": "https://granitestate.github.io/rules/he-p/4040",
  "definition": "Shielding Plan Review",
  "effectiveDate": "2015-06-25",
  "historyNote": "#6827, eff 8-6-98; ss by #7919, eff 7-18-03; ss by #9945-A, eff 6-22-11; ss by #10864, eff 6-25-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
