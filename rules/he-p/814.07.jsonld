  "effectiveDate": "2017-09-01",
  "historyNote": "#9288, eff 10-3-08, EXPIRED: 10-3-16 New. #12048, INTERIM, eff 11-19-16, EXPIRED: 5-18-17 New. #12374, eff 9-1-17",
