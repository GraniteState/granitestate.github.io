  "definition": "Food Services",
  "effectiveDate": "2017-11-03",
  "historyNote": "#9121, eff 4-3-08, EXPIRED: 4-3-16 New. #12047, INTERIM, eff 11-19-16, EXPIRED: 5-18-17 New. #12414, eff 11-3-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
