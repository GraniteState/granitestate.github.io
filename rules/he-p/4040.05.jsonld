  "definition": "Disposal of or Change of Ownership of a Radiation or MRI Machine",
  "effectiveDate": "2015-06-25",
  "historyNote": "#10864, eff 6-25-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
