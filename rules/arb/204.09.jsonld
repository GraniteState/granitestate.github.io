  "definition": "Reopening of Cases",
  "effectiveDate": "2007-09-28",
  "historyNote": "#6994, eff 5-7-99; ss by #7188, eff 1-5-00; ss by 8996, eff 9-28-07",
  "inScheme": "https://granitestate.github.io/rules/scheme",
