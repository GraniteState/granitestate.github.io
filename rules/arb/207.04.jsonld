  "broader": "https://granitestate.github.io/rules/arb/207",
  "definition": "Limitations on Public Participation",
  "effectiveDate": "2008-03-27",
  "historyNote": "#9116-A, eff 3-27-08",
  "inScheme": "https://granitestate.github.io/rules/scheme",
