  "broader": "https://granitestate.github.io/rules/he-c/6447",
  "definition": "License Renewal",
  "effectiveDate": "2025-09-24",
  "expirationDate": "2035-09-24",
  "historyNote": "#14390, eff 9-24-25, EXPIRES: 9-24-35",
