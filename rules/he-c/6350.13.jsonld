  "definition": "Treatment Planning Process",
  "effectiveDate": "1997-10-25",
  "historyNote": "#6617, eff 10-25-97; ss by #8453, INTERIM, eff",
  "inScheme": "https://granitestate.github.io/rules/scheme",
