  "broader": "https://granitestate.github.io/rules/he-c/6420",
  "definition": "Qualifications for Providers of Covered Services",
  "effectiveDate": "2015-11-26",
  "historyNote": "#5804, eff 3-28-94, EXPIRED: 3-28-00 New. #9028, eff 11-17-07; ss by #10986, eff 11-26-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
