  "definition": "Billing Requirements for Providers of Health Care and Laboratory Services",
  "effectiveDate": "2017-03-10",
  "historyNote": "(See Revision Note at part heading for He-C 6348) #9267, eff 9-20-08; ss by #12127, eff 3-10-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
