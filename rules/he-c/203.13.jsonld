  "broader": "https://granitestate.github.io/rules/he-c/203",
  "definition": "Hearing Participation by Telephone or Other Electronic Media",
  "effectiveDate": "2007-04-13",
  "historyNote": "#8866-A, eff 4-13-07",
  "inScheme": "https://granitestate.github.io/rules/scheme",
