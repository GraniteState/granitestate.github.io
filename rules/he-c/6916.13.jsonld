  "broader": "https://granitestate.github.io/rules/he-c/6916",
  "definition": "Prevention, Recognition, and Reporting of Child Abuse and Neglect",
  "effectiveDate": "2023-05-25",
  "historyNote": "#12536, eff 5-24-18; ss by #13650, eff 5-25-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
