  "effectiveDate": "2017-09-20",
  "historyNote": "#12385, eff 9-20-17; (formerly Saf-Mec 610.01) (see Revision Note at chapter heading for Mec 600)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
