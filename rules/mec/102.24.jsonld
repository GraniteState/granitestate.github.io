  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/mec100.html",
  "prefLabel": "Mec 102.24 Sponsor",
  "recordType": "rule-section",
  "ruleText": "Mec 102.24 “Sponsor” means any person, association, committee, or organization that operates an apprenticeship program and in whose name the program is registered and assumes full responsibility for administration and operation of the apprenticeship program meeting the requirements in RSA 278, and 29 CFR, Part 29 and 30.\n\nSource. #13483, eff 1-9-23; #14408, eff 10-17-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/mec100.html"
}
