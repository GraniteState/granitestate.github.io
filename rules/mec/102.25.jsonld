  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/mec100.html",
  "prefLabel": "Mec 102.25 Supervision",
  "recordType": "rule-section",
  "ruleText": "Mec 102.25 “ Supervision” means regular, on-site supervision, remote electronic video, or audio supervision by a person licensed by the board who has professional knowledge of the trade being performed and the supervisor is able to respond immediately to the needs of the supervisee or employee.\n\nSource. #13483, eff 1-9-23; #14408, eff 10-17-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/mec100.html"
}
