  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/mec100.html",
  "prefLabel": "Mec 102.02 Apprenticeship agreement",
  "recordType": "rule-section",
  "ruleText": "Mec 102.02 “Apprenticeship agreement” means a written agreement between the apprentice and the sponsor setting forth the responsibilities and obligations of all parties to the apprenticeship agreement with respect to the apprentice’s employment and training under the standards of apprenticeship in 29 CFR, Part 29 and 30, revised September 26, 2022 and August 21, 2020 respectively.\n\nSource. #13483, eff 1-9-23 (see Revision Note at chapter heading for Mec 100); #14408, eff 10-17-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/mec100.html"
