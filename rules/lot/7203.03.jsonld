  "expirationDate": "2036-02-04",
  "historyNote": "#12839, eff 7-27-19; ss by #14341, EMERGENCY, eff 8-21-25 (formerly Lot 7203.01); ss by #14503, eff 2-4-26, EXPIRES: 2-4-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
