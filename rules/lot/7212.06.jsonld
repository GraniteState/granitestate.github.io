  "definition": "Distribution of Gaming Revenue",
  "effectiveDate": "2026-02-04",
  "expirationDate": "2036-02-04",
  "historyNote": "#14341 EMERGENCY, eff 8-21-25; ss by #14503, eff 2-4-26, EXPIRES: 2-4-36 (formerly Lot 7211.04)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
