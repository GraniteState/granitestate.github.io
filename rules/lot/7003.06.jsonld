  "definition": "Licensing Exemptions for Private Campgrounds, Hotels, and Senior Citizen Organizations",
  "effectiveDate": "2024-11-27",
  "expirationDate": "2034-11-27",
  "historyNote": "#13067, eff 6-26-20; ss by #14138, eff 11-27-24, EXPIRES: 11-27-34",
  "inScheme": "https://granitestate.github.io/rules/scheme",
