  "broader": "https://granitestate.github.io/rules/lot/3003",
  "definition": "Payment of Winning Wagers",
  "effectiveDate": "2020-05-09",
  "historyNote": "#13041, eff 5-9-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Lot 3003.03",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/lot3000.html",
  "prefLabel": "Lot 3003.03 Payment of Winning Wagers",
  "recordType": "rule-section",
  "ruleText": "Lot 3003.03 Payment of Winning Wagers.\n\n(a) Payment on a winning wager shall only be made to the person who presents the betting ticket with the winning wager or directly through a player’s wagering account when the wagering system determines that the player had a winning wager.\n\n(b) An agent shall not make payment on a winning wager to a person who the agent or employee of the agent knows or reasonably should know is collecting the payment on behalf of another for monetary consideration or in violation of federal law or these rules.\n\n(c) An agent may withhold payment of a winning wager if the patron refuses to supply identification or any other documentation required by state or federal law.\n\n(d) Winning wagers shall be void one year from the date of the conclusion of the event, or the conclusion of the last event on a multi-event wager.\n\nSource. #13041, eff 5-9-20",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/lot3000.html"
}
