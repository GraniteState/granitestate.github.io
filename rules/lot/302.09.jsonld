  "broader": "https://granitestate.github.io/rules/lot/302",
  "definition": "Responsibilities of Lottery Retailer Licensees",
  "effectiveDate": "2026-01-07",
  "expirationDate": "2036-01-07",
  "historyNote": "#14474, eff 1-7-26, EXPIRES 1-7-36",
