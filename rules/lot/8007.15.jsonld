  "definition": "Fire Protection",
  "effectiveDate": "2018-06-01",
  "historyNote": "(See Revision Note at chapter heading for Lot 8000) #12544, eff 6-1-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
