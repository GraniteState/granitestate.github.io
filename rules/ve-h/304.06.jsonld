  "definition": "Spousal Hardship",
  "effectiveDate": "2019-01-15",
  "historyNote": "#8953, eff 7-21-07, EXPIRED: 7-21-15 New. #12564, INTERIM, eff 6-28-18, EXPIRED: 12-26-18 New. #12712, eff 1-15-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
