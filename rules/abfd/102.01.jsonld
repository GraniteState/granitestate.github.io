  "notation": "Abfd 102.01",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/abfd100-300.html",
  "prefLabel": "Abfd 102.01 Architectural barriers",
  "priorExpiration": "2000-06-29",
  "recordType": "rule-section",
  "ruleText": "Abfd 102.01 \"Architectural barriers\" means \"architectural barriers\" as defined in RSA 275-C:10, I, namely, \"physical attributes of buildings and facilities which by their presence, absence, or design present unsafe conditions or deter access and free mobility for persons with disabilities in and around buildings and facilities\".\n\nSource. (See Revision Note at chapter heading for Abfd 100) #5720, eff 1-1-94, EXPIRED: 1-1-00\n\nNew. #7211, INTERIM, eff 3-1-00, EXPIRED: 6-29-00\n\nNew. #7367, eff 9-27-00; ss by #7473, eff 4-5-01",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/abfd100-300.html"
