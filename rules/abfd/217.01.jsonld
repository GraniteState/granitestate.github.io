  "effectiveDate": "2013-03-05",
  "historyNote": "#7770, eff 10-2-02, EXPIRED: 10-2-10 New. #10118, INTERIM, eff 4-20-12, EXPIRES: 10-17-12 New. #10284-A, eff 3-5-13",
