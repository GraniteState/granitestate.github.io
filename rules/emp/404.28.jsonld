  "definition": "On-the-job Training",
  "effectiveDate": "2020-07-22",
  "historyNote": "#12960, INTERIM, eff 12-26-19, EXPIRED: 6-23-20 New. #13074, eff 7-22-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
