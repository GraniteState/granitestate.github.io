  "broader": "https://granitestate.github.io/rules/emp/404",
  "definition": "Employment Support Services",
  "effectiveDate": "2024-02-23",
  "historyNote": "#12960, INTERIM, eff 12-26-19, EXPIRED: 6-23-20 New. #13074, eff 7-22-20; ss by #13348, eff 3-3-22; ss by #13892, eff 2-23-24",
