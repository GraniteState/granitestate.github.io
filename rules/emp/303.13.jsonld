  "broader": "https://granitestate.github.io/rules/emp/303",
  "definition": "Mass Layoffs",
  "effectiveDate": "2025-07-15",
  "expirationDate": "2035-07-15",
  "historyNote": "#8558, INTERIM, eff 1-31-06, EXPIRED: 7-30-06; ss by #8675, eff 7-8-06; renumbered by #10081 (formerly Emp 302.13); ss by #10673, eff 9-22-14; ss by #14315, eff 7-15-25, EXPIRES: 7-15-35",
