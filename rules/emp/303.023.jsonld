  "definition": "Making Corrections to Tax and Wage Information Previously Reported",
  "effectiveDate": "2023-07-03",
  "historyNote": "#10349, eff 5-22-13; ss by #13681, eff 7-3-23 (see Revision Note at chapter heading for Emp 300)",
