  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html",
  "prefLabel": "Emp 404.01 Purpose",
  "priorExpiration": "2020-06-23",
  "recordType": "rule-section",
  "ruleText": "Emp 404.01 Purpose. The job training program (JTP) is established to enhance public-private partnerships to recruit, train, and re-employ workers in order to meet New Hampshire's skills gap and worker shortage, by efficiently and timely assisting New Hampshire businesses and residents looking for work, including those in recovery.\n\nSource. #7765, eff 9-27-02; ss by #8989, eff 9-22-07, EXPIRES: 3-20-08; ss by #9092, eff 2-23-08, EXPIRED: 2-23-16\n\nNew. #12960, INTERIM, eff 12-26-19, EXPIRED: 6-23-20\n\nNew. #13074, eff 7-22-20",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html"
