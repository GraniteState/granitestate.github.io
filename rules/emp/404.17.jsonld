  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html",
  "prefLabel": "Emp 404.17 Notification",
  "priorExpiration": "2020-06-23",
  "recordType": "rule-section",
  "ruleText": "Emp 404.17 Notification.\n\n(a) If the commissioner approves an application, the department shall notify the applicant within 7 business days of the application having been approved.\n\n(b) If the commissioner does not approve an application, the department shall notify the applicant in writing of the specific reason(s) for the commissioner's denial.\n\nSource. #12960, INTERIM, eff 12-26-19, EXPIRED: 6-23-20\n\nNew. #13074, eff 7-22-20",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html"
