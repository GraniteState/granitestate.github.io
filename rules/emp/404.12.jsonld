  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html",
  "prefLabel": "Emp 404.12 WorkInvestNH Grant Limitations",
  "priorExpiration": "2020-06-23",
  "recordType": "rule-section",
  "ruleText": "Emp 404.12 WorkInvestNH Grant Limitations.\n\n(a) Any single grant or multiple grants to any single employer in any grant year exceeding $70,000 shall first be approved by governor and council.\n\n(b) An entity may apply for more than one grant each fiscal year.\n\n(c) No new application shall be approved until that entity’s previous grants have been completed.\n\nSource. #12960, INTERIM, eff 12-26-19, EXPIRED: 6-23-20\n\nNew. #13074, eff 7-22-20; ss by #13892, eff 2-23-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html"
}
