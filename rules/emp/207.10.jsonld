  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html",
  "prefLabel": "Emp 207.10 Computation of Time",
  "priorExpiration": "2008-10-17",
  "recordType": "rule-section",
  "ruleText": "Emp 207.10 Computation of Time.\n\n(a) Unless otherwise specified, all time periods shall be calendar days.\n\n(b) Computation of any period of time referred to in these rules shall begin with the day after the action which sets the time period in motion, and shall include the last day of the period so computed.\n\nSource. #7246, eff 4-30-00; ss by #9126, INTERIM, eff 4-20-08, EXPIRES: 10-17-08; ss by #9296, eff 10-17-08",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/emp100-500.html"
