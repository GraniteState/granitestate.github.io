  "definition": "Withdrawal of Presiding Officer or Department Official",
  "effectiveDate": "2008-10-17",
  "historyNote": "#7246, eff 4-30-00; ss by #9126, INTERIM, eff 4-20-08, EXPIRES: 10-17-08; ss by #9296, eff 10-17-08",
  "inScheme": "https://granitestate.github.io/rules/scheme",
