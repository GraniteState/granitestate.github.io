  "definition": "Procedure for Emergency Suspension of Licenses and Certifications",
  "effectiveDate": "2010-12-15",
  "historyNote": "#7232, eff 4-15-00; ss by #8078, eff 5-1-04; ss by #9833, eff 12-15-10",
  "inScheme": "https://granitestate.github.io/rules/scheme",
