  "broader": "https://granitestate.github.io/rules/ahp/601",
  "definition": "Certification on Application Forms",
  "effectiveDate": "2019-08-13",
  "historyNote": "#12725, eff 2-15-19; ss by #12846, eff 8-13-19 (formerly Ahp 601.04)",
