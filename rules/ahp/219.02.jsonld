  "definition": "Effectiveness of Submission of Statement of Voluntary Surrender",
  "effectiveDate": "2012-06-07",
  "historyNote": "#8079, eff 5-1-04, EXPIRED: 5-1-12 New. #10143-B, eff 6-7-12",
  "inScheme": "https://granitestate.github.io/rules/scheme",
