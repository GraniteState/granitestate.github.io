  "definition": "Limitation on the Number of Speech-Language Assistants Under Supervision",
  "effectiveDate": "2018-03-01",
  "historyNote": "#9711, eff 5-8-10; ss by #11138, eff 7-9-16; ss by #12486, eff 3-1-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
