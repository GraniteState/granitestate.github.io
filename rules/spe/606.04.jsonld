  "definition": "Reinstatement of Certifications Lapsed For Longer Than Two Years",
  "effectiveDate": "2015-07-09",
  "historyNote": "#9711, eff 5-8-10; ss by #10684, eff 10-4-14; ss by #10878, eff 7-9-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
