  "broader": "https://granitestate.github.io/rules/spe/402",
  "definition": "Licensure Renewal Application Form",
  "effectiveDate": "2015-08-07",
  "historyNote": "#9385, eff 2-7-09; ss by #10020, eff 11-5-11; ss by #10327, eff 5-4-13; ss by #10683, eff 10-4-14; amd by #10907, eff 8-7-15",
