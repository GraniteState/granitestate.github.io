  "definition": "Journal Study",
  "effectiveDate": "2016-09-17",
  "historyNote": "#9385, eff 2-7-09; ss by #9709, eff 5-8-10; ss by #11178, eff 9-17-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
