  "broader": "https://granitestate.github.io/rules/spe/405",
  "definition": "Teaching a Course Related to Speech-Language Pathology",
  "effectiveDate": "2016-09-17",
  "historyNote": "#9385, eff 2-7-09; ss by #11178, eff 9-17-16",
