  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/gal300.html",
  "prefLabel": "Gal 301.07 Related educational experience",
  "priorExpiration": "2016-10-15",
  "recordType": "rule-section",
  "ruleText": "Gal 301.07 “Related educational experience” means experience in teaching a course, attending and completing a course, participating as a panelist or speaker in a symposium, attending a symposium, [or] authoring books or articles in a professional journal relating to guardians ad litem or their duties, or attending or instructing classes, symposia, seminars, or training sessions relating to child development or family dynamics.\n\nSource. #8101, eff 1-1-05; ss by #8942, eff 9-15-07, EXPIRED: 9-15-15\n\nNew. #11075, INTERIM, eff 4-18-16, EXPIRES: 10-15-16\n\nNew. #12010, eff 10-21-16",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/gal300.html"
