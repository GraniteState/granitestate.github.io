  "definition": "Length of Suspensions and Amount of Fine",
  "effectiveDate": "2016-10-21",
  "historyNote": "#8942, eff 9-15-07, EXPIRED: 9-15-15 New. #11075, INTERIM, eff 4-18-16, EXPIRED: 10-15-16 New. #12010, eff 10-21-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
