  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/gal500.html",
  "prefLabel": "Gal 502.08 Publicly-funded case",
  "priorExpiration": "2016-10-15",
  "recordType": "rule-section",
  "ruleText": "Gal 502.08 “Publicly-funded case” means a case in which the costs or expenses of one or more of the parties are paid by the state, or any political subdivision of the state, whether or not those costs or expenses are subsequently reimbursed.\n\nSource. #8941, eff 9-15-07, EXPIRED: 9-15-15\n\nNew. #11075, INTERIM, eff 4-18-16, EXPIRED: 10-15-16\n\nNew. #12010, eff 10-21-16",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/gal500.html"
}
