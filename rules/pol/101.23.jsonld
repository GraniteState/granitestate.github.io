  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/pol100-800.html",
  "prefLabel": "Pol 101.23 Felony",
  "recordType": "rule-section",
  "ruleText": "Pol 101.23 \"Felony\" means a crime classified by the State of New Hampshire as a felony at the time the crime was committed, or an equivalent crime in any other jurisdiction whether civilian or military, if the crime has elements similar to those of a felony under NH law at the time the offense was committed.\n\nSource. #5836, eff 6-15-94; ss by #7301, eff 6-8-00",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/pol100-800.html"
