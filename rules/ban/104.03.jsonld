  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ban100.html",
  "prefLabel": "Ban 104.03 Requests for New Hampshire Banking Department Records",
  "recordType": "rule-section",
  "ruleText": "Ban 104.03 Requests for New Hampshire Banking Department Records.\n\n(a) Persons seeking department records shall request the information in a manner that would give the department notice with reasonable specificity of what records the requestor is seeking.\n\n(b) A request for department records may be delivered to the department:\n\n(1) In person;\n\n(2) By U.S. mail or courier service to the department’s office; or\n\n(3) By email to legal@banking.nh.gov.",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/ban100.html"
}
