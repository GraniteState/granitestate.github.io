  "definition": "Storage and Disposal of Medications",
  "effectiveDate": "2017-05-26",
  "historyNote": "#7957, eff 9-19-03; ss by #9978, INTERIM, eff 9-19-11, EXPIRED: 3-19-12 New. #12192, eff 5-26-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
