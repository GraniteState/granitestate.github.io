  "broader": "https://granitestate.github.io/rules/he-m/524",
  "definition": "Funding and Payment",
  "effectiveDate": "2022-06-18",
  "historyNote": "#13397, eff 6-18-22 (formerly He-M 524.14)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
