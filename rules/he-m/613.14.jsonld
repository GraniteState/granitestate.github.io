  "definition": "Discharge of Minors from NHH Following An IEA",
  "effectiveDate": "2016-09-20",
  "historyNote": "#7050, eff 6-29-99, EXPIRED: 6-29-07 New. #9191, eff 6-26-08; ss by #11183, eff 9-20-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
