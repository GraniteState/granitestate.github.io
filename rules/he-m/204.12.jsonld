  "definition": "Appeals",
  "effectiveDate": "2019-09-25",
  "historyNote": "#9850, eff 1-20-11, EXPIRED: 1-20-19 New. #12731, INTERIM RULE, eff 2-22-19, EXPIRED: 8-21-19 New. #12878, eff 9-25-19",
