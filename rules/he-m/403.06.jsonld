  "definition": "CMHP Services and Programs",
  "effectiveDate": "2018-04-03",
  "historyNote": "#4195, eff 1-1-87, EXPIRED: 1-1-93 New. #6816, eff 7-25-98, EXPIRED: 7-25-06 New. #8716, INTERIM, eff 9-6-06, EXPIRED: 3-5-07 New. #9533, eff 9-1-09, EXPIRED: 9-1-17 New. #12388, INTERIM, eff 9-23-17, EXPIRED: 3-22-18 New. #12522, eff 4-3-18",
