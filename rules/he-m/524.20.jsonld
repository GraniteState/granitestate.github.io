  "definition": "In-Home Supports Service Agreement",
  "effectiveDate": "2022-06-18",
  "historyNote": "#13397, eff 6-18-22 (formerly He-M 524.08)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
