  "definition": "Waivers",
  "effectiveDate": "2024-08-01",
  "historyNote": "#6645, eff 12-2-97, EXPIRED: 12-2-05 New. #8604, eff 4-11-06; ss by #10528, eff 3-1-14; ss by #14039, eff 8-1-24",
