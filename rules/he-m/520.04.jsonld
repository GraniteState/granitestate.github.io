  "historyNote": "#9748-A, eff 7-1-10; ss by #12558, INTERIM, eff 6-26-18, EXPIRED: 12-24-18 New. #12699, eff 12-28-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
