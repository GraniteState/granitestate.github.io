  "broader": "https://granitestate.github.io/rules/he-m/614",
  "definition": "Criteria for Involuntary Emergency Admission",
  "effectiveDate": "2022-10-06",
  "historyNote": "#13350, EMERGENCY RULE, eff 3-16-22, EXPIRED: 9-12-22 New. #13456, eff 10-6-22",
