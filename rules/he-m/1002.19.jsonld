  "historyNote": "#9894-B, eff 3-25-11; ss by #12742, INTERIM, eff 3-20-19, EXPIRED: 9-16-19 New. #12916, eff 11-16-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
