  "definition": "Corrective Action Plan",
  "effectiveDate": "2008-01-30",
  "historyNote": "#7058, eff 7-21-99; ss by #8902, INTERIM, eff 7-13-07, EXPIRED: 1-9-08 New. #9082, eff 1-30-08",
  "inScheme": "https://granitestate.github.io/rules/scheme",
