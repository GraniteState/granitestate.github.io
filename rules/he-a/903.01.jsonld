  "effectiveDate": "2009-10-23",
  "expirationDate": "2010-04-21",
  "historyNote": "#5252, eff 10-22-91, EXPIRED: 10-22-97 New. #7058, eff 7-21-99; amd by #7209, eff 2-26-00; amd by #7320, eff 7-22-00; ss by #8902, INTERIM, eff 7-13-07, EXPIRED: 1-9-08 New. #9082, eff 1-30-08; amd by #9578, EMERGENCY RULE, eff 10-23-09, EXPIRES: 4-21-10",
