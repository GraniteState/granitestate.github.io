  "broader": "https://granitestate.github.io/rules/hcp/404",
  "definition": "Revocation",
  "effectiveDate": "2017-02-21",
  "historyNote": "#9338, eff 12-3-08; ss by #12112, eff 2-21-17 (from Hcp 402.02)",
