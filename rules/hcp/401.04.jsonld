  "definition": "Application for Restoration of Audiologist License",
  "effectiveDate": "2017-02-21",
  "historyNote": "#6935, eff 1-29-99, EXPIRED: 1-29-07 New. #9338, eff 12-3-08; ss by #12112, eff 2-21-17",
