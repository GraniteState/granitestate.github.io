  "definition": "Fees for Testing at Livestock Events",
  "effectiveDate": "2018-11-20",
  "historyNote": "#7285, eff 5-24-00, EXPIRED: 5-24-08 New. #9181, eff 6-13-08, EXPIRED: 6-13-16 New. #12678, eff 11-20-18",
