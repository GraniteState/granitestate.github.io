  "definition": "Outdoor Facilities",
  "effectiveDate": "2024-12-31",
  "historyNote": "#10834, eff 5-21-15 (formerly Agr 1702.03); ss by #14164, eff 12-31-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
