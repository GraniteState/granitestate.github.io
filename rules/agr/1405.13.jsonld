  "definition": "Minimum Test Equipment; Retail and Wholesale Liquid Measuring Devices",
  "effectiveDate": "2017-12-01",
  "historyNote": "(See Revision Notes #1 and #2 at chapter heading for Agr 1400) #12424, eff 12-1-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
