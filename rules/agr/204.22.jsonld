  "definition": "Reopening of Cases",
  "effectiveDate": "2005-03-24",
  "historyNote": "#6299, eff 7-25-96, EXPIRED: 7-25-04 New. #8309-A, eff 3-24-05",
  "inScheme": "https://granitestate.github.io/rules/scheme",
