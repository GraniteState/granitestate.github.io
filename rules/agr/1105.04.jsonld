  "definition": "Deficiency of Secondary Nutrients and Micronutrients",
  "effectiveDate": "2024-11-26",
  "expirationDate": "2034-11-26",
  "historyNote": "#10464, eff 11-26-13 (from Agr 1105.03), EXPIRED: 11-26-23 New. #13947, eff 4-30-24, EXPIRED: 10-27-24 New. #14128, eff 11-26-24, EXPIRES: 11-26-34",
