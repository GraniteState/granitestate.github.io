  "definition": "Shelter Requirements",
  "effectiveDate": "2012-04-04",
  "historyNote": "#7989, eff 11-21-03, EXPIRED: 11-21-11 New. #10105, eff 4-4-12",
  "inScheme": "https://granitestate.github.io/rules/scheme",
