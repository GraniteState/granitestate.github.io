  "broader": "https://granitestate.github.io/rules/agr/2501",
  "definition": "Nursery Stock Certification for Export",
  "effectiveDate": "2017-02-21",
  "historyNote": "#5359, eff 3-17-92; ss by #6708, eff 3-4-98, EXPIRED: 3-4-06 New. #9323, eff 11-21-08; ss by #12114, eff 2-21-17",
