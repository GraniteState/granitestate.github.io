  "definition": "Interpreter",
  "effectiveDate": "2011-12-16",
  "historyNote": "#7851, eff 3-12-03; ss by #9942, INTERIM, eff 6-18-11, EXPIRED: 12-15-11 New. #10040-A, eff 12-16-11 (from Int 101.08)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Int 101.09",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/int100-500.html",
  "prefLabel": "Int 101.09 Interpreter",
  "priorExpiration": "2011-12-15",
  "recordType": "rule-section",
  "ruleText": "Int 101.09 \"Interpreter\" means a person who provides any of the following services:\n\n(a) English-based transliterating, which includes but is not limited to conveying a message via visible representations of the English language such as manually coded English and oral transliteration. This process conveys information from one mode of English to another mode of English;\n\n(b) American Sign Language-based interpreting, which is the process of conveying information between American Sign Language and English; or\n\n(c) Intermediary interpreting means interpreting services rendered by a deaf person to facilitate communication between another deaf person and another licensed interpreter or between 2 or more deaf persons.\n\nSource. #7851, eff 3-12-03; ss by #9942, INTERIM, eff 6-18-11, EXPIRED: 12-15-11\n\nNew. #10040-A, eff 12-16-11 (from Int 101.08)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/int100-500.html"
}
