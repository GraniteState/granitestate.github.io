  "definition": "Payment for Services",
  "effectiveDate": "2022-01-29",
  "historyNote": "#12610, eff 8-23-18; ss by #12830, INTERIM, eff 8-07-19, EXPIRED: 2-3-10 New. #13340, eff 1-29-22 (formerly He-E 801.31)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
