  "effectiveDate": "2024-07-10",
  "historyNote": "#8547, eff 1-24-06 (formerly He-W 593.12); ss by #10474, eff 1-24-14; ss by #14020, eff 7-10-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
