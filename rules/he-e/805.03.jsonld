  "definition": "Eligibility",
  "effectiveDate": "2017-02-22",
  "historyNote": "#9242, eff 8-26-08; ss by #11167, INTERIM, eff 8-25-16, EXPIRED: 2-21-17 New. #12115, eff 2-22-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
