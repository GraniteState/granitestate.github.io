  "definition": "Connection to Existing Public or Non-Public Water Supply System",
  "effectiveDate": "2019-12-15",
  "historyNote": "#8491, eff 11-22-05; ss by #9935-A, eff 9-1-11, EXPIRED: 9-1-19 New. #12942, eff 12-15-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
