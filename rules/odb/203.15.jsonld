  "broader": "https://granitestate.github.io/rules/odb/203",
  "definition": "Pre-Hearing Exchange of Information",
  "effectiveDate": "2019-12-15",
  "historyNote": "#8490-A, eff 11-22-05; ss by #12941, eff 12-15-19",
