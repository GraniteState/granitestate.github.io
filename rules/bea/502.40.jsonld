  "broader": "https://granitestate.github.io/rules/bea/502",
  "definition": "“Planned unit development” (PUD) means a residential development of single-family or multi-family dwellings in conjunction with rental, condominium, cooperative",
  "effectiveDate": "2024-08-08",
  "historyNote": "#14043, eff 8-8-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Bea 502.40",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/bea500.html",
  "prefLabel": "Bea 502.40 “Planned unit development” (PUD) means a residential development of single-family or multi-family dwellings in conjunction with rental, condominium, cooperative",
  "recordType": "rule-section",
  "ruleText": "Bea 502.40 “Planned unit development” (PUD) means a residential development of single-family or multi-family dwellings in conjunction with rental, condominium, cooperative or town house properties with at least the following characteristics:\n\n(a) A homeowner association that holds either title in fee or a lease of prescribed length on the common area;\n\n(b) Mandatory membership of all unit owners, or units, in the association;\n\n(c) The right of all unit owners to participate by vote in the operation of the association; and\n\n(d) Lien supported assessment of the members to meet the association's budgeted operating costs, but special assessments may be handled differently.\n\nSource. #14043, eff 8-8-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/bea500.html"
}
