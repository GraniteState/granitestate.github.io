  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/bea400.html",
  "prefLabel": "Bea 404.01 Notification",
  "priorExpiration": "2023-07-04",
  "recordType": "rule-section",
  "ruleText": "Bea 404.01 Notification. BEA shall make all political subdivisions aware of the BMGI program through electronic notification. Those notified shall include, but not be limited to, members of a city council, town council, town select board, town managers or administrators, county administrators, county commissioners, or administrative staff that directly help the leadership of a political subdivision.\n\nSource. #13515, INTERIM, eff 1-5-23, EXPIRES: 7-4-23; ss by #13734, eff 9-1-23",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/bea400.html"
