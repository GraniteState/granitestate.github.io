  "effectiveDate": "2023-09-01",
  "historyNote": "#13515, INTERIM, eff 1-5-23, EXPIRES: 7-4-23; ss by #13734, eff 9-1-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
