  "definition": "Non-Acceptable Use of Funds",
  "effectiveDate": "2026-07-07",
  "expirationDate": "2036-07-07",
  "historyNote": "#13270, eff 9-30-21; ss by #14624, eff 7-7-26, EXPIRES: 7-7-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
