  "prefLabel": "Stra 1102.03 Institution Eligibility",
  "priorExpiration": "2018-07-02",
  "recordType": "rule-section",
  "ruleText": "Stra 1102.03 Institution Eligibility. All of the following postsecondary institutions shall be approved by the office and be eligible to participate in the scholarship program:\n\n(a) Title IV eligible not- for-profit private colleges and universities approved by the New Hampshire higher education commission;\n\n(b) All Title IV eligible institutions with the community college system of New Hampshire;\n\n(c) All Title IV eligible institutions within the university system of New Hampshire; and\n\n(d) Any other not-for-profit postsecondary institution recognized and approved to operate in New Hampshire by the New Hampshire higher education commission.\n\nSource. #12446, INTERIM, eff 1-3-18, EXPIRES: 7-2-18; ss by #12550, eff 6-19-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/stra1100.html"
