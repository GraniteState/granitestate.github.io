  "broader": "https://granitestate.github.io/rules/adm/1005",
  "definition": "Additional Liabilities of Defendant",
  "effectiveDate": "2020-07-01",
  "historyNote": "(See Revision Note at chapter heading for Adm 1000) #8697, eff 8-3-06; ss by #10728, eff 11-25-14; ss by #13050, eff 7-1-20",
