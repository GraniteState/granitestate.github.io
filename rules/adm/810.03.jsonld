  "broader": "https://granitestate.github.io/rules/adm/810",
  "definition": "Duration of Rental Agreements",
  "effectiveDate": "2023-07-29",
  "historyNote": "#13708, eff 7-29-23 (see Revision Note at chapter heading for Adm 800)",
