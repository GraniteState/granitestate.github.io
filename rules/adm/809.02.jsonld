  "broader": "https://granitestate.github.io/rules/adm/809",
  "definition": "Rental Package for Rental Agreements at a Cost Less than the Governor and Council Approval Threshold",
  "effectiveDate": "2023-07-29",
  "historyNote": "#13708, eff 7-29-23 (see Revision Note at chapter heading for Adm 800)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Adm 809.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/adm800.html",
  "prefLabel": "Adm 809.02 Rental Package for Rental Agreements at a Cost Less than the Governor and Council Approval Threshold",
  "recordType": "rule-section",
  "ruleText": "Adm 809.02 Rental Package for Rental Agreements at a Cost Less than the Governor and Council Approval Threshold. The completed rental package for rental agreements at a cost less than the governor and council approval threshold shall contain:\n\n(a) A cover letter requesting the division’s recommendation on the rental agreement, and containing the following information:\n\n(1) The reason why the agency chose the proposed lessor or licensor named on the rental agreement;\n\n(2) The best estimate of the cost of services and items that might result in a cost to the agency that is not included in the rental agreement, including but not limited to the following:\n\na. Utilities, including estimates for the annual average costs of heat, electricity, and water;\n\nb. Estimated annual costs of maintenance, custodial, snow removal, and cleaning services;\n\nc. Projected costs of any repairs, improvements, renovations, modifications, or other changes to be made to the rented space; and\n\nd. Any other costs, including the cost of recycling, which costs shall be itemized; and\n\n(3) Specifications regarding the agency that is to occupy the rented space, which specifications shall include:\n\na. The agency name and names of subsections;\n\nb. The number of staff positions that are to occupy the rented location; and\n\nc. The total square footage of the space to be rented;\n\n(b) If the rental agreement is a proposed lease, the original and one copy of the completed and fully signed rental agreement, in the set forth in Adm 809.03, together with all attachments; and\n\n(c) If the rental agreement is a proposed license agreement, the original and one copy of the completed and fully signed rental agreement containing the information noted at Adm 809.04.\n\nSource. #13708, eff 7-29-23 (see Revision Note at chapter heading for Adm 800)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/adm800.html"
}
