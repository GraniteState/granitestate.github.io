  "definition": "Petitions to Intervene",
  "effectiveDate": "2009-03-27",
  "historyNote": "#7187, eff 1-8-00; EXPIRED: 1-8-08 New. #9145, INTERIM, eff 4-29-08, EXPIRED: 10-26-08 New. #9441-A, eff 3-27-09",
