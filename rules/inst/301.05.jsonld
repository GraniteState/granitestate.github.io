  "definition": "Denial of License Application",
  "effectiveDate": "2025-01-17",
  "historyNote": "#8494, eff 12-24-05; ss by #10115, eff 4-14-12, EXPIRED: 4-15-22 New. #14112, eff 1-17-25 (formerly Inst 301.06)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
