  "broader": "https://granitestate.github.io/rules/den/503",
  "definition": "Chronic Pain",
  "effectiveDate": "2025-03-07",
  "historyNote": "#11130, eff 6-29-16; ss by #12061, eff 1-1-17 (from Den 503.04); renumbered by #12167, eff 3-7-25 (formerly Den 503.05)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
