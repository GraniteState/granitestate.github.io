  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/den100-500.html",
  "prefLabel": "Den 101.21 Licensure by examination",
  "priorExpiration": "1997-04-04",
  "recordType": "rule-section",
  "ruleText": "Den 101.21 “Licensure by examination” means granting a license to practice dentistry or to provide dental hygiene services in New Hampshire based upon compliance with the applicable requirements of Den 300, and passage of the American Board of Dental Examiners (ADEX) or any similar national or regional testing agency.\n\nSource. #287.2 eff 1-17-74; ss by #2981, eff 2-28-85; ss by #5110, eff 4-4-91, EXPIRED: 4-4-97\n\nNew. #6908, eff 12-9-98; ss by #10688, eff 10-7-14; renumbered by #12427 (formerly Den 101.15); renumbered by #14140 (formerly Den 101.18)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/den100-500.html"
