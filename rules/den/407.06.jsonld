  "definition": "Monetary Sanctions: Expenses Relating to Discipline Enforcement",
  "effectiveDate": "2024-07-05",
  "expirationDate": "2034-07-05",
  "historyNote": "#13956, eff 7-5-24; EXPIRES: 7-5-34; renumbered by #14398 (formerly Den 404.06)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
