  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/gcd100-400.html",
  "prefLabel": "Gcd 402.03 Person with a disability",
  "recordType": "rule-section",
  "ruleText": "Gcd 402.03 \"Person with a disability\" means \"person with a disability\" as defined in RSA 275-C:1, II, namely, \"one who has a physical or mental impairment that substantially limits one or more of the major life activities of such individual, a record of such an impairment, or is regarded as having such an impairment.\"\n\nSource. #10341, eff 5-17-13; ss by #13811, eff 11-23-23",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/gcd100-400.html"
}
