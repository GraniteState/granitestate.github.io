  "definition": "Wells Drilled in Bedrock: Casing Function and Materials",
  "effectiveDate": "2017-03-01",
  "historyNote": "(See Revision Note at chapter heading for We 600) #12083 eff 3-1-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
