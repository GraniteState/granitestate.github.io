  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/we100-1000.html",
  "prefLabel": "We 101.24 Listed",
  "recordType": "rule-section",
  "ruleText": "We 101.24 “Listed” means equipment or materials included in a list published by an organization that is acceptable under the current National Electrical Code, adopted pursuant to RSA 155-A:1, IV, concerned with evaluation of products, that maintains periodic inspection of production of listed equipment or materials, and whose listing states that either the equipment or material meets appropriate designated standards or has been tested and found suitable for a specified purpose.\n\nSource. #12075, eff 12-24-16",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/we100-1000.html"
