  "definition": "Conviction",
  "effectiveDate": "2018-06-28",
  "historyNote": "(See Revision Note #1 and Revision Note #2 at chapter heading for Fis 1800) #12562, eff 6-28-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Fis 1801.01",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fis1800.html",
  "prefLabel": "Fis 1801.01 Conviction",
  "recordType": "rule-section",
  "ruleText": "Fis 1801.01 “Conviction” means a determination that a person has violated or failed to comply with the law in a court of original jurisdiction or an administrative proceeding which has not been annulled or vacated, an unvacated forfeiture of bail or collateral deposited to secure the person's appearance in court, a plea of guilty or nolo contendere accepted by a court, the payment of a fine or court costs, or the violation of a condition of release without bail, regardless of whether the penalty is rebated, suspended or otherwise affected by probation.\n\nSource. (See Revision Note #1 and Revision Note #2 at chapter heading for Fis 1800) #12562, eff 6-28-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fis1800.html"
