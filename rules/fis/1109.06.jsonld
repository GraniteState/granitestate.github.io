  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fis1100.html",
  "prefLabel": "Fis 1109.06 Checks",
  "recordType": "rule-section",
  "ruleText": "Fis 1109.06 Checks.\n\n(a) Post-dated checks shall not be accepted.\n\n(b) Checks shall be for the exact amount due to the department.\n\n(c) No 2-party check shall be accepted.\n\n(d) No check shall be accepted which is dated more than 90 days prior to receipt.\n\n(e) In the event a non-compliant check is presented for payment, the application for a license or permit shall be rejected, and the applicant shall be notified in accordance with Fis 1109.04.\n\nSource. #12785, eff 5-22-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fis1100.html"
}
