  "effectiveDate": "2010-01-12",
  "historyNote": "#7382, eff 10-25-00, EXPIRED: 10-25-08 New. #9332, INTERIM, eff 11-27-08, EXPIRED: 5-26-09 New. #9636-A, eff 1-12-10",
