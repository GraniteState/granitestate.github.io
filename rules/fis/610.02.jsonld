  "definition": "Lobster Tail Processing",
  "effectiveDate": "2015-09-14",
  "historyNote": "#9772, INTERIM, eff 8-26-10, EXPIRED: 2-22-11 New. #9887, eff 3-15-11; amd by #10930, EXEMPT, eff 9-14-15",
  "inScheme": "https://granitestate.github.io/rules/scheme",
