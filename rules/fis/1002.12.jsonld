  "notation": "Fis 1002.12",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fis1000.html",
  "prefLabel": "Fis 1002.12 Owner",
  "recordType": "rule-section",
  "ruleText": "Fis 1002.12 “Owner” means the person or legal entity who holds record title to the real property on which the work that is the subject of the action, approval, permit, or other written authorization under review has occurred or is proposed to occur.",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/fis1000.html"
