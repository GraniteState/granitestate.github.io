  "definition": "Marine Permit Fees",
  "effectiveDate": "2024-02-23",
  "historyNote": "#10874, EMERGENCY RULE, eff 7-1-15, EXPIRED: 12-28-15 New. #10981, eff 1-1-16; ss by #13476, eff 10-28-22; ss by #13874, eff 2-23-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
