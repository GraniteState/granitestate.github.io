  "definition": "Approval and Review of Leases",
  "effectiveDate": "2021-05-20",
  "historyNote": "#8086, eff 5-26-04; ss by #10363, eff 6-15-13; ss by #13207, eff 5-20-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
