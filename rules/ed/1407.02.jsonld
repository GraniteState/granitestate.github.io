  "definition": "Issuing Credit for Graduation",
  "effectiveDate": "2024-04-12",
  "historyNote": "#13090, eff 8-14-20 (see Revision Note at chapter heading for Ed 1400); ss by #13393, eff 6-10-22; ss by #13924, eff 4-12-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
