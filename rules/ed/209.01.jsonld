  "definition": "Authority of Hearing Officer",
  "effectiveDate": "2005-04-23",
  "historyNote": "#6348, eff 10-5-96, EXPIRED: 10-5-04 New. #8334-A, eff 4-23-05 (from Ed 210.03)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
