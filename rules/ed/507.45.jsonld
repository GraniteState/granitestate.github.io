  "broader": "https://granitestate.github.io/rules/ed/507",
  "definition": "Special Education Teacher in Area of Specific Learning Disabilities",
  "effectiveDate": "2016-08-16",
  "historyNote": "#9157, eff 7-1-08; ss by #11153, eff 8-16-16; renumbered by #12603 (formerly Ed 507.43)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
