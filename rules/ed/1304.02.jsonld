  "definition": "Regional Career and Technical Education Agreements (RCTEA)",
  "effectiveDate": "2023-11-10",
  "historyNote": "#13717, INTERIM, eff 8-11-23, EXPIRES: 2-7-24; ss by #13805, eff 11-10-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
