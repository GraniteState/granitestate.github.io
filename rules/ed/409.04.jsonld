  "effectiveDate": "2024-01-11",
  "historyNote": "#8263, eff 1-22-05; ss by #10360, eff 6-15-13; ss by #13853, eff 1-11-24 (formerly Ed 408.04) (See Revision Note a chapter heading for Ed 400)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
