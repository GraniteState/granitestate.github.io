  "definition": "Waiver Provision",
  "effectiveDate": "2021-08-18",
  "historyNote": "(See Revision Note at part heading for Ed 318) #10873, eff 7-1-15; ss by #13253, eff 8-18-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
