  "effectiveDate": "2005-04-23",
  "historyNote": "#6348, eff 10-5-96; amd by #6819, eff 9-1-98; ss by #8334-A, eff 4-23-05 (from Ed 214.02)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
