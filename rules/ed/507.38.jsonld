  "definition": "World Language Teacher",
  "effectiveDate": "2017-03-24",
  "historyNote": "#7924, eff 7-24-03; ss by #9306, eff 10-25-08, EXPIRED: 10-25-16 New. #12148, eff 3-24-17; renumbered by #12603 (formerly Ed 507.37)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
