  "definition": "ESOL Teacher",
  "effectiveDate": "2023-08-11",
  "historyNote": "#6349, eff 10-5-96, EXPIRED: 10-5-04 New. #8229, eff 12-17-04; ss by #10276, eff 2-22-13; ss by #13719, eff 8-11-23",
