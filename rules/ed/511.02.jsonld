  "broader": "https://granitestate.github.io/rules/ed/511",
  "definition": "Post Investigation Procedures",
  "effectiveDate": "2024-06-14",
  "historyNote": "#12661, eff 11-9-18 (see Revision Note at part heading for Ed 511); ss by #13999, eff 6-14-24 (formerly Ed 511.01(j)-(o)) (see Revision Note at chapter heading for Ed 500)",
