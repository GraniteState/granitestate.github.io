  "definition": "Agency",
  "effectiveDate": "2005-12-09",
  "historyNote": "#2659, eff 3-28-84; EXPIRED 3-28-90 New. #5481, eff 11-1-92, EXPIRED: 11-1-98 New. #8508 eff 12-9-05",
