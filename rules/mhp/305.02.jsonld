  "definition": "Courses Required for Mental Health Counselors",
  "effectiveDate": "2026-02-17",
  "expirationDate": "2036-02-17",
  "historyNote": "#10857, eff 6-24-15 (from Mhp 302.17); ss by #13903, eff 5-14-24; ss by #14464, eff 2-17-26, EXPIRES 2-17-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
