  "broader": "https://granitestate.github.io/rules/rab/401",
  "definition": "Denial of Renewal",
  "effectiveDate": "2024-05-18",
  "historyNote": "#10270, eff 2-2-13, EXPIRED: 2-2-23 New. #13968, eff 5-18-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
