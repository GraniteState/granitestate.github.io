  "definition": "Licensee Obligations to Clients",
  "effectiveDate": "2026-09-21",
  "expirationDate": "2036-09-21",
  "historyNote": "(See Revision Note #1 at chapter heading for Plc 600) #12622, eff 9-21-18 (formerly Plc 402.02); ss by #14631, eff 9-21-26, EXPIRES: 9-21-36 (formerly Plc 602.02)",
