  "definition": "Licensee Obligations for Notifications",
  "effectiveDate": "2024-05-03",
  "historyNote": "(See Revision Note #1 at chapter heading for Plc 300) #13606, eff 5-1-23; ss by #13955, eff 5-3-24 (see Revision Note #2 at chapter heading for Plc 300)",
