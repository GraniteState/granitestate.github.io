  "definition": "Continuing Education Required",
  "effectiveDate": "2025-10-24",
  "expirationDate": "2035-10-24",
  "historyNote": "#14217, INTERIM, eff 4-1-25; ss by #14388, eff 10-24-25, EXPIRES: 10-24-35",
