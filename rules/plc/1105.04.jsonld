  "definition": "Expired License",
  "effectiveDate": "2026-01-26",
  "expirationDate": "2036-01-26",
  "historyNote": "(See Revision Note at chapter heading for Plc 1100) #13391, eff 5-27-22; ss by #14444, eff 1-26-26, EXPIRES: 1-26-36 (formerly Plc 1105.05)",
