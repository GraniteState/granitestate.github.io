  "definition": "Requirement for Continuing Education",
  "effectiveDate": "2022-12-22",
  "historyNote": "#13495, eff 12-22-22 (see Revision Note at chapter heading for Plc 700)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
