  "broader": "https://granitestate.github.io/rules/plc/301",
  "definition": "Applicability",
  "effectiveDate": "2023-05-01",
  "historyNote": "(See Revision Note #1 at chapter heading for Plc 300) #13606, eff 5-1-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Plc 301.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/plc300.html",
  "prefLabel": "Plc 301.02 Applicability",
  "recordType": "rule-section",
  "ruleText": "Plc 301.02 Applicability.\n\n(a) Subject to (b) and (c), below, this chapter shall apply to any person who intends to practice, or who does actually practice, a profession regulated by any applicable board.\n\n(b) This chapter shall not apply to any person made exempt from licensure by applicable law.\n\n(c) If the OPLC has a contract with a third party organization to process initial applications for licensure in New Hampshire on behalf of any applicable board, for example the National Association of State Boards of Accountancy (NASBA) on behalf of the board of accountancy, then:\n\n(1) Notice of how individuals can apply for initial licensure shall be posted on the OPLC web page, https://www.oplc.nh.gov; and\n\n(2) The provisions of this chapter relative to submitting an application for initial licensure shall not apply to such applications.\n\nSource. (See Revision Note #1 at chapter heading for Plc 300) #13606, eff 5-1-23",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/plc300.html"
}
