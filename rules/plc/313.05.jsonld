  "definition": "Documentation Required for Initial License Application",
  "effectiveDate": "2024-05-03",
  "historyNote": "#13763, INTERIM, eff 10-15-23, EXPIRED: 4-12-24 New. #13954, eff 5-3-24 (see Revision Note #1 at part heading for Plc 313)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
