  "prefLabel": "Plc 302.25 Regulated profession",
  "recordType": "rule-section",
  "ruleText": "Plc 302.25 “Regulated profession” means an occupation or profession for which a license is required to be obtained from the OPLC prior to engaging in the occupation or profession in New Hampshire.",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/plc500.html"
