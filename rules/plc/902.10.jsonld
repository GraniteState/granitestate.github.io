  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/plc900.html",
  "prefLabel": "Plc 902.10 Inappropriate sexual contact",
  "recordType": "rule-section",
  "ruleText": "Plc 902.10 “Inappropriate sexual contact” means the intentional touching by the massage therapist of a client’s breasts or genitalia when such touching:\n\n(a) Is a therapeutic aspect of the massage, but is done without the informed consent of the client; or\n\n(b) Is not a necessary, therapeutic aspect of the massage, and is performed primarily for the purpose of sexual arousal or gratification of the massage therapist or the client.\n\nSource. #14387, eff 10-17-25, EXPIRES: 10-17-35",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/plc900.html"
}
