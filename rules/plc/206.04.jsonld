  "broader": "https://granitestate.github.io/rules/plc/206",
  "definition": "Withdrawal of Presiding Officer",
  "effectiveDate": "2022-08-04",
  "historyNote": "(See Revision Note #1 at chapter heading for Plc 200) #13427, eff 8-4-22",
