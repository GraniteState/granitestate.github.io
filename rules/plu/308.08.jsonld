  "definition": "Fees for Plumbing Inspections",
  "effectiveDate": "2008-09-18",
  "historyNote": "#8916, eff 6-22-07; ss by #9271, eff 9-18-08",
  "inScheme": "https://granitestate.github.io/rules/scheme",
