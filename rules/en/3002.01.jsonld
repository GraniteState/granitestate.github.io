  "definition": "Affiliate",
  "effectiveDate": "2026-05-21",
  "expirationDate": "2036-05-21",
  "historyNote": "#14593, eff 5-21-26, EXPIRES: 5-21-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
