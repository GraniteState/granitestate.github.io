  "broader": "https://granitestate.github.io/rules/en/1503",
  "definition": "Contents of Application for Electric Supply or Communication Lines Crossing License",
  "effectiveDate": "2024-04-26",
  "historyNote": "#13939, eff 4-26-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
