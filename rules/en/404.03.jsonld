  "broader": "https://granitestate.github.io/rules/en/404",
  "definition": "Denial of Registration",
  "effectiveDate": "2024-07-01",
  "historyNote": "#14015, eff 7-1-24 (see Revision Note at chapter heading for En 400)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
