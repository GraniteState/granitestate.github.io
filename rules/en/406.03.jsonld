  "definition": "Significant Facility Disruption",
  "effectiveDate": "2025-10-29",
  "expirationDate": "2035-10-29",
  "historyNote": "#14015, eff 7-1-24 (see Revision Note at chapter heading for En 400); ss by #14417 (EXRF), eff 10-29-25, EXPIRES: 10-29-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
