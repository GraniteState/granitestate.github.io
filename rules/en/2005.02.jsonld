  "definition": "Department Claims Against CEPS’s Financial Security",
  "effectiveDate": "2026-05-15",
  "expirationDate": "2036-05-15",
  "historyNote": "#14583, eff 5-15-26, EXPIRES: 5-15-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
