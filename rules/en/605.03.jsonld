  "broader": "https://granitestate.github.io/rules/en/605",
  "definition": "Test and Calibration of Meters",
  "effectiveDate": "2024-03-21",
  "historyNote": "#13911, eff 3-21-24 (see Revision Note at chapter heading for En 600)",
