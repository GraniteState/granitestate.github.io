  "broader": "https://granitestate.github.io/rules/en/2002",
  "definition": "Affiliate",
  "effectiveDate": "2026-05-15",
  "expirationDate": "2036-05-15",
  "historyNote": "#14583, eff 5-15-26, EXPIRES: 5-15-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "En 2002.01",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/en2000.html",
  "prefLabel": "En 2002.01 Affiliate",
  "recordType": "rule-section",
  "ruleText": "En 2002.01 “Affiliate” means any of the following:\n\n(a) Any person or entity that directly or indirectly owns, controls, or holds with power to vote a majority of the outstanding voting securities or such minority thereof as to give such person substantial control of another person or entity;\n\n(b) Any person or entity that is directly or indirectly owned, controlled, or held by any person or entity described in En 2002.01(a) through either power to vote a majority of the outstanding voting securities or such a minority so as to maintain substantial control of such person or entity;\n\n(c) Any person or entity with which another person or entity has a management or service contract or arrangement that provides such person or entity with effective control over the management, supervision, or operation of the other person or entity; or\n\n(d) Any person or entity who exercises effective control over the management, supervision, or operation of another person or entity.\n\nSource. #14583, eff 5-15-26, EXPIRES: 5-15-36",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/en2000.html"
