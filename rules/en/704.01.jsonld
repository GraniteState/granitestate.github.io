  "definition": "Effluent Standards",
  "effectiveDate": "2024-03-21",
  "historyNote": "#13912, eff 3-21-24 (see Revision Note at chapter heading for En 700)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
