  "definition": "Use of Extension Arms",
  "effectiveDate": "2022-12-01",
  "historyNote": "#13497, eff 12-1-22 (see Revision Note at chapter heading for En 1300)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
