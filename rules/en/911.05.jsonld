  "definition": "Municipal Host Group Membership Requirements",
  "effectiveDate": "2026-04-27",
  "expirationDate": "2036-04-27",
  "historyNote": "#14568, eff 4-27-26, EXPIRES: 4-27-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
