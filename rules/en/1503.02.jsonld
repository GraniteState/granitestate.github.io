  "definition": "Exceptions to License Requirement",
  "effectiveDate": "2024-04-26",
  "historyNote": "#13939, eff 4-26-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "En 1503.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/en1500.html",
  "prefLabel": "En 1503.02 Exceptions to License Requirement",
  "recordType": "rule-section",
  "ruleText": "En 1503.02 Exceptions to License Requirement.\n\n(a) Notwithstanding En 1503.01, an application shall not be required with respect to limited maintenance or temporary construction provided that notification is given to the department within a reasonable time not to exceed 7 days after the inception of such activities and provided further notification also is given to the department within 7 days of completion.\n\n(b) Notwithstanding En 1503.01, an application shall not be submitted in advance of emergency construction or modification provided that notice is given to the department within a reasonable time not to exceed 7 days after the inception of work and provided further that an application is filed within 90 days after completion.\n\nSource. #13939, eff 4-26-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/en1500.html"
}
