  "broader": "https://granitestate.github.io/rules/en/1018",
  "definition": "Insurance Thresholds",
  "effectiveDate": "2026-09-01",
  "expirationDate": "2036-09-01",
  "historyNote": "#14657, eff 9-1-26, EXPIRES: 9-1-36",
