  "definition": "Aggregator",
  "effectiveDate": "2026-05-15",
  "expirationDate": "2036-05-15",
  "historyNote": "#14583, eff 5-15-26, EXPIRES: 5-15-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "En 2002.03",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/en2000.html",
  "prefLabel": "En 2002.03 Aggregator",
  "recordType": "rule-section",
  "ruleText": "En 2002.03 “Aggregator” means any person or entity, other than a utility, that aggregates electric load or serves as a broker on behalf of a competitive electric power supplier, an individual customer, a group of customers, or any combination thereof. An aggregator does not take ownership of the electricity. The term does not include any employee aggregating load or brokering electricity supply on behalf of the employee’s employer.\n\nSource. #14583, eff 5-15-26, EXPIRES: 5-15-36",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/en2000.html"
