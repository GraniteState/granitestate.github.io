  "broader": "https://granitestate.github.io/rules/mil/301",
  "definition": "Pasteurized Milk Ordinance",
  "effectiveDate": "2019-08-29",
  "historyNote": "#5684, eff 8-9, EXPIRED: 8-9-99 New. #7314, eff 7-1-00; ss by #7517, eff 6-28-01; ss by #9253-B, eff 8-30-08; ss by #10537, eff 5-1-14; ss by #12862-B, eff 8-29-19",
