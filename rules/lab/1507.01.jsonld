  "broader": "https://granitestate.github.io/rules/lab/1507",
  "definition": "Application for a Restricted License",
  "effectiveDate": "2022-08-24",
  "historyNote": "#10221, eff 11-3-12 (from Lab 1506.01); ss by #13440, eff 8-24-22",
