  "broader": "https://granitestate.github.io/rules/lab/1303",
  "definition": "Examination Required",
  "effectiveDate": "2025-07-11",
  "expirationDate": "2035-07-11",
  "historyNote": "#6368, eff 10-31-96; ss by #6845, eff 9-1-98; ss by #8706, INTERIM, eff 8-19-06, EXPIRED: 2-15-07 New. #8880, eff 4-28-07; ss by #10715, eff 11-10-14; ss by #14313, eff 7-11-25, EXPIRES: 7-11-35",
