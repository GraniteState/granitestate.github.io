  "broader": "https://granitestate.github.io/rules/lab/1001",
  "definition": "\"Duly enrolled in school\" as used in RSA 276-A:4, VI and VII, means any one of the following",
  "effectiveDate": "2021-06-26",
  "historyNote": "(See Revision Note at chapter heading for Lab 1000) #5492, eff 10-20-92, EXPIRED: 10-20-98 New. #7337, eff 8-2-00; EXPIRED: 8-2-08 New. #9258, eff 9-11-08; ss by #10931, eff 9-15-15; ss by #13222, eff 6-26-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Lab 1001.03",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/lab1000.html",
  "prefLabel": "Lab 1001.03 \"Duly enrolled in school\" as used in RSA 276-A:4, VI and VII, means any one of the following",
  "priorExpiration": "2008-08-02",
  "recordType": "rule-section",
  "ruleText": "Lab 1001.03 \"Duly enrolled in school\" as used in RSA 276-A:4, VI and VII, means any one of the following:\n\n(a) The youth is enrolled as a student in a school;\n\n(b) The youth is attending classes or enrolled in a program for the purpose of receiving a general equivalency diploma; or\n\n(c) The youth is currently being home-schooled by a parent or guardian in a program authorized by the New Hampshire department of education pursuant to RSA 193-A for the purpose of receiving a diploma.\n\nSource. (See Revision Note at chapter heading for Lab 1000) #5492, eff 10-20-92, EXPIRED: 10-20-98\n\nNew. #7337, eff 8-2-00; EXPIRED: 8-2-08\n\nNew. #9258, eff 9-11-08; ss by #10931, eff 9-15-15; ss by #13222, eff 6-26-21",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/lab1000.html"
