  "definition": "Media Access",
  "effectiveDate": "2026-03-12",
  "historyNote": "#8922-A, eff 7-1-07; ss by #14534, eff 3-12-26 (formerly Lab 210.04)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
