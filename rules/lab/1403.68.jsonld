  "definition": "Welding in Confined Spaces",
  "effectiveDate": "2025-11-22",
  "expirationDate": "2035-11-22",
  "historyNote": "#10809, eff 4-9-15 (from Lab 1403.64); ss by #14431, eff 11-22-25, EXPIRES: 11-22-35",
