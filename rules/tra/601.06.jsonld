  "broader": "https://granitestate.github.io/rules/tra/601",
  "definition": "On-Premise Outdoor Advertising Devices",
  "effectiveDate": "2026-02-27",
  "expirationDate": "2036-02-27",
  "historyNote": "#8005, eff 12-17-03; ss by #10033, eff 11-23-11, EXPIRED: 11-23-21 New. #14521, eff 2-27-26, EXPIRES 2-27-36",
  "inScheme": "https://granitestate.github.io/rules/scheme",
