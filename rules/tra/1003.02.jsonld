  "definition": "Denial of Pre-Qualification",
  "effectiveDate": "2023-03-22",
  "historyNote": "#8536, INTERIM, eff 1-6-06, EXPIRED: 7-5-06 New. #10209, eff 10-23-12; ss by #13587, eff 3-22-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
