  "definition": "Account Holder and Registered Vehicle Owner Responsibilities",
  "effectiveDate": "2024-07-03",
  "historyNote": "#8422, eff 8-23-05, EXPIRED: 8-23-14 New. #10634, eff 7-2-14; ss by #14009, eff 7-3-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
