  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/tra300.html",
  "prefLabel": "Tra 303.01 Purpose",
  "priorExpiration": "2000-05-19",
  "recordType": "rule-section",
  "ruleText": "Tra 303.01 Purpose. Federal regulations require that each state establish and implement criteria to evaluate travel by twin trailer vehicles on routes not included in the national network. This part establishes the procedure for departmental review of access route requests for twin trailer trucks operating away from the national network for the purpose of accessing terminal or service facilities.\n\nSource. #5825, eff 5-19-94, EXPIRED: 5-19-00\n\nNew. #12156, eff 4-6-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/tra300.html"
}
