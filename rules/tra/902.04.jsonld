  "definition": "Negotiable Instruments",
  "effectiveDate": "2022-11-03",
  "historyNote": "#7997, eff 12-1-03; ss by #10034, eff 11-23-11 (formerly Tra 901.05) New. #13480, eff 11-3-22 (formerly Tra 902.05)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
