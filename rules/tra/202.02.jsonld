  "definition": "Withdrawal of Presiding Officer",
  "effectiveDate": "2003-07-26",
  "historyNote": "#4174, eff 12-1-86; EXPIRED 12-1-90 New. #5563, eff 1-28-93, EXPIRED: 1-28-99 New. #7927-A, eff 7-26-03",
  "inScheme": "https://granitestate.github.io/rules/scheme",
