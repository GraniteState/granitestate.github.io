  "definition": "Evaluation of an Application",
  "effectiveDate": "1993-10-13",
  "historyNote": "(See Revision Note at chapter heading for Bfa 100) #5719, eff 10-13-93",
  "inScheme": "https://granitestate.github.io/rules/scheme",
