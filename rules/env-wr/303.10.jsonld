  "broader": "https://granitestate.github.io/rules/env-wr/303",
  "definition": "Discharge Capacity",
  "effectiveDate": "2024-05-24",
  "historyNote": "#8414, eff 8-20-05; ss by #10510, eff 1-22-14; ss by #13980, eff 5-24-24 (formerly Env-Wr 303.11)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
