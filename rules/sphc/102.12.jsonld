  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html",
  "prefLabel": "Sphc 102.12 Speech-language pathology",
  "recordType": "rule-section",
  "ruleText": "Sphc 102.12 \"Speech-language pathology\" means \"speech-language pathology\" as defined in RSA 326-F:1, XIII, namely, \"the application of principles, methods, and procedures related to the development and disorders of human communication, which disorders shall include any and all conditions whether of organic or nonorganic origin, that impede the normal process of human communication including, but not limited to, disorders and related disorders of speech, articulation, fluency, voice, verbal and written language, auditory comprehension, cognition, communication, swallowing, and oral, pharyngeal or laryngeal sensorimotor competencies.\"\n\nSource. #14193, eff 2-12-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html"
}
