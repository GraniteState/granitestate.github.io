  "definition": "Audiologist",
  "effectiveDate": "2025-02-12",
  "historyNote": "#14193, eff 2-12-25",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Sphc 102.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html",
  "prefLabel": "Sphc 102.02 Audiologist",
  "recordType": "rule-section",
  "ruleText": "Sphc 102.02 \"Audiologist\" means “audiologist” as defined in RSA 326-F:1, I, namely, “any person who renders or offers to render to the public any service involving the application of principles, methods, and procedures for the measurement of testing, identification, appraisal, consultation, counseling, instruction, and research related to the development and disorders of hearing and vestibular function for the purpose of diagnosing, designing, and implementing programs for the amelioration of such disorders and conditions.”\n\nSource. #14193, eff 2-12-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html"
}
