  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html",
  "prefLabel": "Sphc 102.05 Certificate of Clinical Competence (CCC)",
  "recordType": "rule-section",
  "ruleText": "Sphc 102.05 \"Certificate of Clinical Competence (CCC)\" means the professional credential issued by the ASHA Council for Clinical Certification on the basis of successful completion of specified academic requirements, specified practicum requirements, an examination, and specified post-graduate professional experience.\n\nSource. #14193, eff 2-12-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html"
