  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html",
  "prefLabel": "Sphc 102.03 Audiology",
  "recordType": "rule-section",
  "ruleText": "Sphc 102.03 \"Audiology\" means “audiology” as defined in RSA 326-F:1, II, namely, “the application of principles, methods, and procedures related to the development and disorders of human communication, which disorders shall include any and all conditions whether of organic or nonorganic origin, that impede the normal processes of human communication and balance including, but not limited to, disorders of hearing, vestibular function, and central auditory processing.”\n\nSource. #14193, eff 2-12-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/sphc100.html"
}
