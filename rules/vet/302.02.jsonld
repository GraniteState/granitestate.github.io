  "definition": "Good Professional Character",
  "effectiveDate": "2022-12-19",
  "historyNote": "#9464-B, eff 4-23-09 New. #12842, INTERIM, eff 8-1-19, EXPIRED: 1-28-20 New. #13467, eff 12-19-22",
