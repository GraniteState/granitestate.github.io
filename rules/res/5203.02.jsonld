  "broader": "https://granitestate.github.io/rules/res/5203",
  "definition": "Form 5200, Application for Registration of Primary Wood Processing Mill or Wood Concentration Yard",
  "effectiveDate": "2014-03-21",
  "historyNote": "#8441, eff 10-1-05; ss by #10547, eff 3-21-14",
