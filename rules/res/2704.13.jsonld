  "definition": "Grant Limitations",
  "effectiveDate": "2009-07-01",
  "historyNote": "#8975, INTERIM, eff 9-14-07, EXPIRED: 3-12-08 New. #9498, eff 7-1-09 (from Res 2704.12)",
