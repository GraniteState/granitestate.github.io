  "broader": "https://granitestate.github.io/rules/res/8503",
  "definition": "Snowmobile Trail Restrictions",
  "effectiveDate": "2015-08-05",
  "historyNote": "#9478, eff 5-23-09 (from Res 8503.01); ss by #10905, eff 8-5-15",
