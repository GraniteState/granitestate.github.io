  "effectiveDate": "2009-06-01",
  "expirationDate": "2017-06-01",
  "historyNote": "#5927, eff 11-22-94, EXPIRED: 11-22-00 New. #7507, eff 6-21-01; ss by #9479, eff 6-1-09, EXPIRED: 6-1-17",
