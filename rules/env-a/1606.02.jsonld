  "definition": "Determination of Need to Use Non-Conforming Fuel",
  "effectiveDate": "2023-11-18",
  "historyNote": "#10415, eff 9-24-13 (formerly Env-A 1609.02); ss by #13808, eff 11-18-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
