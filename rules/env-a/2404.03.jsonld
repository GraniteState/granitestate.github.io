  "definition": "Calculations of Sulfur Dioxide Emission Standards for Non-Ferrous Foundries, Smelters, or Investment Casting Operations",
  "effectiveDate": "2023-07-22",
  "historyNote": "#10315, eff 4-23-13 (from Env-A 2405.02); ss by #13694, eff 7-22-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 2404.03",
