  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html",
  "prefLabel": "Env-A 1202.56 Electrostatic prep coating",
  "recordType": "rule-section",
  "ruleText": "Env-A 1202.56 \"Electrostatic prep coating\" means a coating that is applied to a plastic part solely to provide conductivity for the subsequent application of a prime coating, a topcoat, or other coating by a spray that uses electrically charged particles, and which is clearly identified as an electrostatic prep coat on its accompanying material safety data sheet.\n\nSource. (See Revision Note at chapter heading for Env-A 1200) #9933, eff 6-1-11; ss by #12899, eff 10-17-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html"
}
