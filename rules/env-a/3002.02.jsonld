  "definition": "Actual emission rate",
  "effectiveDate": "1997-01-21",
  "historyNote": "#6441, EXEMPT, eff 1-21-97",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 3002.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html",
  "prefLabel": "Env-A 3002.02 Actual emission rate",
  "recordType": "rule-section",
  "ruleText": "Env-A 3002.02 \"Actual emission rate\" means either:\n\n(a) The tons per year of a pollutant actually emitted from an ERC emission source during calendar year 1990; or\n\n(b) The average tons per year of a pollutant actually emitted from an ERC emission source during any 2-year period which precedes the date of application for emissions reduction credits by no more than 5 years and which the division determines:\n\n(1) Is representative of normal production rates; and\n\n(2) Does not jeopardize any target annual RACT level of statewide aggregate emissions reductions or jeopardize any attainment demonstration under the Act.\n\nSource. #6441, EXEMPT, eff 1-21-97",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html"
}
