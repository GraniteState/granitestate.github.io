  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html",
  "prefLabel": "Env-A 4103.35 Heavy-duty hand cleaner or soap",
  "recordType": "rule-section",
  "ruleText": "Env-A 4103.35 “Heavy-duty hand cleaner or soap” means a product designed to clean or remove difficult dirt and soils such as oil, grease, grime, tar, shellac, putty, printer’s ink, paint, graphite, cement, carbon, asphalt, or adhesives from the hand with or without the use of water. The term does not include prescription drug products, antimicrobial hand or body cleaner or soap, astringent/toner, facial cleaner or soap, general-use hand or body cleaner or soap, medicated astringent/medicated toner, or rubbing alcohol.\n\nSource. #10527, eff 2-26-14; ss by #13969, eff 5-21-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html"
