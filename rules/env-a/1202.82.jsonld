  "effectiveDate": "2019-10-17",
  "historyNote": "(See Revision Note at chapter heading for Env-A 1200) #9933, eff 6-1-11; ss by #12899, eff 10-17-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 1202.82",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html",
  "prefLabel": "Env-A 1202.82 Freeboard height",
  "recordType": "rule-section",
  "ruleText": "Env-A 1202.82 \"Freeboard height\" means:\n\n(a) For a cold cleaner, the distance from the liquid solvent level in a degreaser tank to the lip of the tank;\n\n(b) For an open top vapor degreaser tank, the distance from the solvent vapor level in the tank during idling to the lip of the tank;\n\n(c) For a conveyorized cold degreaser, the distance from the liquid solvent level to the bottom of the entrance or exit opening, whichever is lower; or\n\n(d) For a conveyorized vapor degreaser, the distance from the vapor level to the bottom of the entrance or exit opening, whichever is lower.\n\nSource. (See Revision Note at chapter heading for Env-A 1200) #9933, eff 6-1-11; ss by #12899, eff 10-17-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html"
}
