  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4600.html",
  "prefLabel": "Env-A 4602.37 Cost containment reserve trigger price (CCR trigger price)",
  "priorExpiration": "2009-03-30",
  "recordType": "rule-section",
  "ruleText": "Env-A 4602.37 “Cost containment reserve trigger price (CCR trigger price)” means the minimum price at which CO2 CCR allowances are offered for sale by the department or the regional organization at an auction as specified in RSA 125-O:29, I, as follows:\n\n(a) $10.51 per CO2 allowance for calendar year 2019;\n\n(b) $10.77 per CO2 allowance for calendar year 2020;\n\n(c) $13.00 per CO2 allowance for calendar year 2021; and\n\n(d) 1.07 multiplied by the CCR trigger price from the previous calendar year, rounded to the nearest whole cent, for each calendar year thereafter.\n\nSource. #9283, INTERIM, eff 10-1-08, EXPIRED: 3-30-09\n\nNew. #9444, eff 4-3-09 (from Env-A 4602.38); ss by #10468, eff 1-1-14; ss by #12967, eff 1-1-20 (from Env-A 4602.38)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4600.html"
