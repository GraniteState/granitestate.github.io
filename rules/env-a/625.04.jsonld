  "definition": "Limitations on Potential to Emit",
  "effectiveDate": "2022-12-17",
  "historyNote": "#10175, eff 9-1-12; ss by #13510, eff 12-17-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
