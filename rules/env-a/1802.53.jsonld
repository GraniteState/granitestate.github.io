  "prefLabel": "Env-A 1802.53 Type A project",
  "recordType": "rule-section",
  "ruleText": "Env-A 1802.53 “Type A project” means major asbestos abatement involving 500 linear feet or more of RACM on pipes, 1,000 square feet or more of RACM on the surface of structures other than pipes, or 100 cubic feet or more of RACM on facility components where the length or area could not be measured.\n\nSource. #14467, eff 1-1-26, EXPIRES: 1-1-36",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1800.html"
}
