  "definition": "Valid Averaging Periods",
  "effectiveDate": "2019-05-01",
  "historyNote": "#7788, eff 10-31-02; ss by #9802, eff 10-31-10 (from Env-A 808.11); ss by #12762, eff 5-1-19 (from Env-A 808.17)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
