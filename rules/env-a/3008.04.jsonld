  "notation": "Env-A 3008.04",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html",
  "prefLabel": "Env-A 3008.04 Reconciliation",
  "recordType": "rule-section",
  "ruleText": "Env-A 3008.04 Reconciliation. The user of any ERCs shall obtain additional ERCs upon a determination by the department by the above inspection and monitoring procedures that actual emissions are higher than the projected emissions using the certified ERCs. The amount of additional ERCs required shall be specified by the department in a notice of violation and an order of abatement and shall be, at a minimum, equal to the difference between the actual and projected emissions.\n\nSource. #6441, EXEMPT, eff 1-21-97",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html"
}
