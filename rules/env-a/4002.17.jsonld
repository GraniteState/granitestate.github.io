  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4000.html",
  "prefLabel": "Env-A 4002.17 Spout",
  "recordType": "rule-section",
  "ruleText": "Env-A 4002.17 “Spout” means any device that is designed to be attached to a portable fuel container for conducting pouring through which the contents of a portable fuel container can be dispensed, not including a device that can be used to lengthen the spout to accommodate necessary applications.\n\nSource. #9064, eff 1-9-08",
