  "definition": "Visible Emission and Particulate Matter Standards for Non-Metallic Mineral Processing Plants",
  "effectiveDate": "2018-12-22",
  "historyNote": "#6428-B, eff 1-18-97 (formerly Env-A 1210); ss by #8218, eff 11-24-04; ss by #9793, eff 10-1-10; ss by #12693, eff 12-22-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
