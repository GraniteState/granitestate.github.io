  "broader": "https://granitestate.github.io/rules/env-a/4103",
  "definition": "Industrial maintenance coating",
  "effectiveDate": "2024-05-21",
  "historyNote": "#10527, eff 2-26-14; ss by #13969, eff 5-21-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 4103.43",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html",
  "prefLabel": "Env-A 4103.43 Industrial maintenance coating",
  "recordType": "rule-section",
  "ruleText": "Env-A 4103.43 “Industrial maintenance coating” means a high performance architectural coating, including primers, sealers, undercoaters, intermediate coats, and topcoats, formulated for application to substrates, including floors, labeled “For industrial use only,” “For professional use only,” “Not for residential use,” or “Not intended for residential use,” and designed to be exposed to one or more of the extreme environmental conditions listed below:\n\n(a) Immersion in water, wastewater, or aqueous or non-aqueous solutions chemical solutions, or chronic exposure of interior surfaces to moisture condensation;\n\n(b) Acute or chronic exposure to corrosive, caustic, or acidic agents, or to chemicals, chemical fumes, or chemical mixtures or solutions;\n\n(c) Frequent exposure to temperatures above 121 °C (250 °F);\n\n(d) Frequent heavy abrasion, including mechanical wear and frequent scrubbing with industrial solvents, cleansers, scouring agents; or\n\n(e) Exterior exposure of metal structures and structural components.\n\nSource. #10527, eff 2-26-14; ss by #13969, eff 5-21-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html"
}
