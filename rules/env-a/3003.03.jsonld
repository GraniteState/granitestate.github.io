  "prefLabel": "Env-A 3003.03 Applicable Pollutants",
  "recordType": "rule-section",
  "ruleText": "Env-A 3003.03 Applicable Pollutants. Only emissions reductions occurring after December 31, 1990 from the source types listed in Env-A 3001.01 for the following regulated pollutants shall be eligible for ERCs:\n\n(a) Volatile organic compounds (\"VOCs\");\n\n(b) Oxides of nitrogen (\"NOx\"); and\n\n(c) Carbon Monoxide (\"CO\").\n\nSource. #6441, EXEMPT, eff 1-21-97",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html"
}
