  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html",
  "prefLabel": "Env-A 1203.38 Minor core activity",
  "recordType": "rule-section",
  "ruleText": "Env-A 1203.38 “Minor core activity” means any core activity at a stationary source for which the VOC emissions from all processes and devices associated with the minor core activity are less than both of the following:\n\n(a) The relevant RACT applicability emissions threshold; and\n\n(b) A total of 5 actual tons per consecutive 12-month period.\n\nSource. (See Revision Note at chapter heading for Env-A 1200) #9933, eff 6-1-11; ss by #10145, eff 6-19-12; ss by #12899, eff 10-17-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html"
}
