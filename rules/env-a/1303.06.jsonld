  "definition": "RACT Requirements: Wet-Bottom Utility Boilers Firing Coal",
  "effectiveDate": "2018-08-15",
  "historyNote": "(See Revision Note at chapter heading for Env-A 1300) #9803, eff 10-31-10; ss by #12584, eff 8-15-18 (formerly Env-A 1303.05)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
