  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html",
  "prefLabel": "Env-A 4102.58 Energized electrical cleaner",
  "recordType": "rule-section",
  "ruleText": "Env-A 4102.58 “Energized electrical cleaner” means a product that meets both of the following:\n\n(a) The product is labeled to clean or degrease electrical equipment, where cleaning or degreasing is accomplished when electrical current exists, or when there is a residual electrical potential from a component of the equipment such as a capacitor; and\n\n(b) The product label clearly displays the statement “Energized Equipment Use Only - Not to be used for maintenance of motorized vehicles or their parts.”\n\nSource. #10527, eff 2-26-14; ss by #13969, eff 5-21-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html"
}
