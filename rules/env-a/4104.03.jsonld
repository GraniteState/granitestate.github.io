  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html",
  "prefLabel": "Env-A 4104.03 New Hampshire sales",
  "recordType": "rule-section",
  "ruleText": "Env-A 4104.03 “New Hampshire sales” means the sales per year in New Hampshire, in pounds of product, less packaging and container, for either the calendar year immediately prior to the year that the registration is due or, if that data is not available, any consecutive 12-month period commencing no earlier than 2 years prior to the due date of the registration.\n\nSource. #8439, eff 9-24-05; ss by #10527, eff 2-26-14; ss by #13969, eff 5-21-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html"
}
