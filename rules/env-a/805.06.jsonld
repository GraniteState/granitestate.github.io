  "broader": "https://granitestate.github.io/rules/env-a/805",
  "definition": "Alternate CE Procedures for Solvent Recovery Systems",
  "effectiveDate": "2019-05-01",
  "historyNote": "#7788, eff 10-31-02; ss by #9802, eff 10-31-10; ss by #12762, eff 5-1-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
