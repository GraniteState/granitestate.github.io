  "definition": "Calculation of VOC Content",
  "effectiveDate": "2025-02-26",
  "historyNote": "#8695, eff 7-27-06; ss by #10736, eff 1-1-15; ss by #14202, eff 2-26-25",
  "inScheme": "https://granitestate.github.io/rules/scheme",
