  "definition": "Particulate Emission Standards for Fuel Burning Devices Installed on or after January 1, 1985",
  "effectiveDate": "2023-11-18",
  "historyNote": "#10416, eff 9-24-13 (formerly Env-A 2002.08); ss by #13809, eff 11-18-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 2003.03",
