  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 3002.01",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html",
  "prefLabel": "Env-A 3002.01 Activity level",
  "recordType": "rule-section",
  "ruleText": "Env-A 3002.01 \"Activity level\" means \"activity level\" as defined in the US EPA's proposed Model Open Market Trading Rule (60 FR 39668, August 3, 1995), namely, \"the amount of activity at a source measured in terms of production, use, raw materials input, vehicle miles traveled, or other similar units that have a direct correlation with the economic output of the source and is not affected by changes in the emissions rate (i.e., mass per unit of activity).\"\n\nSource. #6441, EXEMPT, eff 1-21-97",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html"
}
