  "broader": "https://granitestate.github.io/rules/env-a/1404",
  "definition": "Compliance with Compliance Boundaries; Alternate Compliance Boundaries",
  "effectiveDate": "2022-02-03",
  "historyNote": "#12443, eff 1-5-18; ss by #13334, eff 2-3-22 (formerly Env-A 1405.07)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
