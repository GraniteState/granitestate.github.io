  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html",
  "prefLabel": "Env-A 4102.07 Air freshener",
  "recordType": "rule-section",
  "ruleText": "Env-A 4102.07 “Air freshener” means any product, including but not limited to sprays, wicks, wipes, diffusers, powders, and crystals, designed or labeled for the purpose of masking odors, or freshening, cleaning, scenting, or deodorizing the air. The term includes dual purpose air freshener/disinfectant products but does not include products that are used on the human body, products that function primarily as cleaning products as indicated on a product label, odor remover/eliminator products, or toilet/urinal care products.\n\nSource. #10527, eff 2-26-14; ss by #13969, eff 5-21-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html"
