  "definition": "Determination of Attainment of NO2 Standard",
  "effectiveDate": "2022-05-25",
  "historyNote": "#6227, eff 4-25-96; ss by #8054, eff 2-28-04; ss by #10173, eff 9-1-12; ss by #13382, eff 5-25-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
