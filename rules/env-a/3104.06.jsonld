  "definition": "Environmental Contribution",
  "effectiveDate": "1997-01-21",
  "historyNote": "#6441, EXEMPT, eff 1-21-97",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 3104.06",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3100.html",
  "prefLabel": "Env-A 3104.06 Environmental Contribution",
  "recordType": "rule-section",
  "ruleText": "Env-A 3104.06 Environmental Contribution. At the time of use, DER users shall permanently retire ten percent of all DERs dedicated to that particular use, such that the amount of DERs required to demonstrate compliance shall equal the source's calculated need divided by 0.9. This environmental contribution shall be taken before any noncompliance penalty adjustment factor is applied under Env-A 3104.02, such that the amount of DERs required to demonstrate compliance shall equal (the source's calculated need divided by 0.9) divided by the appropriate noncompliance penalty adjustment factor.\n\nSource. #6441, EXEMPT, eff 1-21-97",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3100.html"
}
