  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html",
  "prefLabel": "Env-A 3006.08 Holding of ERCs",
  "recordType": "rule-section",
  "ruleText": "Env-A 3006.08 Holding of ERCs. ERCs held for future use in any calendar year shall not be aggregated for any purpose with ERCs certified for use in any other calendar year. Banking is not allowed. For example, if a generator source installs controls that achieve a 10 ton/year reduction, but the credits are not used until 3 years from the certification date, the credit is still only 10 tons/year, and it is not 30 tons plus 10 tons/year.\n\nSource. #6441, EXEMPT, eff 1-21-97",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a3000.html"
}
