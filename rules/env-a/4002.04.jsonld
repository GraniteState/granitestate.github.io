  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4000.html",
  "prefLabel": "Env-A 4002.04 Distributor",
  "recordType": "rule-section",
  "ruleText": "Env-A 4002.04 “Distributor” means any person to whom a portable fuel container or spout, or both, is sold or supplied for the purpose of resale or distribution in commerce. This term does not include manufacturers, retailers, and consumers.\n\nSource. #9064, eff 1-9-08",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4000.html"
