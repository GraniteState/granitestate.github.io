  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1800.html",
  "prefLabel": "Env-A 1804.03 Determination of Damage or Deterioration",
  "recordType": "rule-section",
  "ruleText": "Env-A 1804.03 Determination of Damage or Deterioration. For purposes of RSA 141:8, friable ACM shall be deemed to be deteriorated or damaged if:\n\n(a) The material has pulled away from the underlying surface; or\n\n(b) Evidence of physical damage exists, such as gouges or cuts in the material or debris matching the material is on the surface below the material.\n\nSource. (See Revision Note #1, Revision Note #2, and Revision Note #3 at chapter heading for Env-A 1800) #14104, eff 11-1-24, EXPIRES: 11-1-34",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1800.html"
}
