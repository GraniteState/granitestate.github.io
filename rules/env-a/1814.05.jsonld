  "definition": "Criteria for Approval of Training Providers",
  "effectiveDate": "2024-11-01",
  "expirationDate": "2034-11-01",
  "historyNote": "(See Revision Note #1, Revision Note #2, and Revision Note #3 at chapter heading for Env-A 1800) #14104, eff 11-1-24, EXPIRES: 11-1-34",
  "inScheme": "https://granitestate.github.io/rules/scheme",
