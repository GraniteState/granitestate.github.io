  "altLabel": "Bulk Gasoline Loading Terminal",
  "broader": "https://granitestate.github.io/rules/env-a/1202",
  "definition": "Bulk gasoline loading terminal",
  "effectiveDate": "2019-10-17",
  "historyNote": "(See Revision Note at chapter heading for Env-A 1200) #9933, eff 6-1-11; ss by #12899, eff 10-17-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 1202.22",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html",
  "prefLabel": "Env-A 1202.22 Bulk gasoline loading terminal",
  "recordType": "rule-section",
  "ruleText": "Env-A 1202.22 \"Bulk gasoline loading terminal\" means a gasoline storage facility which:\n\n(a) Receives gasoline from refineries primarily by pipeline, ship, or barge;\n\n(b) Delivers gasoline to commercial or retail bulk gasoline plants within or outside New Hampshire, primarily by tank truck; and\n\n(c) Has a daily throughput of at least 76,000 liters, equivalent to 20,000 gallons, of gasoline in any consecutive 30-day period during the ozone season.\n\nSource. (See Revision Note at chapter heading for Env-A 1200) #9933, eff 6-1-11; ss by #12899, eff 10-17-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1200.html"
}
