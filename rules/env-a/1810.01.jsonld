  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1800.html",
  "prefLabel": "Env-A 1810.01 Applicability",
  "recordType": "rule-section",
  "ruleText": "Env-A 1810.01 Applicability.\n\n(a) The owner or operator of a facility who removes asbestos roofing materials, asbestos siding, and other preformed cementitious asbestos materials shall comply with this Part.\n\n(b) If the conditions specified in this Part are not met, then the owner or operator shall be subject to the requirements of Env-A 1808.\n\nSource. (See Revision Note #1, Revision Note #2, and Revision Note #3 at chapter heading for Env-A 1800) #14104, eff 11-1-24, EXPIRES: 11-1-34",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a1800.html"
}
