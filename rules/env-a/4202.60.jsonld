  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4200.html",
  "prefLabel": "Env-A 4202.60 Specialty primer, sealer, or undercoater",
  "recordType": "rule-section",
  "ruleText": "Env-A 4202.60 “Specialty primer, sealer, or undercoater” means a coating that is formulated and labeled for application to a substrate to seal fire, smoke, or water damage, to block stains, or to condition excessively chalky surfaces, meaning those surfaces that have a chalk rating of 4 or less as determined by its manufacturer or producer using ASTM test method D4214-98.\n\nSource. #8695, eff 7-27-06, ss by #10736, eff 1-1-15 (formerly Env-A 4202.01(bh)); ss by #14202, eff 2-26-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4200.html"
}
