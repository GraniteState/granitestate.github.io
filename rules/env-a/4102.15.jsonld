  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html",
  "prefLabel": "Env-A 4102.15 Artist’s solvent/thinner",
  "recordType": "rule-section",
  "ruleText": "Env-A 4102.15 “Artist’s solvent/thinner” means any liquid product that:\n\n(a) Has a label that meets the requirements of ASTM D4236 - 94, “Standard Practice for Labeling Art Materials for Chronic Health Hazards”;\n\n(b) Is packaged in a container equal to or less than 34 fl oz; and\n\n(c) Is designed to be used to reduce the viscosity of, or remove, art coating compositions or components.\n\nSource. #10527, eff 2-26-14; ss by #13969, eff 5-21-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html"
}
