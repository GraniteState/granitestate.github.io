  "definition": "Permit Application Required",
  "effectiveDate": "2022-12-17",
  "historyNote": "#8654, eff 6-8-06; amd by #9791, eff 10-1-10; ss by #10175, eff 9-1-12; ss by #13510, eff 12-17-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
