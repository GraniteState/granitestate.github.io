  "broader": "https://granitestate.github.io/rules/env-a/3513",
  "definition": "Recordkeeping and Reporting for Small, Medium, and Large HMIWI Units",
  "effectiveDate": "2007-01-05",
  "historyNote": "#6938, eff 1-30-99; amd by #7127, eff 10-30-99; ss by #8788, eff 1-5-07",
