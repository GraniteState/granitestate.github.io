  "broader": "https://granitestate.github.io/rules/env-a/4105",
  "definition": "Requirements for Floor Wax Strippers",
  "effectiveDate": "2024-05-21",
  "historyNote": "#10527, eff 2-26-14 (from Env-A 4103.05); ss by #13969, eff 5-21-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Env-A 4105.06",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html",
  "prefLabel": "Env-A 4105.06 Requirements for Floor Wax Strippers",
  "recordType": "rule-section",
  "ruleText": "Env-A 4105.06 Requirements for Floor Wax Strippers. No person shall sell, supply, offer for sale, or manufacture for use in New Hampshire any floor wax stripper unless the following requirements are met:\n\n(a) The label of each non-aerosol floor wax stripper shall specify a dilution ratio for light or medium build-up of polish that results in an as-used VOC concentration of 3% by weight or less;\n\n(b) If a non-aerosol floor wax stripper is also intended to be used for removal of heavy build-up of polish, the label of that floor wax stripper shall specify a dilution ratio for heavy build-up of polish that results in an as-used VOC concentration of 12% by weight or less; and\n\n(c) Terminology describing the amount of polish build-up the non-aerosol floor wax stripper is intended to remove, such as light, medium, or heavy, shall be displayed on the label.\n\nSource. #10527, eff 2-26-14 (from Env-A 4103.05); ss by #13969, eff 5-21-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-a4100.html"
}
