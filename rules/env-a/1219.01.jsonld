  "definition": "Applicability Criteria for Fiberglass Boat Manufacturing Materials",
  "effectiveDate": "2019-10-17",
  "historyNote": "(See Revision Note at chapter heading for Env-A 1200) #9933, eff 6-1-11; ss by #12899, eff 10-17-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
