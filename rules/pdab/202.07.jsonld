  "broader": "https://granitestate.github.io/rules/pdab/202",
  "definition": "Confidential Documents and Confidential Information in Adjudicative Proceedings",
  "effectiveDate": "2022-12-02",
  "historyNote": "#13500-A, eff 12-2-22",
  "inScheme": "https://granitestate.github.io/rules/scheme",
