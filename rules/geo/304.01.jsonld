  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/geo100-500.html",
  "prefLabel": "Geo 304.01 Reciprocity",
  "recordType": "rule-section",
  "ruleText": "Geo 304.01 Reciprocity. Candidates for licensure who are licensed or registered in another state, provided that the other state’s licensure or registration requirements are substantially equivalent to or more stringent than those of this state, shall apply to the board for licensure on a form provided by the board as specified in Geo 301.02 and pay the fee per Geo 305.02. Verification of licensure and examination shall be obtained by the candidate for licensure and submitted to the board directly from the verifying state for approval.\n\nSource. #7526, eff 7-1-01; ss by #9439, eff 3-25-09; ss by #12152, eff 3-24-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/geo100-500.html"
