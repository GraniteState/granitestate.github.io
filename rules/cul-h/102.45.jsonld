  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/cul-h100.html",
  "prefLabel": "Cul-H 102.45 State Historical Resources Council",
  "recordType": "rule-section",
  "ruleText": "Cul-H 102.45 “State Historical Resources Council” means a council created pursuant to RSA 227-C:13 with the power and duty to approve nominations to the National Register, review and recommend the approval of the state survey, review and approve the contents of the state historic preservation plan, review and recommend application by the division for federal and other funding, review and recommend the removal of properties from the National Register, act in an advisory capacity to the division, and administer all federal funds received for historic preservation.\n\nSource. #10217, eff 10-30-12, EXPIRED: 7-1-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/cul-h100.html"
}
