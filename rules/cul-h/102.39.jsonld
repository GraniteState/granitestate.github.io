  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/cul-h100.html",
  "prefLabel": "Cul-H 102.39 Site evaluation",
  "recordType": "rule-section",
  "ruleText": "Cul-H 102.39 “Site evaluation” means a field investigation at an archaeological site with sufficient testing, including subsurface excavations if appropriate, to give a preliminary definition of the size, data contents, and spatial arrangement of materials for the purpose of assessing a site’s integrity, research potential, significance, and potential eligibility for inclusion in the National Register.\n\nSource. #10217, eff 10-30-12, EXPIRED: 7-1-18",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/cul-h100.html"
}
