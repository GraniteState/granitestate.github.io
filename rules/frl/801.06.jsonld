  "broader": "https://granitestate.github.io/rules/frl/801",
  "definition": "License Renewal",
  "effectiveDate": "2021-08-13",
  "historyNote": "(See Revision Note at chapter heading for Frl 800) #10945, eff 10-9-15; ss by #13252, eff 8-13-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
