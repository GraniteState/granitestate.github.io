  "broader": "https://granitestate.github.io/rules/frl/701",
  "definition": "Preparation Room Requirements and Equipment",
  "effectiveDate": "2018-11-20",
  "historyNote": "#1689, eff 12-22-80; ss by #2344, eff 4-15-83; ss by #2986, eff 3-18-85; ss by #4357, eff 1-20-88, EXPIRED: 1-20-94 New. #9716, eff 5-17-10; ss by #12673, eff 11-20-18",
