  "broader": "https://granitestate.github.io/rules/ch/305",
  "definition": "Disqualification Based on Character",
  "effectiveDate": "2017-12-08",
  "historyNote": "#8187, eff 10-8-04; ss by #10436, eff 10-5-13; ss by #12431, eff 12-8-17",
