  "definition": "Denial of Application for Licensure Renewal",
  "effectiveDate": "2017-12-08",
  "historyNote": "#8739, eff 10-11-06, EXPIRED: 10-11-14 New. #12107, INTERIM, eff 2-21-17, EXPIRED: 8-20-17 New. #12431, eff 12-8-17",
