  "definition": "Required Attachments to the Application Form",
  "effectiveDate": "2017-12-08",
  "historyNote": "#8187, eff 10-8-04; ss by #10433, eff 10-5-13; ss by #12431, eff 12-8-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
