  "broader": "https://granitestate.github.io/rules/mtec/303",
  "definition": "Ongoing Duty of Medical Technician",
  "effectiveDate": "2016-05-05",
  "historyNote": "#11091-B, eff 5-5-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
