  "broader": "https://granitestate.github.io/rules/mtec/401",
  "definition": "Denial of Renewal",
  "effectiveDate": "2016-05-05",
  "historyNote": "#11091-B, eff 5-5-16",
  "inScheme": "https://granitestate.github.io/rules/scheme",
