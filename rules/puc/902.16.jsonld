  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html",
  "prefLabel": "Puc 902.16 Group",
  "priorExpiration": "2014-07-02",
  "recordType": "rule-section",
  "ruleText": "Puc 902.16 “Group” means one or more members who are customers of the same distribution utility who have signed an agreement with a host as required by RSA 362-A:9, XIV. A group can include a host and a member that are the same entity or person.\n\nSource. #10502, INTERIM, eff 1-3-14, EXPIRED: 7-2-14 (from Puc 902.12)\n\nNew. #10757, eff 1-8-15 (from Puc 902.15); ss by #13080, eff 9-14-20 (formerly Puc 902.11)",
