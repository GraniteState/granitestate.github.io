  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html",
  "prefLabel": "Puc 902.18 Host",
  "priorExpiration": "2014-07-02",
  "recordType": "rule-section",
  "ruleText": "Puc 902.18 “Host” means a customer-generator that elects to assume the duties and obligations of RSA 362-A:9, XIV, who is, and who remains during the term of the agreement, a customer of the same distribution utility as the group.\n\nSource. #10502, INTERIM, eff 1-3-14, EXPIRED: 7-2-14 (from Puc 902.14)\n\nNew. #10757, eff 1-8-15 (from Puc 902.17); ss by #13080, eff 9-14-20 (formerly Puc 902.13)",
