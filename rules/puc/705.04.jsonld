  "definition": "F-4 Authority to Issue Securities",
  "effectiveDate": "2026-01-02",
  "expirationDate": "2036-01-02",
  "historyNote": "#13889, eff 4-22-24; ss by #14461, eff 1-2-26, EXPIRES 1-2-36",
