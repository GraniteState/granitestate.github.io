  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html",
  "prefLabel": "Puc 902.22 Member",
  "priorExpiration": "2014-07-02",
  "recordType": "rule-section",
  "ruleText": "Puc 902.22 “Member” means a customer of the same distribution utility as the host, who signs an agreement to be a member of a group under RSA 362-A:9, XIV, who remains a customer of the same distribution utility as the host during its membership in the group, and, except as provided in Puc 902.16, who is not a customer-generator.\n\nSource. #10502, INTERIM, eff 1-3-14, EXPIRED: 7-2-14 (from Puc 902.12)\n\nNew. #10757, eff 1-8-15 (from Puc 902.15); ss by, eff 9-14-20 (formerly Puc 902.16)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html"
