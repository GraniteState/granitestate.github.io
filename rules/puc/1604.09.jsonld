  "definition": "Adjustments to Test Year",
  "effectiveDate": "2024-07-25",
  "historyNote": "#6573, eff 9-10-97; ss #8428, eff 9-10-05; ss by #10535, eff 3-4-14; ss by #14030, eff 7-25-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
