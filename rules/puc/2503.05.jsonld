  "definition": "Certificate Banking",
  "effectiveDate": "2018-02-01",
  "historyNote": "#10741, eff 12-5-14 (from Puc 2503.04); ss by #12473, eff 2-1-18",
  "inScheme": "https://granitestate.github.io/rules/scheme",
