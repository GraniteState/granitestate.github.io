  "notation": "Puc 3002.02",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc3000.html",
  "prefLabel": "Puc 3002.02 Aggregator",
  "recordType": "rule-section",
  "ruleText": "Puc 3002.02 “Aggregator” means any person or entity that aggregates natural gas load but takes no ownership of the natural gas supplies needed to meet that aggregated load. The term includes, but is not limited to, any person or entity that facilitates or otherwise arranges for the purchase or sale of natural gas between customers and approved competitive natural gas suppliers. The term does not include any employee aggregating load on behalf of her or his employer.\n\nSource. #7811, eff 12-28-02; ss by #9796-A, eff 9-25-10; ss by #12757, eff 6-1-19 (from Puc 3002.02); ss by #14613, eff 6-5-26, EXPIRES: 6-5-36 (formerly Puc 3002.03)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc3000.html"
