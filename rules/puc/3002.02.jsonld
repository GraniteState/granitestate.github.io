  "definition": "Aggregator",
  "effectiveDate": "2026-06-05",
  "expirationDate": "2036-06-05",
  "historyNote": "#7811, eff 12-28-02; ss by #9796-A, eff 9-25-10; ss by #12757, eff 6-1-19 (from Puc 3002.02); ss by #14613, eff 6-5-26, EXPIRES: 6-5-36 (formerly Puc 3002.03)",
