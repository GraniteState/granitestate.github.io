  "definition": "Utility",
  "effectiveDate": "2024-02-22",
  "historyNote": "(See Revision Note # 1 and Revision Note #2 at chapter heading for Puc 600) #13887, eff 2-22-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Puc 602.09",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc600.html",
  "prefLabel": "Puc 602.09 Utility",
  "recordType": "rule-section",
  "ruleText": "Puc 602.09 \"Utility\" means any \"public utility\" as defined in RSA 362:2 and RSA 362:4 owning, operating or managing any plant or equipment or any part of the same for supplying of water to the public, or engaged in the transmission or sale of water ultimately sold to the public within New Hampshire except:\n\n(a) Municipal corporations operating within their corporate limits;\n\n(b) Municipal corporations which are exempt pursuant to RSA 362:4, to the extent of any such exemption;\n\n(c) Any landlord supplying water to tenants which service is included in a rental fee; or\n\n(d) Any association of residents supplying water to themselves.\n\nSource. (See Revision Note # 1 and Revision Note #2 at chapter heading for Puc 600) #13887, eff 2-22-24",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc600.html"
}
