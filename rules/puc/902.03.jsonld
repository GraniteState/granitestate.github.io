  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html",
  "prefLabel": "Puc 902.03 Alternative Net Metering Tariff",
  "recordType": "rule-section",
  "ruleText": "Puc 902.03 “Alternative Net Metering Tariff” means the alternative net energy metering tariff provisions adopted by the commission pursuant to RSA 362-A:9, XVI in Order No. 26,029 issued in Docket DE 16-576 on June 23, 2017, which tariff provisions are applicable to customer-generators receiving a utility net metering capacity allocation on or after September 1, 2017 once the utility is capable of implementing such new tariff provisions.\n\nSource. #13080, eff 9-14-20",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html"
