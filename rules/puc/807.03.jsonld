  "definition": "Responses to Notice of Probable Violation",
  "effectiveDate": "2017-02-08",
  "historyNote": "#7900, eff 5-29-03; ss by #9318, eff 11-8-08; ss by #12102, eff 2-8-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
