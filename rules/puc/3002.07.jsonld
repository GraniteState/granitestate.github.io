  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc3000.html",
  "prefLabel": "Puc 3002.07 Principals",
  "recordType": "rule-section",
  "ruleText": "Puc 3002.07 “Principals” means, for a corporation, any of its officers, directors, or controlling shareholders, for a limited liability company, any of its managers or controlling members, for a partnership, any of its general partners, and for any other business entity, any of its personnel exercising executive functions and any of its controlling equity owners.\n\nSource. #12757, eff 6-1-19; ss by #14613, eff 6-5-26, EXPIRES: 6-5-36 (formerly Puc 3002.16)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc3000.html"
