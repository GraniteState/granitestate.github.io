  "definition": "Principals",
  "effectiveDate": "2026-06-05",
  "expirationDate": "2036-06-05",
  "historyNote": "#12757, eff 6-1-19; ss by #14613, eff 6-5-26, EXPIRES: 6-5-36 (formerly Puc 3002.16)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
