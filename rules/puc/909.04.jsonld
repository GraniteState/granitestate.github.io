  "definition": "Transfer of Registration Numbers",
  "effectiveDate": "2020-09-14",
  "historyNote": "#10502, INTERIM, eff 1-3-14, EXPIRED: 7-2-14 New. #10757, eff 1-8-15; ss by #13080, eff 9-14-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
