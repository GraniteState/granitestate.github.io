  "broader": "https://granitestate.github.io/rules/puc/1604",
  "definition": "Contents of Filing Requirement",
  "effectiveDate": "2024-07-25",
  "historyNote": "#6573, eff 9-10-97; ss #8428, eff 9-10-05; ss by #10535, eff 3-4-14; amd by #10837, eff 5-23-15; ss by #14030, eff 7-25-24",
