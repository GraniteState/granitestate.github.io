  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html",
  "prefLabel": "Puc 902.11 Eligible Fuel",
  "priorExpiration": "2014-07-02",
  "recordType": "rule-section",
  "ruleText": "Puc 902.11 “Eligible Fuel” means “eligible fuel” as defined in RSA 362-A:1-a, II-c, namely, “natural gas, propane, wood pellets, hydrogen, or heating oil when combusted with a burner, including air emission standards for the device using the approved fuel.”\n\nSource. #9998, eff 9-20-11; ss by #10502, INTERIM, eff 1-3-14, EXPIRED: 7-2-14 (from Puc 902.09)\n\nNew. #10757, eff 1-8-15 (from Puc 902.10); ss by #13080, eff 9-14-20 (formerly Puc 902.08)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html"
