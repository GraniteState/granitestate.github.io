  "broader": "https://granitestate.github.io/rules/puc/805",
  "definition": "Damage to an Underground Facility",
  "effectiveDate": "2017-02-08",
  "historyNote": "#9318, eff 11-8-08; ss by #12102, eff 2-8-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
