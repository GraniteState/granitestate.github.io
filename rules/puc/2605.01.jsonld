  "definition": "Allowance Sales in Excess of Threshold Prices",
  "effectiveDate": "2009-12-12",
  "expirationDate": "2017-12-12",
  "historyNote": "#9352, INTERIM, eff 1-1-09; ss by #9615, eff 12-12-09, EXPIRED: 12-12-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
