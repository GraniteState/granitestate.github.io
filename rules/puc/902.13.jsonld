  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html",
  "prefLabel": "Puc 902.13 Facility",
  "priorExpiration": "2014-07-02",
  "recordType": "rule-section",
  "ruleText": "Puc 902.13 “Facility” means the electricity generating equipment, powered by renewable energy or that employs a heat led combined heat and power system, interconnected with the electric distribution system through any one retail meter or more than one retail meter, installed or to be installed in accordance with Puc 903.03.\n\nSource. #9998, eff 9-20-11 (from Puc 902.08); ss by #10502, INTERIM, eff 1-3-14, EXPIRED: 7-2-14 (from Puc 902.10)\n\nNew. #10757, eff 1-8-15 (from Puc 902.12); ss by #13080, eff 9-14-20 (formerly Puc 902.09)",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/puc900.html"
