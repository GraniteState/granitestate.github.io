  "broader": "https://granitestate.github.io/rules/lsa/501",
  "definition": "Conflicts of Interest",
  "effectiveDate": "2025-03-10",
  "historyNote": "#14169, eff 3-10-25",
  "inScheme": "https://granitestate.github.io/rules/scheme",
  "notation": "Lsa 501.04",
  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/lsa100-500.html",
  "prefLabel": "Lsa 501.04 Conflicts of Interest",
  "recordType": "rule-section",
  "ruleText": "Lsa 501.04 Conflicts of Interest.\n\n(a) Licensees shall clearly identify themselves, their employer, and the interests they represent.\n\n(b) Licensees shall clearly define the scope of their responsibility in connection with work for which the licensee is claiming responsibility.\n\n(c) Licensees shall promptly and fully disclose to the client or employer all conflicts of interest, and the licensee shall act immediately to resolve the conflict.\n\n(d) Licensees shall disclose fully to their clients any financial or purchase interest the licensee has in the land on which they are working.\n\nSource. #14169, eff 3-10-25",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/lsa100-500.html"
