  "broader": "https://granitestate.github.io/rules/lsa/403",
  "definition": "Continuing Education Hour Credits",
  "effectiveDate": "2024-03-10",
  "historyNote": "#8861, eff 3-28-07; ss by #10679, eff 9-30-14; ss by #13850, eff 3-10-24",
