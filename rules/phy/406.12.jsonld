  "definition": "Teaching Physical Therapy",
  "effectiveDate": "2024-02-17",
  "historyNote": "#9456, eff 4-17-09; ss by #12088, eff 1-20-17; ss by #13825, eff 2-17-24 (formerly Phy 406.13)",
