  "definition": "Sexual misconduct",
  "effectiveDate": "2017-01-20",
  "historyNote": "#9456, eff 4-17-09; renumbered by #10061 (from Phy 401.15); ss by #12088, eff 1-20-17; renumbered by #13825 (formerly Phy 401.18)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
