  "definition": "Renewal of Licenses and Renewal of Licenses on Condition",
  "effectiveDate": "2020-11-26",
  "historyNote": "#8679, eff 7-11-06, EXPIRED: 7-11-14 New. #12176, eff 5-17-17; ss by #13140, eff 11-26-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
