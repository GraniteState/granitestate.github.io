  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/nat100-700.html",
  "prefLabel": "Nat 404.04 Revocation of License",
  "priorExpiration": "2015-03-27",
  "recordType": "rule-section",
  "ruleText": "Nat 404.04 Revocation of License.\n\n(a) Pursuant to RSA 328-E:14, I, the board shall revoke a license when the licensee has been convicted of a misdemeanor for any statutory violations described in Nat 404.01(c).\n\n(b) The board shall revoke a license when the revocation is agreed upon by the board and the licensee in a settlement made pursuant to Nat 213.\n\nSource. #8857, eff 3-27-07, EXPIRED: 3-27-15\n\nNew. #12176, eff 5-17-17",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/nat100-700.html"
}
