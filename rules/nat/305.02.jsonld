  "definition": "Eligibility for Specialty Certification in Acupuncture",
  "effectiveDate": "2017-05-17",
  "historyNote": "#6380, eff 11-26-96, EXPIRED: 11-26-04 New. #8374, eff 6-18-05, EXPIRED: 6-18-13 New. #12176, eff 5-17-17",
  "inScheme": "https://granitestate.github.io/rules/scheme",
