  "broader": "https://granitestate.github.io/rules/pda/603",
  "definition": "Parking in Parking Areas Located on Associated Facilities",
  "effectiveDate": "2023-11-17",
  "historyNote": "#8321, eff 10-1-05; ss by #9048, eff 1-1-08; ss by #10441, eff 11-1-13; ss by #13806, eff 11-17-23",
