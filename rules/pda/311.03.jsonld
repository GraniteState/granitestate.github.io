  "broader": "https://granitestate.github.io/rules/pda/311",
  "definition": "Pilotage Fees Based on Pilotage Unit Rates; Flat Fees",
  "effectiveDate": "2014-06-29",
  "historyNote": "#7870, eff 4-12-03; ss by #8148, EXEMPT, eff 8-27-04; ss by #9928, EXEMPT, eff 5-29-11; ss by #10642, EXEMPT, eff 6-29-14",
