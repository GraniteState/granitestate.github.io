  "definition": "Reasons for Denial of Application",
  "effectiveDate": "2025-09-20",
  "expirationDate": "2035-09-20",
  "historyNote": "#8845, eff 3-21-07; ss by #10949, eff 10-20-15; ss by #14376, eff 9-20-25, EXPIRES: 9-20-35",
