  "broader": "https://granitestate.github.io/rules/pda/506",
  "definition": "Commercial Use Mooring Permit; Application Requirements; Processing",
  "effectiveDate": "2019-12-24",
  "historyNote": "#7940, eff 8-23-03; amd by #8775, eff 12-16-06; ss by #9975, eff 8-20-11 (See Revision Note at chapter heading for Pda 500); ss by #12958, eff 12-24-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
