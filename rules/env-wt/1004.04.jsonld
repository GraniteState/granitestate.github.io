  "definition": "Display of Registration Numbers on Docking Structures",
  "effectiveDate": "2021-12-21",
  "historyNote": "#13210, INTERIM, eff 6-15-21; ss by #13314, eff 12-21-21",
  "inScheme": "https://granitestate.github.io/rules/scheme",
