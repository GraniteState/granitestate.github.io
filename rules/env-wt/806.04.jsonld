  "definition": "Plans for Stream Restoration and Enhancement Projects",
  "effectiveDate": "2019-12-15",
  "historyNote": "#11000, eff 2-1-16; ss by #12808, eff 12-15-19 (See Revision Notes #1 and #2 at chapter heading for Env-Wt 800)",
