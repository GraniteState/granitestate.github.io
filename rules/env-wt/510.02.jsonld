  "broader": "https://granitestate.github.io/rules/env-wt/510",
  "definition": "Approval Criteria for EAW Control Projects",
  "effectiveDate": "2020-10-23",
  "historyNote": "#12805, eff 12-15-19; amd by #13124, eff 10-23-20",
