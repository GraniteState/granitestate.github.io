  "effectiveDate": "2023-10-13",
  "historyNote": "#12803, eff 12-15-19; amd by #12954, eff 12-24-19 (formerly Env-Wt 309.05); ss by #13124, eff 10-23-20; ss by #13777, eff 10-13-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
