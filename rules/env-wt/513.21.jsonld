  "definition": "Design and Construction Requirements for Watercraft Lifts",
  "effectiveDate": "2020-10-23",
  "historyNote": "#12805, eff 12-15-19; ss by #13124, eff 10-23-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
