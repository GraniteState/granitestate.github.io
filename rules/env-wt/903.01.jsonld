  "broader": "https://granitestate.github.io/rules/env-wt/902",
  "definition": "Classification of Stream Crossings and Stream Crossing Projects",
  "effectiveDate": "2019-12-24",
  "historyNote": "#12809, eff 12-15-19; amd by #12954, eff 12-24-19",
