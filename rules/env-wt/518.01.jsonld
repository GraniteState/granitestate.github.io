  "officialHtml": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wt500.html",
  "prefLabel": "Env-Wt 518.01 Applicability",
  "recordType": "rule-section",
  "ruleText": "Env-Wt 518.01 Applicability.\n\n(a) This part shall apply to construction of water-related non-docking structures including dikes, dry hydrants, and boat launches.\n\n(b) This part shall not apply to:\n\n(1) Any structure covered by Env-Wt 900 relative to stream crossings; or\n\n(2) Any structure specifically covered by another part in Env-Wt 500.\n\nSource. #12805, eff 12-15-19",
  "source": "https://github.com/GraniteState/adm-rules-data/blob/1c92d82e0f03a582ca5b7a578588edf38de2318e/raw/2026-11-15/state_agencies/env-wt500.html"
}
