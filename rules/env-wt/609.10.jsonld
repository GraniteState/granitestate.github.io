  "broader": "https://granitestate.github.io/rules/env-wt/609",
  "definition": "Minimum Impact Tidal Shoreline Stabilization Projects",
  "effectiveDate": "2026-01-02",
  "expirationDate": "2036-01-02",
  "historyNote": "#12806, eff 12-15-19; ss by #14349, INTERIM, eff 8-26-25; ss by #14471, eff 1-2-26, EXPIRES: 1-2-36",
