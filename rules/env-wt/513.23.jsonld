  "definition": "Modification of Existing Docking Structures",
  "effectiveDate": "2023-10-13",
  "historyNote": "#12805, eff 12-15-19; ss by #13124, eff 10-23-20; ss by #13776, eff 10-13-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
