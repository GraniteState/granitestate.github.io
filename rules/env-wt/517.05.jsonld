  "definition": "Design and Construction Requirements for Boardwalks",
  "effectiveDate": "2023-10-13",
  "historyNote": "#12805, eff 12-15-19; amd by #13124, eff 10-23-20; ss by #13776, eff 10-13-23",
  "inScheme": "https://granitestate.github.io/rules/scheme",
