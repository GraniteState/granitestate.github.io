  "definition": "Tidal Shoreline Stabilization Projects Requiring Standard Permit",
  "effectiveDate": "2019-12-15",
  "historyNote": "#12806, eff 12-15-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
