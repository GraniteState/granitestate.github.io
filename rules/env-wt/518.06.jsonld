  "broader": "https://granitestate.github.io/rules/env-wt/518",
  "definition": "Design Requirements for Boat Launches",
  "effectiveDate": "2019-12-15",
  "historyNote": "#12805, eff 12-15-19",
  "inScheme": "https://granitestate.github.io/rules/scheme",
