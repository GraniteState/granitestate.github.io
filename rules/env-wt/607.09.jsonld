  "broader": "https://granitestate.github.io/rules/env-wt/607",
  "definition": "Sediment Transport and Disposal",
  "effectiveDate": "2023-10-13",
  "historyNote": "#12806, eff 12-15-19; ss by #13775, eff 10-13-23",
