  "definition": "Water Access Structure Design Requirements",
  "effectiveDate": "2020-10-23",
  "historyNote": "#12805, eff 12-15-19; amd by #12954, eff 12-24-19; amd by #13124, eff 10-23-20",
  "inScheme": "https://granitestate.github.io/rules/scheme",
