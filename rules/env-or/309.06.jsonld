  "definition": "Cargo Truck Use by Industrial Enterprises or the Military",
  "effectiveDate": "2024-10-04",
  "historyNote": "(See Revision Note at chapter heading for Env-Or 300) #10487, eff 2-7-14; ss by #14094, eff 10-4-24",
  "inScheme": "https://granitestate.github.io/rules/scheme",
