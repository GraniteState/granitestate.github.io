  "definition": "Signature Required for Waiver Request",
  "effectiveDate": "2025-11-04",
  "expirationDate": "2035-11-04",
  "historyNote": "#8812, eff 2-1-07; ss by #10832, eff 6-1-15 (from Env-Or 705.03); ss by #14420, eff 11-4-25, EXPIRES: 11-4-35",
