  "definition": "Fines Relating to Violations With No Scheduled Fine",
  "effectiveDate": "2025-11-04",
  "expirationDate": "2035-11-04",
  "historyNote": "#14419, eff 11-4-25, EXPIRES: 11-4-35",
  "inScheme": "https://granitestate.github.io/rules/scheme",
