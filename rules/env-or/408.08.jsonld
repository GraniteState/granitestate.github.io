  "broader": "https://granitestate.github.io/rules/env-or/408",
  "definition": "Permanent Closure: Site Assessment",
  "effectiveDate": "2018-10-10",
  "historyNote": "(See Revision Note #1 at chapter heading for Env-Or 400) #10393, eff 9-1-18; ss by #12643, eff 10-10-18 (See Revision Note #2 at chapter heading for Env-Or 400)",
  "inScheme": "https://granitestate.github.io/rules/scheme",
