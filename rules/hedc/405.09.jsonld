  "definition": "Integrity, Transparency, and Public Disclosure",
  "effectiveDate": "2023-11-02",
  "historyNote": "#10429, eff 10-5-13 (See Revision Note at chapter heading for Hedc 400); ss by #13802, eff 11-2-23",
